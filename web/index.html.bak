<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>靓仔文案工作台</title>
<style>
:root {
  --primary:#07c160;
  --primary-dark:#06ad56;
  --primary-bg:#e6f9ee;
  /* 语义色（暗黑模式在此覆盖） */
  --c-bg:#f0f2f5;        /* 页面背景 */
  --c-card:#fff;         /* 卡片/顶栏/面板背景 */
  --c-bg-soft:#f5f6f8;   /* 次级背景/悬停 */
  --c-border:var(--c-border);    /* 边框/分隔线 */
  --c-text:#222;         /* 主文字 */
  --c-text-sub:#666;     /* 次级文字 */
  --c-text-mute:#999;    /* 弱化文字 */
  --c-input:#fff;        /* 输入框背景 */
  --c-hover:#f0f2f5;     /* 行悬停背景 */
}
html[data-theme="dark"] {
  --c-bg:#121417;
  --c-card:#1c1f24;
  --c-bg-soft:#262a31;
  --c-border:#333842;
  --c-text:#e6e8eb;
  --c-text-sub:#aab0b8;
  --c-text-mute:#7c828c;
  --c-input:#22262c;
  --c-hover:#2a2f37;
  --primary:#10c96e;
  --primary-dark:#0db360;
  --primary-bg:#0f2b1d;
}
/* 暗黑模式：语义浅底色降饱和 */
html[data-theme="dark"] .top-status.busy,
html[data-theme="dark"] .badge.busy,
html[data-theme="dark"] .df-del,
html[data-theme="dark"] .df-tag.del,
html[data-theme="dark"] .wr-ev-tag.rep,
html[data-theme="dark"] .works-toolbar .batch-btn.danger:hover,
html[data-theme="dark"] .drawer .dbtns .danger:hover,
html[data-theme="dark"] .rw-item .rw-ops button.del:hover { background:#3a1f24; color:#ff7a8a; border-color:#5a2a33; }
html[data-theme="dark"] .tl-ico.adopt,
html[data-theme="dark"] .ctxbar,
html[data-theme="dark"] .st-to_adopt,
html[data-theme="dark"] .drawer .adopt-item,
html[data-theme="dark"] .ver-item .ver-hd .v-tag.adopt,
html[data-theme="dark"] .final.learn,
html[data-theme="dark"] .learn-item,
html[data-theme="dark"] .lb-hint,
html[data-theme="dark"] .card-script { background:#332b18; border-color:#5a4a22; color:#d4b46a; }
html[data-theme="dark"] .learn-hero { background:linear-gradient(135deg,#2a2417,#2b2816); border-color:#5a4a22; }
html[data-theme="dark"] .ver-item .ver-hd .v-tag.adopt,
html[data-theme="dark"] .st-to_adopt { color:#e0b96a; }
html[data-theme="dark"] .sec-title::after,
html[data-theme="dark"] .mon-progress { background:var(--c-bg-soft); }
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif; background:var(--c-bg); color:var(--c-text); font-size:14px; }
.hidden { display:none !important; }
button { font-family:inherit; cursor:pointer; }
input,textarea { font-family:inherit; outline:none; }

/* ---------- 顶栏 ---------- */
.topbar { height:54px; background:var(--c-card); border-bottom:1px solid var(--c-border); display:flex; align-items:center; gap:16px; padding:0 18px; position:sticky; top:0; z-index:50; }
.brand { display:flex; align-items:center; gap:8px; font-size:17px; font-weight:700; color:var(--c-text); }
.brand .logo { width:28px; height:28px; border-radius:8px; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:15px; }
.brand .sub { font-size:11px; font-weight:400; color:var(--c-text-mute); margin-top:2px; }
.top-status { margin-left:auto; display:flex; align-items:center; gap:6px; font-size:12px; color:var(--primary); background:var(--primary-bg); border-radius:999px; padding:4px 12px; }
.top-status.busy { color:#e8576a; background:#fdecee; }
.top-status .dot { width:7px; height:7px; border-radius:50%; background:currentColor; }
.btn-primary { background:var(--primary); color:#fff; border:none; border-radius:8px; padding:8px 16px; font-size:13px; font-weight:600; }
.btn-primary:hover { background:var(--primary-dark); }
.btn-primary:disabled { background:#b8b8b8; cursor:not-allowed; }
.btn-ghost { background:var(--c-card); color:var(--c-text); border:1px solid var(--c-border); border-radius:8px; padding:7px 14px; font-size:13px; }
.btn-ghost:hover { background:var(--c-bg-soft); }

/* ---------- 顶栏搜索 ---------- */
.top-search { position:relative; margin-left:auto; }
.top-search input { width:210px; border:1px solid var(--c-border); background:var(--c-bg-soft); border-radius:999px; padding:7px 14px; font-size:13px; outline:none; transition:width .2s, background .2s; }
.top-search input:focus { width:260px; background:var(--c-input); border-color:var(--primary); }
.search-panel { position:absolute; top:calc(100% + 8px); right:0; width:340px; max-height:420px; overflow-y:auto; background:var(--c-card); border:1px solid var(--c-border); border-radius:12px; box-shadow:0 10px 32px rgba(0,0,0,.14); z-index:120; padding:8px; }
.search-panel .sp-hint { font-size:11px; color:var(--c-text-mute); padding:8px 10px; }
.search-panel .sp-item { display:flex; align-items:center; gap:8px; padding:9px 10px; border-radius:8px; cursor:pointer; }
.search-panel .sp-item:hover { background:var(--c-bg-soft); }
.search-panel .sp-item .sp-type { flex:none; font-size:10px; padding:2px 8px; border-radius:999px; background:var(--c-bg-soft); color:var(--c-text-sub); }
.search-panel .sp-item .sp-title { flex:1; min-width:0; font-size:13px; color:var(--c-text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.search-panel .sp-item .sp-meta { flex:none; font-size:11px; color:var(--c-text-mute); }

/* ---------- 顶栏通知铃铛 ---------- */
.bell-wrap { position:relative; }
.bell-btn { position:relative; width:36px; height:36px; border:none; background:var(--c-bg-soft); border-radius:50%; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
.bell-btn:hover { background:var(--c-hover); }
.theme-btn { width:36px; height:36px; border:1px solid var(--c-border); background:var(--c-card); border-radius:50%; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--c-text-sub); }
.theme-btn:hover { background:var(--c-hover); color:var(--c-text); }
.bell-dot { position:absolute; top:4px; right:4px; width:9px; height:9px; border-radius:50%; background:#e8576a; border:2px solid #fff; }
.bell-panel { position:absolute; top:calc(100% + 8px); right:0; width:330px; max-height:440px; overflow-y:auto; background:var(--c-card); border:1px solid var(--c-border); border-radius:12px; box-shadow:0 10px 32px rgba(0,0,0,.14); z-index:120; padding:8px; }
.bell-panel .bp-hd { display:flex; align-items:center; gap:8px; padding:8px 10px 10px; border-bottom:1px solid #f0f0f0; font-size:13px; font-weight:600; }
.bell-panel .bp-hd .spacer { flex:1; }
.bell-panel .bp-hd button { border:none; background:transparent; color:var(--primary); font-size:12px; cursor:pointer; }
.bell-panel .bp-hd button:hover { text-decoration:underline; }
.bell-panel .bp-item { display:flex; gap:10px; padding:10px; border-bottom:1px dashed #f5f5f5; cursor:pointer; align-items:flex-start; }
.bell-panel .bp-item:last-child { border-bottom:none; }
.bell-panel .bp-item:hover { background:var(--c-bg-soft); }
.bell-panel .bp-item .bp-ico { flex:none; width:26px; height:26px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:13px; background:var(--c-bg-soft); }
.bell-panel .bp-item.unread .bp-ico { background:var(--primary-bg); }
.bell-panel .bp-item.unread .bp-title { color:var(--primary); }
.bell-panel .bp-item .bp-main { flex:1; min-width:0; }
.bell-panel .bp-item .bp-title { font-size:13px; color:var(--c-text); font-weight:500; }
.bell-panel .bp-item .bp-body { font-size:12px; color:var(--c-text-mute); margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bell-panel .bp-item .bp-time { font-size:10px; color:var(--c-text-mute); margin-top:3px; }
.bell-panel .bp-empty { text-align:center; color:var(--c-text-mute); font-size:12px; padding:26px 0; }

/* ---------- 布局 ---------- */
.body { display:flex; height:calc(100vh - 54px); }
.nav { width:178px; flex:none; background:var(--c-card); border-right:1px solid var(--c-border); padding:10px 8px 16px; display:flex; flex-direction:column; gap:2px; overflow-y:auto; }

/* ---------- 导航分组 ---------- */
.nav-group { font-size:10.5px; color:#b0b3b8; font-weight:600; letter-spacing:.06em; padding:10px 14px 2px; }
.nav-group:first-child { padding-top:2px; }
.nav-item { display:flex; align-items:center; gap:10px; border:none; background:transparent; border-radius:10px; padding:11px 14px; font-size:14px; color:var(--c-text-sub); text-align:left; }
.nav-item:hover { background:var(--c-bg-soft); }
.nav-item.active { background:var(--primary-bg); color:var(--primary); font-weight:600; }
.main { flex:1; overflow-y:auto; padding:18px 22px 40px; }
.view { max-width:1080px; margin:0 auto; }

/* ---------- 通用卡片 ---------- */
.card { background:var(--c-card); border-radius:12px; padding:18px; box-shadow:0 1px 3px rgba(0,0,0,.05); }
.card-title { font-size:15px; font-weight:600; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
.muted { color:var(--c-text-mute); font-size:12px; }
.gray-bg { background:var(--c-bg-soft); }

/* ---------- 工作台首页 ---------- */
.sop-card { background:linear-gradient(135deg,#f7fdf9 0%,#fff 60%,#f0f9ff 100%); border:1px solid #d9f3e5; border-radius:14px; padding:18px 20px; margin-bottom:18px; box-shadow:0 2px 10px rgba(7,193,96,.10); }
.sop-head { font-size:16px; font-weight:700; color:var(--c-text); }
.sop-sub { font-size:12px; color:#777; margin-top:4px; line-height:1.6; }
.sop-steps { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-top:16px; }
.sop-step { background:var(--c-card); border:1px solid #f0f0f0; border-radius:12px; padding:14px; position:relative; box-shadow:0 1px 3px rgba(0,0,0,.04); }
.sop-step::after { content:'→'; position:absolute; right:-11px; top:34px; color:#c8d6ce; font-size:16px; z-index:1; pointer-events:none; }
.sop-step:last-child::after { content:''; }
.sop-num { width:22px; height:22px; border-radius:50%; background:var(--primary); color:#fff; font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center; }
.sop-title { font-size:13px; font-weight:600; color:var(--c-text); margin-top:8px; }
.sop-desc { font-size:11px; color:var(--c-text-mute); margin-top:3px; line-height:1.55; min-height:32px; }
.sop-cta { margin-top:10px; font-size:12px; padding:5px 11px; border:1px solid var(--primary); color:var(--primary); background:var(--c-card); border-radius:8px; cursor:pointer; }
.sop-cta:hover { background:var(--primary-bg); }
.stat-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:18px; }
.stat-card { background:var(--c-card); border-radius:12px; padding:16px; box-shadow:0 1px 3px rgba(0,0,0,.05); }
.stat-card .num { font-size:26px; font-weight:700; color:var(--c-text); }
.stat-card .label { font-size:12px; color:var(--c-text-sub); margin-top:4px; }
.stat-card .num.green { color:var(--primary); } .stat-card .num.blue { color:#3b82f6; }
.stat-card .num.orange { color:#f59e0b; } .stat-card .num.purple { color:#8b5cf6; }
.stat-card .num.red { color:#e8576a; }
.home-grid { display:grid; grid-template-columns:1.6fr 1fr; gap:14px; }
.panel { background:var(--c-card); border-radius:12px; padding:16px; box-shadow:0 1px 3px rgba(0,0,0,.05); }
.tl-item { display:flex; gap:10px; padding:9px 0; border-bottom:1px dashed #f0f0f0; align-items:flex-start; }
.tl-item:last-child { border-bottom:none; }
.tl-ico { width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:13px; flex:none; }
.tl-ico.create { background:var(--primary-bg); } .tl-ico.adopt { background:#fdf6e3; }
.tl-ico.review { background:#f0f7ff; } .tl-ico.archive { background:var(--c-bg-soft); }
.tl-main { flex:1; min-width:0; }
.tl-title { font-size:13px; color:var(--c-text); }
.tl-detail { font-size:12px; color:var(--c-text-mute); margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.tl-time { font-size:11px; color:var(--c-text-mute); flex:none; }
.empty { text-align:center; color:var(--c-text-mute); padding:30px 0; font-size:13px; }
.expert-row { display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px dashed #f0f0f0; }
.expert-row:last-child { border-bottom:none; }
.expert-row .avatar { width:28px; height:28px; border-radius:50%; color:#fff; font-size:13px; font-weight:600; display:flex; align-items:center; justify-content:center; flex:none; }
.expert-row .ename { font-size:13px; font-weight:600; }
.expert-row .einfo { font-size:11px; color:var(--c-text-mute); }
.expert-row .right { margin-left:auto; text-align:right; }
.insight-item { padding:8px 10px; border-bottom:1px dashed #f0f0f0; font-size:13px; line-height:1.6; }
.insight-item:last-child { border-bottom:none; }
.insight-item .ih { color:var(--c-text); }
.insight-item .muted { font-size:11px; color:var(--c-text-mute); }
.insight-item .badge-st { font-size:11px; padding:1px 6px; border-radius:3px; margin-top:4px; display:inline-block; }

.pr-meta { display:flex; gap:8px; align-items:center; margin-top:4px; font-size:11px; color:var(--c-text-mute); }
.pr-hits { background:var(--primary-bg); color:var(--primary); border-radius:999px; padding:1px 8px; }
.pr-ver { background:var(--c-bg-soft); border-radius:999px; padding:1px 8px; color:var(--c-text-sub); }
.pr-date { color:var(--c-text-mute); }
.pr-stale-tip { color:#e8833a; font-size:11px; }
.insight-item.principle.stale .ih { color:var(--c-text-sub); }
.insight-item.principle { background:#fffbeb; border-left:3px solid #f59e0b; border-radius:4px; margin-bottom:6px; display:flex; align-items:center; gap:10px; }
.insight-item.principle .ih { flex:1; min-width:0; word-break:break-word; }
.insight-item.principle.forbid { background:#fff5f5; border-left-color:#ef4444; }
.pr-add { margin-left:auto; background:var(--primary); color:#fff; border:none; border-radius:6px; padding:5px 14px; font-size:12px; font-weight:600; cursor:pointer; flex:none; }
.pr-add:hover { background:var(--primary-dark); }
.pr-item-btns { display:flex; gap:6px; flex:none; }
.pr-item-btns button { border:none; border-radius:6px; padding:5px 10px; font-size:12px; cursor:pointer; white-space:nowrap; }
.pr-edit { background:#3b82f6; color:#fff; }
.pr-edit:hover { background:#2563eb; }
.pr-del { background:var(--c-bg-soft); color:#b91c1c; }
.pr-del:hover { background:var(--c-bg-soft); }
.pr-sec { font-size:12px; font-weight:600; margin:10px 0 6px; color:var(--c-text-sub); }
.lb-head { display:flex; gap:8px; font-size:11px; color:var(--c-text-mute); padding:6px 0; border-bottom:1px solid #f0f0f0; }
.lb-head span { flex:1; }
.lb-head span:first-child { flex:0 0 90px; }
.lb-row { display:flex; gap:8px; padding:8px 0; border-bottom:1px dashed #f0f0f0; font-size:12px; align-items:center; }
.lb-row .lb-name { flex:0 0 90px; font-weight:600; color:var(--c-text); }
.lb-row > div { flex:1; }
.lb-row .lb-top { color:#b45309; }
.lb-row .lb-bottom { color:#b91c1c; }
.lb-actions { display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
.lb-actions button { border:none; border-radius:6px; padding:6px 12px; font-size:12px; cursor:pointer; }
.lb-hint { background:#fff8e6; border:1px solid #f0d9a8; border-radius:6px; padding:8px 12px; font-size:12px; color:#92400e; margin-bottom:8px; }
.pa-item { display:flex; align-items:center; gap:10px; background:#eef4ff; border-left:3px solid #2563eb; border-radius:4px; margin-bottom:6px; padding:8px 10px; }
.pa-item .ih { flex:1; min-width:0; }
.pa-btns { display:flex; gap:6px; flex:none; }
.pa-btns button { border:none; border-radius:6px; padding:5px 12px; font-size:12px; cursor:pointer; }
.pa-apply { background:var(--primary); color:#fff; }
.pa-apply:hover { background:var(--primary-dark); }
.pa-dismiss { background:var(--c-bg-soft); color:var(--c-text-sub); }
.quick-actions { display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }

/* ---------- 群聊 ---------- */
.chat-shell { max-width:760px; margin:0 auto; background:#ededed; border-radius:14px; overflow:hidden; box-shadow:0 4px 18px rgba(0,0,0,.08); display:flex; flex-direction:column; height:calc(100vh - 54px - 36px); }
.chat-header { background:var(--c-bg-soft); border-bottom:1px solid var(--c-border); padding:12px 16px 8px; }
.chat-header .row1 { display:flex; align-items:center; gap:10px; }
.chat-title { font-size:15px; font-weight:600; }
.chat-work { font-size:11px; color:#0e6b37; background:var(--primary-bg); border-radius:999px; padding:2px 10px; max-width:340px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.chat-work.none { color:var(--c-text-mute); background:var(--c-bg-soft); }
.ctxbar { font-size:11px; color:#7a5c1e; background:#fdf6e3; border:1px solid #f0e0b8; border-radius:6px; padding:4px 8px; margin-top:7px; line-height:1.5; }
.members { margin-top:8px; display:flex; flex-wrap:wrap; gap:6px; }
.hdr-toggle { border:1px solid var(--c-border); background:var(--c-card); border-radius:6px; padding:1px 8px; font-size:11px; color:var(--c-text-sub); cursor:pointer; flex:none; }
.hdr-toggle:hover { background:var(--c-bg-soft); }
.chat-header.collapsed .ctxbar, .chat-header.collapsed .members { display:none; }
.member { display:inline-flex; align-items:center; gap:4px; background:var(--c-card); border:1px solid #e5e5e5; border-radius:999px; padding:2px 10px 2px 3px; font-size:12px; color:var(--c-text); }
.avatar { width:22px; height:22px; border-radius:50%; color:#fff; font-size:12px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; flex:none; }
.chat { flex:1; padding:14px 12px 20px; overflow-y:auto; }
.sys-wrap { text-align:center; margin:10px 0; }
.sys { text-align:center; font-size:11px; color:#8c8c8c; background:#e5e5e5; border-radius:6px; padding:4px 10px; display:inline-block; }
.card-script { background:#fff9ed; border:1px solid #f0d9a8; border-radius:10px; padding:12px 14px; margin:8px 0; font-size:14px; color:#3a2a0a; line-height:1.75; word-break:break-word; box-shadow:0 2px 8px rgba(180,130,0,.08); }
.card-script .head { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
.card-script .t { font-weight:600; color:#a26a00; font-size:12px; flex:1; }
.card-script .meta { font-size:11px; color:#c49a52; }
.card-script .toggle { font-size:12px; color:#a26a00; background:transparent; border:1px solid #e0c080; border-radius:6px; padding:3px 10px; cursor:pointer; }
.card-script .toggle:hover { background:#fff4d6; }
.card-script .body { white-space:pre-wrap; transition:max-height .25s ease; }
.card-script.collapsed .body { max-height:84px; overflow:hidden; position:relative; }
.card-script.collapsed .body::after { content:''; position:absolute; left:0; right:0; bottom:0; height:36px; background:linear-gradient(transparent, #fff9ed); pointer-events:none; }
.card-script .goto-top { position:fixed; right:22px; bottom:90px; z-index:40; background:var(--c-card); border:1px solid #e0c080; color:#a26a00; border-radius:999px; padding:6px 12px; font-size:12px; box-shadow:0 2px 8px rgba(0,0,0,.08); cursor:pointer; display:none; }
.card-script .goto-top.show { display:block; }
.chat { position:relative; }
.msg { display:flex; gap:10px; margin:14px 0; align-items:flex-start; }
.msg .avatar.big { width:40px; height:40px; font-size:17px; }
.msg .bubble { max-width:calc(100% - 60px); background:var(--c-card); border-radius:2px 12px 12px 12px; padding:10px 12px; font-size:14px; line-height:1.75; color:var(--c-text); box-shadow:0 1px 1px rgba(0,0,0,.04); }
.msg .bubble .who { font-size:12px; color:var(--c-text-mute); margin-bottom:2px; font-weight:500; }
.msg .bubble .time { float:right; font-size:10px; color:var(--c-text-mute); margin-top:6px; margin-left:8px; }
.bubble .p { margin:4px 0; }
.bubble strong { color:var(--c-text); }
.bubble .quote { border-left:3px solid #d8d8d8; background:var(--c-bg-soft); padding:6px 10px; margin:8px 0; color:var(--c-text-sub); border-radius:0 6px 6px 0; }
.bubble .ul { margin:6px 0 6px 18px; }
.bubble li { margin:3px 0; }
.bubble .subtitle { font-weight:600; color:var(--c-text); margin:8px 0 4px; }
.bubble .code { background:var(--c-bg-soft); border-radius:6px; padding:8px 10px; font-family:Consolas,monospace; font-size:12px; margin:6px 0; }
.bubble .hr { border-top:1px dashed var(--c-border); margin:10px 0; }
.para-adopt-wrap { border-top:1px dashed #d9d9d9; margin-top:10px; padding-top:8px; }
.para-adopt-hd { font-size:11px; color:var(--c-text-mute); margin-bottom:6px; }
.para-adopt-row { background:#f8f9fa; border-radius:6px; padding:8px; margin-bottom:6px; }
.para-adopt-row .pa-text { font-size:12px; line-height:1.5; margin-bottom:4px; color:var(--c-text); }
.para-adopt-row .pa-text .pa-label { display:inline-block; width:18px; height:18px; border-radius:4px; text-align:center; line-height:18px; font-size:10px; color:#fff; background:#999; margin-right:6px; }
.para-adopt-row .pa-text:first-child .pa-label { background:#e8576a; }
.para-adopt-row .pa-text:nth-child(2) .pa-label { background:var(--primary); }
.para-adopt-row .pa-btn { border:none; background:var(--primary); color:#fff; border-radius:4px; padding:3px 10px; font-size:12px; cursor:pointer; }
.para-adopt-row .pa-btn:hover { background:var(--primary-dark); }
.merge-panel { background:var(--c-card); border-top:2px solid var(--primary); padding:10px 12px; max-height:200px; overflow-y:auto; flex:none; }
.merge-panel .mp-title { font-size:13px; font-weight:600; margin-bottom:6px; display:flex; align-items:center; gap:8px; }
.merge-panel .mp-count { font-size:11px; color:var(--primary); font-weight:400; }
.merge-panel .mp-empty { color:var(--c-text-mute); font-size:12px; padding:4px 0; }
.merge-panel .mp-mini-btn { border:1px solid var(--c-border); background:var(--c-card); border-radius:4px; padding:2px 8px; font-size:11px; cursor:pointer; color:var(--c-text-sub); margin-left:auto; }
.merge-panel .mp-mini-btn:first-of-type { margin-left:auto; }
.merge-panel .mp-mini-btn:hover { background:var(--c-bg-soft); }
.merge-panel .mp-mini-btn.mp-danger { color:#e8576a; border-color:#f0c0c8; }
.merge-panel .mp-preview { background:#f8f9fa; border:1px solid #e8e8e8; border-radius:6px; padding:8px 10px; font-size:12px; line-height:1.7; color:var(--c-text); white-space:pre-wrap; word-break:break-all; margin-top:6px; max-height:300px; overflow-y:auto; }
.merge-item { display:flex; align-items:flex-start; gap:6px; font-size:12px; padding:6px 0; border-bottom:1px dashed #f0f0f0; }
.merge-item:last-child { border-bottom:none; }
.merge-item .mp-from { color:var(--c-text-sub); flex:none; width:50px; font-weight:500; }
.merge-item .mp-orig { color:var(--c-text-mute); text-decoration:line-through; flex:1; min-width:0; }
.merge-item .mp-arrow { color:var(--c-text-mute); flex:none; }
.merge-item .mp-rewr { color:var(--primary); flex:1; min-width:0; }
.merge-item .mp-del { border:none; background:transparent; color:var(--c-text-mute); cursor:pointer; font-size:14px; flex:none; padding:0 2px; line-height:1; }
.merge-item .mp-del:hover { color:#e8576a; }
.typing { display:flex; gap:10px; margin:14px 0; align-items:flex-start; }
.typing .bubble { display:flex; align-items:center; gap:4px; background:var(--c-card); border-radius:2px 12px 12px 12px; padding:12px 14px; }
.typing .dot { width:7px; height:7px; border-radius:50%; background:#bbb; animation:blink 1.2s infinite; }
.typing .dot:nth-child(2) { animation-delay:.2s; }
.typing .dot:nth-child(3) { animation-delay:.4s; }
@keyframes blink { 0%,80%,100% { opacity:.25; transform:translateY(0); } 40% { opacity:1; transform:translateY(-2px); } }
.final { background:#f0f7ff; border:1px solid #bcd7f3; border-radius:12px; padding:14px 14px 10px; margin:16px 0; }
.final .final-head { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.final .badge { background:#3b82f6; color:#fff; font-size:11px; font-weight:600; border-radius:4px; padding:2px 8px; }
.final .who { font-size:13px; font-weight:600; color:#1e4e8c; }
.final .bubble { background:var(--c-card); border-radius:10px; padding:10px 12px; font-size:14px; line-height:1.8; color:var(--c-text); }
.final.review { background:#f0faf2; border-color:#b7e0c0; }
.final.review .badge { background:var(--primary); }
.final.review .who { color:#0e6b37; }
.final.score { background:#f5f0ff; border-color:#d4c2f5; }
.final.score .badge { background:#8B5CF6; }
.final.score .who { color:#5b21b6; }
.final.score .score-num { font-size:15px; font-weight:700; color:#8B5CF6; margin-left:10px; }
.final.learn { background:#fffaf0; border-color:#f0d9a8; }
.final.learn .badge { background:#d97706; }
.final.learn .who { color:#92400e; }
.final.learn .learn-count { font-size:13px; font-weight:700; color:#d97706; margin-left:10px; }
.final.roast { background:#fff5f5; border-color:#f3c2c2; }
.final.roast .badge { background:#ef4444; }
.final.roast .who { color:#b91c1c; }
.final.retention { background:#f0fbfc; border-color:#b8e3e8; }
.final.retention .badge { background:#0E7490; }
.final.retention .who { color:#0e5c70; }
.final.debate { background:#fff4e6; border-color:#f2d3a6; }
.final.debate .badge { background:#d97706; }
.final.debate .who { color:#92400e; }
.final.principle-review { background:#f7f3ff; border-color:#d4c2f5; }
.final.principle-review .badge { background:#7C3AED; }
.final.principle-review .who { color:#5b21b6; }
.adopt-icon { float:right; margin-left:8px; font-size:13px; color:var(--c-text-mute); cursor:pointer; border:none; background:transparent; padding:0; line-height:1; }
.adopt-icon:hover { color:var(--primary); }
.adopt-icon.adopted { color:var(--primary); cursor:default; }
.toolbar { display:flex; gap:6px; padding:8px 12px; background:var(--c-bg-soft); border-top:1px solid var(--c-border); overflow-x:auto; }
.toolbar button { flex:none; white-space:nowrap; background:var(--c-card); border:1px solid var(--c-border); border-radius:999px; padding:6px 14px; font-size:12px; color:var(--c-text); cursor:pointer; }
.toolbar button:hover { background:var(--c-bg-soft); }
.toolbar button.active { background:var(--primary-bg); border-color:var(--primary); color:var(--primary); }
.toolbar button:disabled { opacity:.5; cursor:not-allowed; }
.inputbar { display:flex; align-items:flex-end; gap:8px; background:var(--c-bg-soft); border-top:1px solid var(--c-border); padding:10px 12px; }
.inputbar textarea { flex:1; resize:none; border:1px solid var(--c-border); border-radius:8px; padding:8px 10px; font-size:14px; line-height:1.5; font-family:inherit; max-height:120px; outline:none; background:var(--c-input); color:var(--c-text); }
.inputbar textarea:focus { border-color:var(--primary); }
.inputbar button { flex:none; background:var(--primary); color:#fff; border:none; border-radius:8px; padding:9px 18px; font-size:14px; font-weight:600; }
.inputbar button:hover { background:var(--primary-dark); }
.inputbar button:disabled { background:#b8b8b8; cursor:not-allowed; }
.done-actions { display:flex; flex-direction:column; align-items:center; gap:8px; margin:12px 0 6px; }
.done-steps { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--c-text-sub); background:#f8fafb; border:1px dashed #c9d4dd; border-radius:999px; padding:5px 14px; margin-bottom:2px; }
.done-steps .st { background:var(--c-card); border:1px solid #d0d7de; border-radius:999px; padding:2px 10px; font-weight:600; color:var(--c-text-sub); }
.done-steps .st.ok { background:var(--primary); border-color:var(--primary); color:#fff; }
.done-steps .arr { color:#b8c2cc; font-weight:700; }
.done-steps .st-hint { color:var(--c-text-mute); font-size:11px; }
.done-actions .acts { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; }
.done-actions button { background:var(--c-card); border:1px solid var(--c-border); border-radius:999px; padding:7px 14px; font-size:12px; color:var(--c-text); cursor:pointer; }
.done-actions button:hover { background:var(--c-bg-soft); }
.welcome { background:var(--c-card); border-radius:12px; padding:22px 18px; margin:20px 4px; text-align:center; box-shadow:0 1px 2px rgba(0,0,0,.05); }
.welcome .w-icon { font-size:40px; margin-bottom:10px; }
.welcome .w-title { font-size:16px; font-weight:600; color:var(--c-text); margin-bottom:8px; }
.welcome .w-sub { font-size:13px; color:#777; line-height:1.8; }
.welcome .w-agents { display:flex; justify-content:center; gap:10px; margin-top:16px; flex-wrap:wrap; }
.welcome .w-agent { display:flex; flex-direction:column; align-items:center; gap:4px; }
.welcome .w-agent .avatar { width:34px; height:34px; font-size:15px; }
.welcome .w-agent span.name { font-size:11px; color:var(--c-text-sub); }

/* ---------- 作品库 ---------- */
.chips { display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap; }
.chip { background:var(--c-card); border:1px solid var(--c-border); border-radius:999px; padding:6px 14px; font-size:12px; color:var(--c-text-sub); }
.chip .chip-n { display:inline-block; min-width:18px; text-align:center; margin-left:5px; padding:0 5px; border-radius:999px; background:var(--c-bg-soft); color:var(--c-text-sub); font-size:11px; line-height:16px; }
.chip.active .chip-n { background:rgba(255,255,255,.28); color:#fff; }
.chip:hover { background:var(--c-bg-soft); }
.chip.active { background:var(--primary); border-color:var(--primary); color:#fff; }
.work-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
.work-card { background:var(--c-card); border-radius:12px; padding:14px 16px; box-shadow:0 1px 3px rgba(0,0,0,.05); cursor:pointer; transition:box-shadow .15s, transform .1s; border:1px solid transparent; }
.work-card:hover { box-shadow:0 4px 14px rgba(0,0,0,.09); border-color:#d7f3e2; }
.work-card .wtop { display:flex; align-items:center; gap:8px; }
.work-card .wtitle { font-size:14px; font-weight:600; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.badge-st { font-size:11px; border-radius:4px; padding:2px 8px; flex:none; }
.st-draft { background:var(--c-bg-soft); color:var(--c-text-sub); } .st-discussing { background:#e8f0fe; color:#1e4e8c; }
.st-to_adopt { background:#fdf6e3; color:#a26a00; } .st-published { background:var(--primary-bg); color:#0e6b37; }
.st-reviewed { background:#f5f0ff; color:#5b21b6; } .st-archived { background:var(--c-bg-soft); color:var(--c-text-mute); }
.work-card .wmeta { display:flex; gap:12px; margin-top:10px; font-size:12px; color:var(--c-text-sub); flex-wrap:wrap; }
.work-card .wmeta b { color:var(--c-text); font-weight:600; }
.work-card .wsum { margin-top:8px; font-size:12px; color:var(--c-text-mute); line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.work-card .wacts { margin-top:10px; display:flex; gap:6px; flex-wrap:wrap; }
.work-card .wacts button { font-size:11px; border-radius:6px; padding:4px 10px; border:1px solid var(--c-border); background:var(--c-card); color:var(--c-text-sub); }
.work-card .wacts button:hover { background:var(--c-bg-soft); }
.work-card .wacts button.go { color:var(--primary); border-color:var(--primary); }
.work-card .wacts button.go:hover { background:var(--primary-bg); }
.work-card .wsel { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.work-card .wsel input[type=checkbox] { width:15px; height:15px; accent-color:var(--primary); cursor:pointer; }
.work-card .wsel .cb-lbl { font-size:11px; color:var(--c-text-mute); cursor:pointer; user-select:none; }
.works-toolbar { display:flex; align-items:center; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
.works-toolbar .sel-info { font-size:12px; color:var(--c-text-sub); }
.works-toolbar .batch-btn { border:1px solid var(--c-border); background:var(--c-card); border-radius:8px; padding:6px 14px; font-size:12px; color:var(--c-text-sub); }
.works-toolbar .batch-btn:hover { background:var(--c-bg-soft); }
.works-toolbar .batch-btn.danger { color:#e8576a; border-color:#f0c0c8; }
.works-toolbar .batch-btn.danger:hover { background:#fdecee; }
.work-check-all { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--c-text-sub); }
.work-check-all input { width:15px; height:15px; accent-color:var(--primary); cursor:pointer; }

/* 作品详情抽屉 */
.drawer-mask { position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:80; }
.drawer { position:fixed; top:0; right:0; bottom:0; width:min(560px,92vw); background:var(--c-card); z-index:81; box-shadow:-6px 0 24px rgba(0,0,0,.12); overflow-y:auto; padding:20px 22px 40px; animation:slideIn .18s ease; }
@keyframes slideIn { from { transform:translateX(30px); opacity:.4; } to { transform:translateX(0); opacity:1; } }
.drawer h3 { font-size:16px; margin-bottom:4px; }
.drawer .dmeta { font-size:12px; color:var(--c-text-mute); margin-bottom:14px; }
.drawer .sec { margin:16px 0; }
.drawer .sec-t { font-size:13px; font-weight:600; color:var(--c-text-sub); margin-bottom:8px; display:flex; align-items:center; gap:8px; }
.drawer .box { background:var(--c-bg-soft); border-radius:8px; padding:10px 12px; font-size:13px; line-height:1.7; color:var(--c-text); white-space:pre-wrap; word-break:break-word; max-height:220px; overflow-y:auto; }
.drawer .adopt-item { background:#fdf6e3; border:1px solid #f0e0b8; border-radius:8px; padding:8px 10px; margin-bottom:8px; font-size:12px; }
.drawer .adopt-item.revoked { opacity:.5; text-decoration:line-through; }
.drawer .dbtns { display:flex; gap:8px; margin-top:16px; flex-wrap:wrap; }
.drawer .dbtns button { border-radius:8px; padding:8px 16px; font-size:13px; border:1px solid var(--c-border); background:var(--c-card); color:var(--c-text); }
.drawer .dbtns button:hover { background:var(--c-bg-soft); }
.drawer .dbtns .primary { background:var(--primary); color:#fff; border-color:var(--primary); }
.drawer .dbtns .primary:hover { background:var(--primary-dark); }
.drawer .dbtns .danger { color:#e8576a; border-color:#e8576a; }
.drawer .dbtns .danger:hover { background:#fdecee; }

/* ---------- 版本对比 ---------- */
.ver-list { display:flex; flex-direction:column; gap:8px; }
.ver-item { border:1px solid #e8e8e8; border-radius:10px; overflow:hidden; }
.ver-item .ver-hd { display:flex; align-items:center; gap:8px; padding:8px 12px; background:var(--c-bg-soft); font-size:12.5px; cursor:pointer; }
.ver-item .ver-hd .v-tag { flex:none; font-size:10px; padding:2px 8px; border-radius:999px; background:var(--primary-bg); color:#0e6b37; }
.ver-item .ver-hd .v-tag.orig { background:var(--c-bg-soft); color:var(--c-text-sub); }
.ver-item .ver-hd .v-tag.adopt { background:#fdf6e3; color:#a26a00; }
.ver-item .ver-hd .v-name { flex:1; font-weight:600; color:var(--c-text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ver-item .ver-hd .v-time { flex:none; font-size:11px; color:var(--c-text-mute); }
.ver-item .ver-body { padding:10px 12px; font-size:12.5px; line-height:1.8; color:var(--c-text-sub); white-space:pre-wrap; word-break:break-word; background:var(--c-card); max-height:220px; overflow-y:auto; }
.ver-item .ver-body.hidden { display:none; }

/* ---------- 专家名片 ---------- */
.expert-card { display:flex; align-items:center; gap:14px; }
.expert-card .ec-avatar { width:52px; height:52px; border-radius:50%; color:#fff; font-size:22px; font-weight:700; display:flex; align-items:center; justify-content:center; flex:none; }
.expert-card .ec-info { flex:1; min-width:0; }
.expert-card .ec-name { font-size:17px; font-weight:700; }
.expert-card .ec-title { font-size:12px; color:var(--c-text-sub); margin-top:2px; }
.expert-card .ec-model { font-size:11px; color:var(--primary); background:var(--primary-bg); border-radius:999px; padding:2px 10px; margin-top:6px; display:inline-block; }
.expert-card .ec-desc { font-size:12.5px; color:var(--c-text-sub); line-height:1.7; margin-top:10px; }

/* ---------- 空态 CTA ---------- */
.empty-cta { margin-top:12px; display:flex; justify-content:center; gap:10px; flex-wrap:wrap; }
.empty-cta button { border:none; border-radius:8px; padding:9px 20px; font-size:13px; cursor:pointer; background:var(--primary); color:#fff; font-weight:600; }
.empty-cta button:hover { background:var(--primary-dark); }
.empty-cta button.ghost { background:var(--c-card); color:var(--c-text-sub); border:1px solid var(--c-border); font-weight:400; }
.empty-cta button.ghost:hover { background:var(--c-bg-soft); }

/* ---------- 数据复盘 ---------- */
.stats-grid { display:grid; grid-template-columns:1.4fr 1fr; gap:14px; align-items:start; }
.sec-title { display:flex; align-items:center; gap:8px; font-size:15px; font-weight:700; color:#1a1a1a; margin:22px 0 12px; }
.sec-title:first-of-type { margin-top:4px; }
.sec-title::after { content:''; flex:1; height:1px; background:var(--c-bg-soft); margin-left:4px; }
.sec-title .muted { font-size:11px; font-weight:400; color:var(--c-text-mute); }
.table-wrap { overflow-x:auto; }
table.wtable { width:100%; border-collapse:collapse; font-size:13px; }
.wtable th { text-align:left; font-size:12px; color:var(--c-text-sub); font-weight:500; padding:8px 10px; border-bottom:2px solid var(--c-border); white-space:nowrap; }
.wtable td { padding:9px 10px; border-bottom:1px solid #f2f2f2; }
.wtable tr:hover td { background:var(--c-bg-soft); }
.wtable .num { font-variant-numeric:tabular-nums; text-align:right; }
.wtable th.num { text-align:right; }
.wtable td.num { text-align:right; }
.wtable .center { text-align:center; }
.wtable th.center { text-align:center; }
.trend-bar { display:flex; align-items:flex-end; gap:6px; height:80px; padding:6px 4px 0; }
.trend-bar .bar { flex:1; background:var(--primary); border-radius:4px 4px 0 0; min-height:4px; opacity:.85; position:relative; }
.trend-bar .bar:hover { opacity:1; }
.trend-labels { display:flex; gap:6px; font-size:10px; color:var(--c-text-mute); }
.trend-labels span { flex:1; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* ---------- 学习档案 ---------- */
.learn-hero { display:flex; align-items:center; gap:16px; background:linear-gradient(135deg,#fff7ed,#fffbeb); border:1px solid #f0d9a8; border-radius:12px; padding:16px 18px; margin-bottom:14px; }
.learn-hero .lh-txt { flex:1; min-width:0; }
.learn-hero .lh-title { font-size:15px; font-weight:700; color:#92400e; }
.learn-hero .lh-desc { font-size:12px; color:#b45309; margin-top:4px; line-height:1.6; }
.learn-tabs { display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap; }
.learn-item { background:#fffaf0; border:1px solid #f0d9a8; border-radius:10px; padding:12px 14px; margin-bottom:10px; font-size:13px; line-height:1.8; color:#4a3a1a; }
.learn-item .lh { font-size:11px; color:#b8860b; margin-bottom:6px; }

/* ---------- 设置 ---------- */
.set-card { max-width:640px; }
.set-row { display:flex; justify-content:space-between; align-items:center; padding:13px 0; border-bottom:1px dashed #f0f0f0; gap:16px; }
.set-row:last-child { border-bottom:none; }
.set-row .lbl { font-size:14px; color:var(--c-text); }
.set-row .desc { font-size:12px; color:var(--c-text-mute); margin-top:3px; }
.danger-zone { border:1px solid #f5c6cb; border-radius:12px; padding:6px 16px 14px; margin-top:10px; background:#fff5f6; }
.danger-zone .dz-t { color:#e8576a; font-weight:600; font-size:14px; padding:10px 0 4px; }

/* ---------- 弹窗 ---------- */
.modal-mask { position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:center; justify-content:center; z-index:100; }
.modal-box { background:var(--c-card); width:min(92%,520px); border-radius:14px; padding:20px; box-shadow:0 12px 40px rgba(0,0,0,.22); animation:pop .16s ease; }
@keyframes pop { from { transform:scale(.96); opacity:.5; } to { transform:scale(1); opacity:1; } }
.modal-title { font-size:16px; font-weight:600; margin-bottom:4px; }
.modal-sub { font-size:12px; color:var(--c-text-mute); margin-bottom:12px; line-height:1.6; }
.modal-box textarea { width:100%; min-height:130px; border:1px solid var(--c-border); border-radius:8px; padding:10px; font-size:14px; resize:vertical; outline:none; font-family:inherit; }
.modal-box textarea:focus { border-color:var(--primary); }
.modal-box input[type=text] { width:100%; border:1px solid var(--c-border); border-radius:8px; padding:9px 10px; font-size:14px; margin-bottom:10px; outline:none; }
.modal-box input[type=text]:focus { border-color:var(--primary); }
.modal-btns { display:flex; justify-content:flex-end; gap:10px; margin-top:16px; }
.modal-btns button { border:none; border-radius:8px; padding:9px 20px; font-size:14px; }
.modal-btns .cancel { background:var(--c-bg-soft); color:var(--c-text-sub); }
.modal-btns .ok { background:var(--primary); color:#fff; }
.modal-btns .ok:hover { background:var(--primary-dark); }
.modal-btns .ok.danger { background:#e8576a; }
.modal-btns .ok.danger:hover { background:#d6485c; }
.mfield { margin-bottom:10px; }
.mfield label { display:block; font-size:12px; color:var(--c-text-sub); margin-bottom:4px; }
.radio-group { display:flex; gap:16px; flex-wrap:wrap; }
.radio-group label { display:flex; align-items:center; gap:6px; font-size:14px; color:var(--c-text); cursor:pointer; margin-bottom:0; }
.radio-group input[type=radio] { width:16px; height:16px; accent-color:var(--primary); cursor:pointer; }

/* ---------- 录入数据：文件选择弹窗 ---------- */
.up-box { width:min(92%,600px) !important; }
.up-tabs { display:flex; gap:8px; margin-bottom:14px; border-bottom:1px solid #f0f0f0; padding-bottom:10px; }
.up-tab { border:1px solid var(--c-border); background:var(--c-card); border-radius:999px; padding:6px 16px; font-size:13px; color:var(--c-text-sub); cursor:pointer; }
.up-tab.active { background:var(--primary); border-color:var(--primary); color:#fff; font-weight:600; }
.up-mm-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px 14px; }
.up-mm-grid .mfield { margin-bottom:4px; }
.up-mm-grid input { width:100%; border:1px solid var(--c-border); border-radius:8px; padding:8px 10px; font-size:13px; outline:none; }
.up-mm-grid input:focus { border-color:var(--primary); }
.up-row { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid #f0f0f0; }
.up-row:last-of-type { border-bottom:none; }
.up-info { flex:1; min-width:0; }
.up-label { font-size:14px; font-weight:600; }
.up-desc { font-size:12px; color:var(--c-text-mute); margin-top:2px; }
.up-pick { flex:none; background:#f2f6ff; color:#2563eb; border:1px solid #c7d9ff; border-radius:8px; padding:7px 14px; font-size:13px; cursor:pointer; }
.up-pick:hover { background:#e4edff; }
.up-name { flex:none; max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; color:var(--c-text-mute); text-align:right; }
.up-name.ok { color:var(--primary); }

/* ---------- 争议热力图（句子级决议中心） ---------- */
.heatmap-overlay { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:150; display:flex; align-items:center; justify-content:center; padding:16px; }
.heatmap-box { background:var(--c-card); width:min(98%,1100px); height:min(90vh,800px); max-height:90vh; border-radius:14px; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 16px 50px rgba(0,0,0,.28); }
.heatmap-head { display:flex; align-items:center; gap:12px; padding:14px 18px; border-bottom:1px solid var(--c-border); flex:none; }
.heatmap-head h3 { font-size:16px; font-weight:600; margin:0; }
.heatmap-head .spacer { flex:1; }
.heatmap-head .score-btn { background:var(--primary); color:#fff; border:none; border-radius:8px; padding:7px 14px; font-size:13px; font-weight:600; }
.heatmap-head .score-btn:hover { background:var(--primary-dark); }
.heatmap-head .close { border:none; background:transparent; font-size:22px; cursor:pointer; color:var(--c-text-mute); line-height:1; }
.heatmap-body { flex:1; display:flex; overflow:hidden; }
.heatmap-body .hm-left { flex:1.1; overflow-y:auto; padding:16px 18px; border-right:1px solid #f0f0f0; }
.heatmap-body .hm-right { flex:1; min-width:340px; overflow-y:auto; padding:16px 18px; background:var(--c-bg-soft); }
.heatmap-legend { display:flex; gap:10px; align-items:center; font-size:11px; color:var(--c-text-sub); margin-bottom:12px; flex-wrap:wrap; }
.heatmap-legend .swatch { display:inline-block; width:12px; height:12px; border-radius:3px; vertical-align:middle; margin-right:2px; }
.hm-script { font-size:14px; line-height:2.2; color:var(--c-text); }
.hm-seg { display:inline; border-radius:4px; padding:2px 3px; margin:0 1px; line-height:1.9; cursor:pointer; transition:background .15s; }
.hm-seg:hover { box-shadow:0 0 0 2px rgba(7,193,96,.35); }
.hm-seg.active { box-shadow:0 0 0 3px rgba(7,193,96,.55); }
.hm-seg.lvl0 { background:transparent; }
.hm-seg.lvl1 { background:#fff3cd; }
.hm-seg.lvl2 { background:#ffe0a3; }
.hm-seg.lvl3 { background:#ffc107; }
.hm-seg.lvl4 { background:#ff9800; color:#fff; }
.hm-seg.lvl5 { background:#f44336; color:#fff; }
.hm-seg .hm-badge { font-size:10px; font-weight:700; vertical-align:super; margin-left:2px; }
.hm-empty { text-align:center; color:var(--c-text-mute); font-size:13px; padding:40px 10px; }
.hm-panel .hm-sec-title { font-size:13px; font-weight:600; color:var(--c-text); margin:16px 0 8px; display:flex; align-items:center; gap:8px; }
.hm-panel .hm-sec-title:first-child { margin-top:0; }
.hm-panel .hm-hint { font-size:11px; color:var(--c-text-mute); font-weight:400; }
.hm-panel .hm-current { width:100%; min-height:90px; border:1px solid var(--c-border); border-radius:8px; padding:10px; font-size:14px; line-height:1.7; resize:vertical; }
.hm-panel .hm-actions { display:flex; gap:8px; margin-top:8px; }
.hm-panel .hm-actions button { border:none; border-radius:6px; padding:6px 12px; font-size:12px; cursor:pointer; }
.hm-panel .hm-actions .hm-save { background:var(--primary); color:#fff; }
.hm-panel .hm-actions .hm-save:hover { background:var(--primary-dark); }
.hm-panel .hm-actions .hm-reset { background:var(--c-card); color:var(--c-text-sub); border:1px solid var(--c-border); }
.hm-panel .hm-sec-title .hm-comment-all { margin-left:auto; background:#3b82f6; color:#fff; border:none; border-radius:6px; padding:5px 12px; font-size:12px; font-weight:600; cursor:pointer; }
.hm-panel .hm-sec-title .hm-comment-all:hover { background:#2563eb; }
.hm-sug { background:var(--c-card); border:1px solid #e8e8e8; border-radius:10px; padding:12px; margin-bottom:10px; }
.hm-sug-head { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.hm-sug-head .avatar { width:22px; height:22px; border-radius:50%; color:#fff; font-size:11px; font-weight:600; display:flex; align-items:center; justify-content:center; }
.hm-sug-head .name { font-size:13px; font-weight:600; }
.hm-sug-head .title { font-size:11px; color:var(--c-text-mute); }
.hm-sug-row { font-size:13px; line-height:1.7; margin:5px 0; color:var(--c-text-sub); }
.hm-sug-row b { color:var(--c-text); }
.hm-sug-actions { display:flex; gap:8px; margin-top:10px; }
.hm-sug-actions button { border:1px solid var(--c-border); background:var(--c-card); border-radius:6px; padding:5px 12px; font-size:12px; cursor:pointer; }
.hm-sug-actions .hm-adopt { border-color:var(--primary); color:var(--primary); }
.hm-sug-actions .hm-adopt:hover { background:var(--primary-bg); }
.hm-sug-actions .hm-comment { border-color:#3b82f6; color:#3b82f6; }
.hm-sug-actions .hm-comment:hover { background:#f0f7ff; }
.hm-ranking-mini { margin-top:18px; }
.hm-ranking-mini h4 { font-size:12px; font-weight:600; color:var(--c-text-sub); margin:0 0 8px; }
.hm-ranking-mini .r-item { display:flex; gap:8px; padding:7px 0; border-bottom:1px dashed var(--c-border); font-size:12px; cursor:pointer; }
.hm-ranking-mini .r-item:hover { background:var(--c-bg-soft); margin:0 -18px; padding-left:18px; padding-right:18px; }
.hm-ranking-mini .r-no { flex:none; width:18px; height:18px; border-radius:50%; text-align:center; line-height:18px; font-size:10px; font-weight:700; color:#fff; }
.hm-ranking-mini .r-text { flex:1; color:var(--c-text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.hm-ranking-mini .r-meta { color:var(--c-text-mute); font-size:11px; }
@media (max-width:820px){
  .heatmap-body { flex-direction:column; }
  .heatmap-body .hm-left { border-right:none; border-bottom:1px solid #f0f0f0; flex:none; max-height:45vh; }
  .heatmap-body .hm-right { min-width:auto; }
}

/* ---------- Toast ---------- */
#toastRoot { position:fixed; bottom:26px; left:50%; transform:translateX(-50%); z-index:200; display:flex; flex-direction:column; gap:8px; align-items:center; }
.toast { background:#222; color:#fff; border-radius:10px; padding:11px 16px; font-size:13px; display:flex; align-items:center; gap:12px; box-shadow:0 6px 20px rgba(0,0,0,.25); animation:up .2s ease; max-width:80vw; }
@keyframes up { from { transform:translateY(10px); opacity:.4; } to { transform:translateY(0); opacity:1; } }
.toast .act { color:#4ade80; font-weight:600; cursor:pointer; border:none; background:transparent; font-size:13px; white-space:nowrap; }
.toast .act:hover { text-decoration:underline; }

/* ---------- 对标监控 ---------- */
.mon-add { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
.mon-add input { flex:1 1 180px; border:1px solid var(--c-border); border-radius:8px; padding:8px 10px; font-size:13px; outline:none; }
.mon-add input:focus { border-color:var(--primary); }
.mon-add .btn-primary { flex:none; }
.mon-acc { display:flex; align-items:center; gap:10px; background:var(--c-bg-soft); border:1px solid var(--c-border); border-radius:10px; padding:10px 14px; margin-bottom:8px; }
.mon-acc .avatar { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-weight:600; font-size:14px; flex:none; }
.mon-acc .info { flex:1; min-width:0; }
.mon-acc .nm { font-weight:600; font-size:14px; }
.mon-acc .sub { font-size:12px; color:var(--c-text-mute); }
.mon-acc .del { border:none; background:transparent; color:var(--c-text-mute); font-size:15px; cursor:pointer; padding:4px 8px; }
.mon-acc .del:hover { color:#e8576a; }
.mon-progress { height:6px; background:var(--c-bg-soft); border-radius:4px; overflow:hidden; margin:10px 0; }
.mon-progress .bar { height:100%; background:var(--primary); width:0; transition:width .3s; }
.coll-card { border:1px solid #f5c2c7; background:#fff5f6; border-radius:10px; padding:12px 14px; margin-bottom:10px; }
.coll-card .t { font-weight:600; font-size:14px; color:#c0392b; margin-bottom:6px; }
.coll-card .row { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--c-text-sub); padding:3px 0; }
.coll-card .row .digg { color:#e8576a; font-weight:600; flex:none; }
.coll-card .row .nm { flex:none; font-weight:500; }
.mon-table { width:100%; border-collapse:collapse; font-size:13px; }
.mon-table th { text-align:left; color:var(--c-text-mute); font-weight:500; padding:6px 8px; border-bottom:1px solid var(--c-border); font-size:12px; white-space:nowrap; }
.mon-table td { padding:7px 8px; border-bottom:1px solid #f5f5f5; vertical-align:top; }
.mon-table td.digg { color:#e8576a; font-weight:600; white-space:nowrap; }
.mon-table .num { text-align:right; font-variant-numeric:tabular-nums; }
.mon-table th.num { text-align:right; }
.mon-table td.num { text-align:right; }
.mon-table tr:hover td { background:var(--c-bg-soft); }
.mon-rank { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:6px; font-size:12px; font-weight:700; background:var(--c-bg-soft); color:var(--c-text-sub); }
.mon-rank.r1 { background:#ffd700; color:#7a5c00; }
.mon-rank.r2 { background:var(--c-bg-soft); color:var(--c-text-sub); }
.mon-rank.r3 { background:#f5c9a8; color:#8a4b12; }
.mon-video-desc { cursor:pointer; }
.mon-video-desc:hover { color:var(--primary); }
/* ---------- 洗稿工坊 ---------- */
.rw-head { display:flex; align-items:center; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
.rw-head .t { font-size:18px; font-weight:700; }
.rw-head .sub { color:var(--c-text-mute); font-size:12px; }
.rw-grid { display:grid; grid-template-columns:300px 1fr; gap:14px; align-items:start; }
.rw-list { display:flex; flex-direction:column; gap:10px; max-height:calc(100vh - 220px); overflow-y:auto; }
.rw-item { background:var(--c-card); border-radius:10px; padding:12px 14px; border:1px solid var(--c-border); cursor:pointer; }
.rw-item:hover { border-color:var(--primary); }
.rw-item.active { border-color:var(--primary); background:#f0fbf4; }
.rw-item .t { font-weight:600; font-size:13px; margin-bottom:4px; display:flex; align-items:center; gap:6px; }
.rw-item .meta { font-size:11px; color:var(--c-text-mute); display:flex; gap:8px; flex-wrap:wrap; }
.rw-item .rw-ops { display:flex; gap:6px; margin-top:8px; opacity:0; transition:opacity .15s; }
.rw-item:hover .rw-ops { opacity:1; }
.rw-item .rw-ops button { font-size:11px; border-radius:6px; padding:3px 9px; border:1px solid var(--c-border); background:var(--c-card); color:var(--c-text-sub); }
.rw-item .rw-ops button:hover { background:var(--primary-bg); color:var(--primary); border-color:var(--primary); }
.rw-item .rw-ops button.del:hover { background:#fdecee; color:#e8576a; border-color:#e8576a; }
/* 胜率曲线弹窗 */
.df-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:10px 0; }
.df-col { border:1px solid #eef0f3; border-radius:10px; overflow:hidden; }
.df-col-hd { background:var(--c-bg-soft); font-size:12px; font-weight:600; padding:8px 12px; border-bottom:1px solid #eef0f3; }
.df-body { max-height:46vh; overflow:auto; padding:8px 12px; font-size:13px; line-height:1.8; }
.df-same { padding:2px 0; color:var(--c-text); }
.df-add { background:#dff5e7; color:#0e6b37; padding:2px 6px; border-radius:4px; margin:2px 0; }
.df-del { background:#fdecee; color:#b91c1c; text-decoration:line-through; padding:2px 6px; border-radius:4px; margin:2px 0; }
.df-tag { display:inline-block; font-size:11px; border-radius:999px; padding:2px 10px; margin-right:6px; }
.df-tag.del { background:#fdecee; color:#b91c1c; }
.df-tag.add { background:var(--primary-bg); color:var(--primary); }
.df-tag.same { background:var(--c-bg-soft); color:var(--c-text-sub); }
.wr-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
.wr-card { border:1px solid #eef0f3; border-radius:10px; padding:10px 12px; background:var(--c-bg-soft); }
.wr-card .wr-hd { display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:12px; }
.wr-card .wr-cur { font-size:11px; color:var(--c-text-sub); background:var(--c-card); border:1px solid var(--c-border); border-radius:999px; padding:1px 8px; }
.wr-card .wr-rate { margin-left:auto; font-size:11px; color:var(--c-text-sub); }
.wr-card .wr-empty { font-size:12px; color:var(--c-text-mute); padding:18px 4px; text-align:center; }
.wr-bars { display:flex; align-items:flex-end; gap:5px; height:64px; margin-top:10px; }
.wr-bar { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; gap:2px; }
.wr-bv { width:100%; min-width:8px; border-radius:4px 4px 0 0; background:#d8e2ea; }
.wr-bv.w { background:var(--primary); }
.wr-bv.l { background:#f2b8c0; }
.wr-bt { font-size:9px; color:var(--c-text-mute); }
.wr-legend { font-size:10px; color:var(--c-text-mute); margin-top:6px; text-align:center; }
.wr-evlist { display:flex; flex-direction:column; gap:6px; margin-top:8px; max-height:220px; overflow:auto; }
.wr-ev { font-size:12px; color:var(--c-text-sub); background:var(--c-bg-soft); border-radius:8px; padding:6px 10px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.wr-ev .muted { margin-left:auto; }
.wr-ev-tag { font-size:10px; border-radius:4px; padding:1px 6px; flex:none; }
.wr-ev-tag.keep { background:var(--primary-bg); color:var(--primary); }
.wr-ev-tag.rep { background:#fdecee; color:#e8576a; }

.badge { font-size:10px; padding:2px 8px; border-radius:999px; background:#eef; color:#55a; }
.badge.ok { background:var(--primary-bg); color:var(--primary); }
.badge.warn { background:#fdf3e7; color:#e8833a; }
.badge.busy { background:#fdecee; color:#e8576a; }
.rw-detail { background:var(--c-card); border-radius:12px; padding:16px 18px; box-shadow:0 1px 3px rgba(0,0,0,.05); }
.rw-orig { background:var(--c-bg-soft); border:1px dashed var(--c-border); border-radius:10px; padding:12px 14px; font-size:13px; line-height:1.8; white-space:pre-wrap; max-height:220px; overflow-y:auto; }
.rw-metrics { display:flex; gap:10px; flex-wrap:wrap; margin:10px 0; }
.rw-metric { background:var(--c-bg-soft); border-radius:8px; padding:6px 12px; font-size:12px; }
.rw-metric b { color:var(--primary); font-size:14px; margin-left:4px; }
.rw-stream { display:flex; flex-direction:column; gap:10px; margin-top:14px; }
.rw-msg { border:1px solid var(--c-border); border-left:4px solid #ccc; border-radius:10px; padding:10px 14px; font-size:13px; line-height:1.75; }
.rw-msg.phase { border-left-color:var(--primary); background:#f0fbf4; font-weight:600; color:#0a7a3d; }
.rw-msg.skeleton { border-left-color:#b45309; background:#fdf8f0; }
.rw-msg.analysis { border-left-color:#3b82f6; }
.rw-msg.part { border-left-color:#8b5cf6; background:#faf8ff; }
.rw-msg.review { border-left-color:#7c3aed; background:#f7f4fd; }
.rw-msg.record { border-left-color:#0e7490; background:#f0fbfd; }
.rw-msg.evaluate { border-left-color:#e11d48; background:#fdf2f5; }
.rw-msg .h { font-weight:600; margin-bottom:4px; display:flex; align-items:center; gap:8px; }
.rw-msg .h .tag { font-size:10px; padding:1px 8px; border-radius:999px; background:var(--c-bg-soft); color:var(--c-text-sub); font-weight:400; }
.rw-msg .txt { white-space:pre-wrap; }
.rw-msg .ts { font-size:10px; color:var(--c-text-mute); margin-left:auto; }
.rw-typing { color:var(--c-text-mute); font-size:12px; padding:4px 2px; }
.rw-parts { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:14px; }
.rw-part { border:1px solid var(--c-border); border-radius:10px; padding:10px 12px; background:var(--c-card); }
.rw-part .h { display:flex; align-items:center; gap:8px; font-weight:600; font-size:13px; margin-bottom:6px; }
.rw-part .owner { font-size:11px; color:#fff; background:var(--primary); border-radius:999px; padding:1px 8px; font-weight:400; }
.rw-part .txt { font-size:12.5px; line-height:1.8; white-space:pre-wrap; background:var(--c-bg-soft); border-radius:8px; padding:8px 10px; max-height:200px; overflow-y:auto; }
.rw-part .acts { margin-top:8px; display:flex; gap:8px; }
.rw-part .cmt { font-size:12px; color:var(--c-text-sub); background:var(--c-bg-soft); border-radius:6px; padding:6px 10px; margin-top:6px; }
.rw-untouch { background:#fff7ed; border:1px solid #fed7aa; border-radius:10px; padding:10px 14px; margin-top:12px; }
.rw-untouch .t { font-weight:600; color:#c2410c; margin-bottom:6px; }
.rw-untouch ul { padding-left:18px; font-size:12.5px; color:#7c2d12; line-height:1.9; }
.rw-assign { display:flex; flex-wrap:wrap; gap:8px; margin:10px 0; }
.rw-assign .chip { background:var(--c-card); border:1px solid var(--c-border); border-radius:999px; padding:4px 12px; font-size:12px; display:flex; gap:6px; align-items:center; }
.rw-assign .chip .r { color:var(--c-text-sub); }
.rw-assign .chip .a { font-weight:600; }
.rw-assign .chip .a.new { color:#e11d48; }
.rw-log { margin-top:10px; max-height:240px; overflow-y:auto; }
.rw-log .li { font-size:12px; color:var(--c-text-sub); padding:5px 0; border-bottom:1px dashed #f0f0f0; display:flex; gap:8px; }
.rw-empty { padding:60px 20px; text-align:center; color:var(--c-text-mute); }
.rw-actions { display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }
.rw-bar { font-size:12px; color:var(--c-text-sub); margin-top:10px; }
.rw-filter { display:flex; gap:10px; margin:10px 0 12px; flex-wrap:wrap; }
.rw-filter input { flex:1; min-width:160px; }
.rw-filter select { width:130px; }
.rw-vds { display:flex; flex-direction:column; gap:8px; margin-top:10px; }
.rw-vd { border:1px solid var(--c-border); border-radius:10px; padding:10px 12px; }
.rw-vd.rep { border-left:4px solid #f59e0b; background:#fffbf5; }
.rw-vd.keep { border-left:4px solid var(--primary); }
.rw-vd.applied { opacity:.72; }
.rw-vd .vd-h { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.vd-region { font-weight:600; }
.vd-badge { font-size:12px; padding:2px 8px; border-radius:999px; }
.vd-badge.rep { background:#fef3c7; color:#b45309; }
.vd-badge.keep { background:var(--primary-bg); color:var(--primary); }
.vd-agent { font-size:12px; padding:2px 8px; border-radius:999px; color:#fff; }
.vd-arrow { color:var(--c-text-mute); }
.vd-reason { font-size:12px; color:var(--c-text-sub); margin-top:6px; }
.vd-apply { margin-top:8px; }
.cmt.pending { color:#f59e0b; }
</style>
</head>
<body>
<div class="topbar">
  <div class="brand"><span class="logo">靓</span>靓仔文案工作台<span class="sub">· 口播专家群聊</span></div>
  <div class="top-search">
    <input id="globalSearchInput" placeholder="🔍 搜索作品 / 洗稿 / 档案…" autocomplete="off">
    <div id="globalSearchPanel" class="search-panel hidden"></div>
  </div>
  <div class="bell-wrap">
    <button class="bell-btn" id="bellBtn" title="通知中心">🔔<span id="bellDot" class="bell-dot hidden"></span></button>
    <div id="bellPanel" class="bell-panel hidden"></div>
  </div>
  <button class="theme-btn" id="themeBtn" title="切换主题"></button>
  <div class="top-status" id="topStatus"><span class="dot"></span><span id="topStatusText">待命</span></div>
  <button class="btn-primary" id="btnNewWork">＋ 新建文稿</button>
</div>
<div class="body">
  <aside class="nav" id="nav">
    <div class="nav-group">总览</div>
    <button class="nav-item active" data-view="home">🏠 工作台</button>
    <div class="nav-group">创作</div>
    <button class="nav-item" data-view="chat">💬 专家群聊</button>
    <button class="nav-item" data-view="rewrite">✂️ 洗稿工坊</button>
    <button class="nav-item" data-view="works">📁 作品库</button>
    <button class="nav-item" data-view="monitor">📡 对标监控</button>
    <div class="nav-group">学习与数据</div>
    <button class="nav-item" data-view="skeleton">🦴 骨架库</button>
    <button class="nav-item" data-view="stats">📊 数据复盘</button>
    <button class="nav-item" data-view="learn">🧠 学习档案</button>
    <div class="nav-group">系统</div>
    <button class="nav-item" data-view="settings">⚙️ 设置</button>
  </aside>
  <main class="main">
    <section id="view-home" class="view"></section>
    <section id="view-chat" class="view hidden">
      <div class="chat-shell">
        <div class="chat-header collapsed" id="chatHeader">
          <div class="row1">
            <span class="chat-title">专家群聊</span>
            <span class="chat-work none" id="chatWork">未绑定作品</span>
            <span class="status muted" id="chatStatus" style="margin-left:auto"></span>
            <button class="hdr-toggle" id="hdrToggle" title="展开/收起创作背景与成员列表">详情 ▾</button>
          </div>
          <div class="ctxbar" id="ctxbar">创作背景加载中…</div>
          <div class="members" id="members"></div>
        </div>
        <div class="chat" id="chat"></div>
        <div id="mergePanel" class="merge-panel hidden">
          <div class="mp-title">
            <span>📝 合并编辑器</span>
            <span id="mpCount" class="mp-count"></span>
            <button id="btnTogglePreview" class="mp-mini-btn" title="展开/收起预览">👁 预览</button>
            <button id="btnDiffMerge" class="mp-mini-btn" title="原稿 vs 成品逐段对照">🔍 逐段对照</button>
            <button id="btnCopyMerge" class="mp-mini-btn" title="复制合并后的终稿">📋 复制</button>
            <button id="btnClearMerge" class="mp-mini-btn mp-danger" title="清空所有采纳">清空</button>
          </div>
          <div id="mpList"></div>
          <div id="mpPreview" class="mp-preview hidden"></div>
        </div>
        <div class="toolbar" id="toolbar">
          <button id="btnAdopt" title="开启后点任意专家消息即可采纳">👍 采纳模式</button>
          <button id="btnHeatmap" title="查看原稿各段落的争议热力图">🔥 争议热力</button>
        </div>
        <div class="inputbar">
          <textarea id="input" rows="2" placeholder="粘贴口播文稿，Ctrl+Enter 或点发送 → 专家团队实时讨论"></textarea>
          <button id="send">发送</button>
        </div>
      </div>
    </section>
    <section id="view-works" class="view hidden"></section>
    <section id="view-rewrite" class="view hidden"></section>
    <section id="view-monitor" class="view hidden"></section>
    <section id="view-skeleton" class="view hidden"></section>
    <section id="view-stats" class="view hidden"></section>
    <section id="view-learn" class="view hidden"></section>
    <section id="view-settings" class="view hidden"></section>
  </main>
</div>

<div id="modalRoot"></div>
<div id="toastRoot"></div>

<script>
'use strict';
/* ================= 全局状态 ================= */
const $ = id => document.getElementById(id);
let currentView = 'home';
let currentSid = null;
let currentWorkId = null;
let currentWorkTitle = '';
let members = [];
let busy = false;
let adoptMode = false;
let es = null;
let doneHandled = false;
let ignoreDone = false;
const renderedSeqs = new Set();

const AVATAR_COLORS = { '阿沁':'#E8576A','老周':'#3B82F6','阿爆':'#F59E0B','小黄':'#10B981','爆哥':'#8B5CF6','阿证':'#0D9488','阿骨':'#B45309','阿导':'#E11D48','阿记':'#64748B','阿数':'#0E7490','阿审':'#7C3AED' };
const DEFAULT_COLOR = '#94A3B8';
const RECORDER_NAME = '阿记';
const STATUS_LABELS = { draft:'草稿', discussing:'讨论中', to_adopt:'待采纳', published:'已发布', reviewed:'已复盘', archived:'已归档' };

function esc(s){ const d=document.createElement('div'); d.textContent=s==null?'':s; return d.innerHTML; }
function colorOf(n){ return AVATAR_COLORS[n] || DEFAULT_COLOR; }
function titleOf(n){
  if (!members || !members.length) return '';
  const m = members.find(x=>x.name===n);
  return m ? (m.title||'') : '';
}
function nowTime(){ const d=new Date(); return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); }
function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }
function safeJson(r){ return r.json().catch(()=>({ok:false, error:'服务响应异常'})); }
function post(url, body){ return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})}).then(safeJson).catch(e=>({ok:false, error:'网络错误：'+e.message})); }
function patch(url, body){ return fetch(url,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})}).then(safeJson).catch(e=>({ok:false, error:'网络错误：'+e.message})); }

/* ================= Toast（含撤销动作） ================= */
function showToast(msg, action) {
  const root = $('toastRoot');
  const t = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = '<span>' + esc(msg) + '</span>';
  if (action) {
    const b = document.createElement('button');
    b.className = 'act';
    b.textContent = action.label;
    b.addEventListener('click', () => { action.onClick(); t.remove(); });
    t.appendChild(b);
  }
  root.appendChild(t);
  setTimeout(() => { t.style.opacity='0'; t.style.transition='opacity .3s'; setTimeout(()=>t.remove(),320); }, action && action.ttl ? action.ttl : 4000);
}

/* ================= 弹窗系统 ================= */
function openModal({title, sub='', fields, okText='确定', danger=false, customBody=''}) {
  // fields: [{name,label,type:'text'|'textarea',placeholder,value,rows}]
  const root = $('modalRoot');
  const box = document.createElement('div');
  box.className = 'modal-mask';
  let inner = '<div class="modal-box"><div class="modal-title">' + esc(title) + '</div>';
  if (sub) inner += '<div class="modal-sub">' + esc(sub) + '</div>';
  if (customBody) {
    inner += customBody;
  }
  for (const f of fields || []) {
    inner += '<div class="mfield"><label>' + esc(f.label || '') + '</label>';
    if (f.type === 'textarea') {
      inner += '<textarea rows="' + (f.rows||6) + '" placeholder="' + esc(f.placeholder||'') + '" data-name="' + esc(f.name) + '">' + esc(f.value||'') + '</textarea>';
    } else if (f.type === 'radio') {
      inner += '<div class="radio-group" data-name="' + esc(f.name) + '">' + (f.options||[]).map((opt,i) => {
        const checked = (f.value||'') === opt.value ? ' checked' : '';
        return '<label><input type="radio" name="' + esc(f.name) + '" value="' + esc(opt.value) + '"' + checked + '>' + esc(opt.label) + '</label>';
      }).join('') + '</div>';
    } else {
      inner += '<input type="text" placeholder="' + esc(f.placeholder||'') + '" value="' + esc(f.value||'') + '" data-name="' + esc(f.name) + '">';
    }
    inner += '</div>';
  }
  inner += '<div class="modal-btns"><button class="cancel" data-act="cancel">取消</button><button class="ok' + (danger?' danger':'') + '" data-act="ok">' + esc(okText) + '</button></div></div>';
  box.innerHTML = inner;
  root.appendChild(box);
  const first = box.querySelector('input,textarea');
  if (first) setTimeout(()=>first.focus(), 40);
  const close = v => { root.removeChild(box); if (resolveFn){ const r=resolveFn; resolveFn=null; r(v);} };
  box.querySelector('[data-act=cancel]').addEventListener('click', ()=>close(null));
  box.querySelector('[data-act=ok]').addEventListener('click', ()=>{
    const out = {};
    box.querySelectorAll('[data-name]').forEach(el => {
      if (el.classList && el.classList.contains('radio-group')) {
        const checked = el.querySelector('input[type=radio]:checked');
        out[el.dataset.name] = checked ? checked.value : '';
      } else {
        out[el.dataset.name] = el.value.trim();
      }
    });
    close(out);
  });
  box.addEventListener('mousedown', e => { if (e.target === box) close(null); });
  const escHandler = ev => { if (ev.key === 'Escape') { close(null); document.removeEventListener('keydown', escHandler); } };
  document.addEventListener('keydown', escHandler);
  let resolveFn = null;
  return new Promise(resolve => { resolveFn = resolve; });
}

function confirmDanger(title, sub, okText) {
  return openModal({ title, sub, okText, danger:true, fields:[] }).then(r => r !== null);
}

/* ================= 视图切换 ================= */
function switchView(v) {
  currentView = v;
  document.querySelectorAll('.nav-item').forEach(b => b.classList.toggle('active', b.dataset.view === v));
  ['home','chat','rewrite','works','monitor','skeleton','stats','learn','settings'].forEach(k => $('view-' + k).classList.toggle('hidden', k !== v));
  if (v === 'home') loadOverview();
  if (v === 'works') loadWorks();
  if (v === 'rewrite') loadRewrite();
  if (v === 'monitor') loadMonitor();
  if (v === 'skeleton') loadSkeletons();
  if (v === 'stats') loadStats();
  if (v === 'learn') loadLearnings();
  if (v === 'settings') loadSettings();
  // 离开监控页时清理轮询，避免多实例并存访问已移除的 DOM
  if (v !== 'monitor' && monitorPollTimer) { clearInterval(monitorPollTimer); monitorPollTimer = null; }
  const mainEl = document.querySelector('.main'); if (mainEl) mainEl.scrollTop = 0;
}
document.querySelectorAll('.nav-item').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));

function setTopStatus(text, busyFlag) {
  $('topStatusText').textContent = text;
  $('topStatus').classList.toggle('busy', !!busyFlag);
}

/* ================= 通知中心 ================= */
let bellOpen = false;
const NOTIFY_ICONS = { adopt:'👍', review:'📊', retention:'📉', rewrite:'✂️', session:'💬', debate:'🗳️', system:'📌', learn:'🧠' };
async function loadNotifications() {
  try {
    const d = await fetch('/api/notifications').then(r=>r.json());
    if (!d.ok) return;
    $('bellDot').classList.toggle('hidden', !d.unread);
    $('bellDot').title = d.unread + ' 条未读';
    if (bellOpen) renderBellPanel(d.items);
  } catch (_) {}
}
function renderBellPanel(items) {
  const p = $('bellPanel');
  if (!items || !items.length) {
    p.innerHTML = '<div class="bp-hd"><span>🔔 通知中心</span><span class="spacer"></span></div><div class="bp-empty">暂无通知</div>';
    return;
  }
  p.innerHTML = '<div class="bp-hd"><span>🔔 通知中心</span><span class="spacer"></span>' +
    '<button id="bellReadAll">全部已读</button>' +
    '<button id="bellClear" style="color:var(--c-text-mute)">清空</button></div>' +
    items.map(n => '<div class="bp-item' + (n.read?'':' unread') + '" data-id="' + esc(n.id) + '">' +
      '<span class="bp-ico">' + (NOTIFY_ICONS[n.type]||'📌') + '</span>' +
      '<div class="bp-main"><div class="bp-title">' + esc(n.title) + '</div>' +
      '<div class="bp-body">' + esc(n.body||'') + '</div>' +
      '<div class="bp-time">' + esc((n.ts||'').slice(5,16)) + '</div></div></div>').join('');
  p.querySelectorAll('.bp-item').forEach(el => el.addEventListener('click', ()=>{
    const id = el.dataset.id;
    post('/api/notifications/read', { id }).then(()=>{
      closeBell();
      loadNotifications();
      const item = items.find(x => x.id === id);
      if (item && item.link) {
        if (item.link.view) switchView(item.link.view);
        if (item.link.wid) setTimeout(()=>openWorkDetail(item.link.wid), 250);
        if (item.link.rid) { switchView('rewrite'); setTimeout(()=>selectRewrite(item.link.rid), 250); }
      }
    });
  }));
  $('bellReadAll').addEventListener('click', ()=>{
    post('/api/notifications/read', {}).then(()=>{ loadNotifications(); renderBellPanel(([])); loadNotifications(); });
  });
  $('bellClear').addEventListener('click', ()=>{
    post('/api/notifications/clear').then(()=>{ loadNotifications(); renderBellPanel([]); });
  });
}
function toggleBell() {
  bellOpen = !bellOpen;
  const p = $('bellPanel');
  if (bellOpen) {
    fetch('/api/notifications').then(r=>r.json()).then(d => { if (d.ok) renderBellPanel(d.items); });
    p.classList.remove('hidden');
  } else {
    p.classList.add('hidden');
  }
}
function closeBell() { bellOpen = false; $('bellPanel').classList.add('hidden'); }

/* ================= 全局搜索 ================= */
let searchOpen = false;
async function globalSearch(kw) {
  kw = (kw||'').trim().toLowerCase();
  const panel = $('globalSearchPanel');
  if (!kw) { panel.classList.add('hidden'); searchOpen = false; return; }
  const [wres, rres] = await Promise.all([
    fetch('/api/works').then(r=>r.json()).catch(()=>({works:[]})),
    fetch('/api/rewrite/list').then(r=>r.json()).catch(()=>({sessions:[]})),
  ]);
  const works = (wres.works||[]).filter(w =>
    (w.title||'').toLowerCase().includes(kw) || (w.draft||'').toLowerCase().includes(kw) || (w.final||'').toLowerCase().includes(kw));
  const rws = (rres.sessions||[]).filter(s =>
    (s.title||'').toLowerCase().includes(kw) || (s.original||'').toLowerCase().includes(kw));
  const rows = [];
  works.slice(0,6).forEach(w => rows.push('<div class="sp-item" data-k="w|' + esc(w.id) + '"><span class="sp-type">📁 作品</span><span class="sp-title">' + esc(w.title) + '</span><span class="sp-meta">' + esc(STATUS_LABELS[w.status]||w.status) + '</span></div>'));
  rws.slice(0,6).forEach(s => rows.push('<div class="sp-item" data-k="r|' + esc(s.rid) + '"><span class="sp-type">✂️ 洗稿</span><span class="sp-title">' + esc(s.title||s.rid) + '</span><span class="sp-meta">' + esc((s.created_at||'').slice(0,10)) + '</span></div>'));
  if (!rows.length) rows.push('<div class="sp-hint">没有找到与「' + esc(kw) + '」相关的内容</div>');
  panel.innerHTML = '<div class="sp-hint">找到 ' + (works.length + rws.length) + ' 条结果</div>' + rows.join('');
  panel.classList.remove('hidden');
  searchOpen = true;
  panel.querySelectorAll('.sp-item').forEach(el => el.addEventListener('click', ()=>{
    const [kind, id] = el.dataset.k.split('|');
    $('globalSearchInput').value = ''; panel.classList.add('hidden'); searchOpen = false;
    if (kind === 'w') { switchView('works'); setTimeout(()=>openWorkDetail(id), 250); }
    else { switchView('rewrite'); setTimeout(()=>selectRewrite(id), 250); }
  }));
}
function closeSearch() { searchOpen = false; $('globalSearchPanel').classList.add('hidden'); }

/* ================= 专家名片 ================= */
function showExpertCard(name) {
  const cfg = (window.__MEMBERS || []).find(m => m.name === name);
  const color = colorOf(name);
  const title = cfg ? (cfg.title || '') : (titleOf(name) || '');
  const model = cfg ? (cfg.model || '') : '';
  const desc = cfg ? (cfg.desc || '') : '';
  openModal({
    title: '',
    fields: [],
    okText: '知道了',
    customBody: '<div class="expert-card">' +
      '<div class="ec-avatar" style="background:' + color + '">' + esc(name[0]) + '</div>' +
      '<div class="ec-info"><div class="ec-name">' + esc(name) + '</div>' +
      '<div class="ec-title">' + esc(title) + '</div>' +
      (model ? '<div class="ec-model">⚙ ' + esc(model) + '</div>' : '') +
      '</div></div>' +
      (desc ? '<div class="ec-desc">' + esc(desc) + '</div>' : ''),
  });
}

/* ================= 工作台首页 ================= */
async function loadOverview() {
  const v = $('view-home');
  v.innerHTML = '<div class="empty">加载中…</div>';
  try {
    const d = await fetch('/api/overview').then(r=>r.json());
    if (!d.ok) throw new Error(d.error||'加载失败');
    const c = d.counts || {}, by = c.by_status || {};
    const sopSteps = [
      { n:'1', ico:'📄', t:'新建文稿', d:'粘贴或撰写口播文稿，作为专家讨论底稿', act:'newWorkFlow()', b:'＋ 新建文稿' },
      { n:'2', ico:'💬', t:'专家讨论', d:'7 位文案专家三轮群聊，逐段给改写建议', act:'switchView(\'chat\')', b:'去专家群聊' },
      { n:'3', ico:'👍', t:'采纳成稿', d:'逐段采纳建议，用合并编辑器拼出终稿', act:'switchView(\'chat\')', b:'去采纳建议' },
      { n:'4', ico:'🚀', t:'发布上线', d:'作品库标记已发布，录入播放/留存数据', act:'switchView(\'works\')', b:'去作品库' },
      { n:'5', ico:'📊', t:'数据复盘', d:'留存分析与数据榜单，反哺专家原则库', act:'switchView(\'stats\')', b:'去数据复盘' },
    ];
    const sopHtml = (!c.total) ? '<div class="sop-card"><div class="sop-head">👋 欢迎使用靓仔文案工作台</div><div class="sop-sub">第一次来？按下面 5 步走通「写稿 → 讨论 → 成稿 → 发布 → 复盘」完整闭环，每一步都有对应入口 👇</div><div class="sop-steps">' +
      sopSteps.map(s =>
        '<div class="sop-step"><div class="sop-num">' + s.n + '</div>' +
        '<div class="sop-title">' + s.ico + ' ' + s.t + '</div>' +
        '<div class="sop-desc">' + s.d + '</div>' +
        '<button class="btn-ghost sop-cta" onclick="' + s.act + '">' + s.b + ' →</button></div>'
      ).join('') + '</div></div>' : '';
    const tls = (d.timeline||[]).map(t => {
      const ico = { create:'📄', adopt:'👍', review:'📊', archive:'🗄️' }[t.type] || '•';
      const cls = t.type === 'create' ? 'create' : t.type === 'adopt' ? 'adopt' : t.type === 'review' ? 'review' : 'archive';
      return '<div class="tl-item"><span class="tl-ico ' + cls + '">' + ico + '</span>' +
        '<div class="tl-main"><div class="tl-title">' + esc(t.title||'') + '</div>' +
        (t.detail ? '<div class="tl-detail">' + esc(t.detail) + '</div>' : '') + '</div>' +
        '<span class="tl-time">' + esc((t.ts||'').slice(5,16)) + '</span></div>';
    }).join('') || '<div class="empty">还没有动态，去「＋ 新建文稿」开始第一篇吧</div>';
    const exps = (d.experts||[]).map((e,i) =>
      '<div class="expert-row"><span class="avatar" style="background:' + colorOf(e.name) + '">' + esc(e.name[0]) + '</span>' +
      '<div><div class="ename">' + esc(e.name) + (i===0&&(d.experts||[]).length>0?' 🥇':'') + '</div>' +
      '<div class="einfo">被采纳 ' + e.adopted + ' 次 · ' + (e.avg_plays ? '均播 ' + fmtNum(e.avg_plays) : '暂无播放数据') + '</div></div>' +
      '<div class="right"><div class="muted">' + (e.avg_completion ? '完播 ' + e.avg_completion + '%' : '') + '</div></div></div>'
    ).join('') || '<div class="empty">还没有采纳记录<br><br>去专家群聊对某条建议点 👍 采纳，这里就会出现专家贡献榜<br><br><button class="btn-ghost" style="margin-top:8px" onclick="switchView(\'chat\')">💬 去专家群聊 →</button></div>';
    v.innerHTML = sopHtml +
      '<div class="stat-grid">' +
        statCard(c.total||0,'作品总数','') +
        statCard(by.discussing||0,'讨论中','blue') +
        statCard(by.to_adopt||0,'待采纳','orange') +
        statCard(by.reviewed||0,'已复盘','purple') +
        statCard(c.adopt_total||0,'累计采纳','green') +
      '</div>' +
      '<div class="quick-actions">' +
        '<button class="btn-primary" id="homeRw" style="background:#0ea5e9">✂️ 开始洗稿</button>' +
        '<button class="btn-ghost" id="homeNew">＋ 新建文稿</button>' +
        '<button class="btn-ghost" id="homeChat">💬 去专家群聊</button>' +
        '<button class="btn-ghost" id="homeWorks">📁 查看作品库</button>' +
        '<button class="btn-ghost" id="homeStats">📊 数据复盘</button>' +
      '</div>' +
      '<div class="home-grid" style="margin-top:16px">' +
        '<div class="panel"><div class="card-title">🕒 最近动态</div>' + tls + '</div>' +
        '<div class="panel"><div class="card-title">🏆 专家贡献榜 <span class="muted" style="font-weight:400">按被采纳次数 · 基于 ' + (c.total||0) + ' 个作品</span></div>' + exps + '</div>' +
      '</div>';
    $('homeRw').addEventListener('click', ()=>{ switchView('rewrite'); setTimeout(()=>newRewrite(), 300); });
    $('homeNew').addEventListener('click', newWorkFlow);
    $('homeChat').addEventListener('click', ()=>switchView('chat'));
    $('homeWorks').addEventListener('click', ()=>switchView('works'));
    $('homeStats').addEventListener('click', ()=>switchView('stats'));
  } catch (e) {
    v.innerHTML = '<div class="empty">工作台加载失败：' + esc(e.message) + '</div>';
  }
}
function statCard(num, label, color) {
  return '<div class="stat-card"><div class="num ' + color + '">' + fmtNum(num) + '</div><div class="label">' + esc(label) + '</div></div>';
}
function fmtNum(n) {
  if (n === null || n === undefined) return '—';
  if (typeof n === 'number' && n >= 10000) return (n/10000).toFixed(n>=100000?0:1) + 'w';
  return String(n);
}

/* ================= 新建文稿流程 ================= */
async function newWorkFlow() {
  // done 二次确认：讨论进行中发起新讨论会中断当前现场
  if (busy) {
    const ok = await confirmDanger('当前讨论还在进行中', '发起新讨论会中断当前专家的发言，且当前进度不会保留。确定要新建文稿吗？', '仍要新建');
    if (!ok) return;
  }
  const f = await openModal({
    title: '新建口播文稿',
    sub: '先给作品起个名字（可留空自动取名），再贴入初稿 → 专家团队开始实时讨论',
    fields: [
      { name:'title', label:'作品标题（可选）', type:'text', placeholder:'例如：2026-08 八字看桃花' },
      { name:'script', label:'口播初稿', type:'textarea', rows:8, placeholder:'粘贴你的口播文稿…' },
    ],
    okText: '开始讨论'
  });
  if (!f || !f.script) { if (f) showToast('请贴入文稿内容'); return; }
  const d = await post('/api/start', { script:f.script, title:f.title });
  if (!d.ok) { showToast('⚠ ' + (d.error||'发送失败')); return; }
  bindSession(d.sid, d.work_id, d.work_title);
  switchView('chat');
  startDiscussionLocal(f.script);
}

function bindSession(sid, workId, workTitle) {
  currentSid = sid;
  currentWorkId = workId || null;
  if (workTitle) currentWorkTitle = workTitle;
  if (currentWorkId && !workTitle) {
    fetch('/api/works/' + currentWorkId).then(r=>r.json()).then(d => {
      if (d.ok) { currentWorkTitle = d.work.title; refreshChatWorkChip(); }
    }).catch(()=>{});
  }
  try { localStorage.setItem('wb_sid', sid); localStorage.setItem('wb_work_id', currentWorkId||''); } catch(_){}
  refreshChatWorkChip();
}
function refreshChatWorkChip() {
  const el = $('chatWork');
  if (currentWorkId) { el.textContent = '📁 ' + (currentWorkTitle || '当前作品'); el.className = 'chat-work'; }
  else { el.textContent = '未绑定作品'; el.className = 'chat-work none'; }
}

/* ================= 群聊核心 ================= */
const chat = $('chat'), input = $('input'), sendBtn = $('send');
const membersEl = $('members'), ctxbar = $('ctxbar');
const btnAdopt = $('btnAdopt');
const chatHeader = $('chatHeader'), hdrToggle = $('hdrToggle');
let hdrExpanded = false;
function setHdrExpanded(exp){
  hdrExpanded = exp;
  chatHeader.classList.toggle('collapsed', !exp);
  hdrToggle.textContent = exp ? '收起 ▴' : '详情 ▾';
}
hdrToggle.addEventListener('click', ()=> setHdrExpanded(!hdrExpanded));

function scrollBottom(){ chat.scrollTop = chat.scrollHeight; }
function addSys(text){
  const w = document.createElement('div');
  w.className = 'sys-wrap';
  w.innerHTML = '<span class="sys">' + esc(text) + '</span>';
  chat.appendChild(w); scrollBottom();
}
function addScriptCard(text){
  // 移除旧的初稿卡片（避免重复）
  const old = document.querySelector('.card-script');
  if (old) old.remove();

  const c = document.createElement('div');
  c.className = 'card-script collapsed';
  c.id = 'scriptCard';
  const words = text.length;
  c.innerHTML =
    '<div class="head">' +
      '<span class="t">📄 待讨论 · 口播文稿</span>' +
      '<span class="meta">' + words + ' 字</span>' +
      '<button class="toggle" onclick="toggleScriptCard()">展开</button>' +
    '</div>' +
    '<div class="body">' + esc(text) + '</div>' +
    '<button class="goto-top" id="gotoScriptTop" onclick="gotoScriptTop()">📄 回到初稿</button>';
  chat.insertBefore(c, chat.firstChild);
  scrollBottom();
  updateScriptTopBtn();
}
function toggleScriptCard(){
  const c = document.getElementById('scriptCard');
  if (!c) return;
  const collapsed = c.classList.toggle('collapsed');
  const btn = c.querySelector('.toggle');
  btn.textContent = collapsed ? '展开' : '收起';
}
function gotoScriptTop(){
  const c = document.getElementById('scriptCard');
  if (c) { c.scrollIntoView({ behavior:'smooth', block:'start' }); }
}
function updateScriptTopBtn(){
  const c = document.getElementById('scriptCard');
  const btn = document.getElementById('gotoScriptTop');
  if (!c || !btn) return;
  const rect = c.getBoundingClientRect();
  const chatRect = chat.getBoundingClientRect();
  const hidden = rect.bottom < chatRect.top + 10;
  if (hidden) btn.classList.add('show');
  else btn.classList.remove('show');
}
chat.addEventListener('scroll', updateScriptTopBtn);
function removeTyping(){ const t=$('typing'); if(t) t.remove(); }
function showTyping(m){
  removeTyping();
  const t = document.createElement('div');
  t.className='typing'; t.id='typing';
  t.innerHTML = '<span class="avatar big" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><div class="bubble"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>';
  chat.appendChild(t); scrollBottom();
}
function bubbleNode(m, cls){
  const wrap = document.createElement('div');
  wrap.innerHTML = '<div class="' + cls + '"><span class="avatar big" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span>' +
    '<div class="bubble"><div class="who">'+esc(m.name)+' · '+esc(m.title)+' <span class="time">'+esc(m.time)+'</span></div><div class="inner"></div></div></div>';
  return wrap.firstElementChild;
}
function finalNode(m){
  const wrap = document.createElement('div');
  wrap.innerHTML = '<div class="final"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span>' +
    '<span class="badge">改写建议</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span>' +
    '<span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return wrap.firstElementChild;
}
async function reveal(node, html){
  node.innerHTML = html;
  const ps = node.querySelectorAll('.p');
  ps.forEach(p=>p.style.opacity=0);
  for (const p of ps){ p.style.opacity=1; scrollBottom(); await sleep(120 + Math.min(360, p.textContent.length*2)); }
}
function extractRewrites(text){
  const rewrites=[];
  const blocks=text.split(/(?=【(?:原文|段落定位)】)/);
  blocks.forEach(block=>{
    const om=block.match(/【(?:原文|段落定位)】\s*([\s\S]*?)(?=【改写】|$)/);
    const rm=block.match(/【改写】\s*([\s\S]*?)(?=【理由】|$)/);
    if(om && rm){
      let original=om[1].trim();
      let rewritten=rm[1].trim();
      // 去掉下一个标签残余
      rewritten=rewritten.split(/【/)[0].trim();
      rewrites.push({original, rewritten});
    }
  });
  return rewrites;
}
function attachParagraphAdopt(node, m){
  const inner=node.querySelector('.inner'); if(!inner) return;
  const rewrites=extractRewrites(inner.textContent || '');
  if(!rewrites.length) return;
  const wrap=document.createElement('div');
  wrap.className='para-adopt-wrap';
  wrap.innerHTML='<div class="para-adopt-hd">✂️ 段落级改写建议 · 点击采纳后会进入合并编辑器</div>';
  rewrites.forEach((rw,i)=>{
    const row=document.createElement('div'); row.className='para-adopt-row';
    row.innerHTML='<div class="pa-text"><span class="pa-label">原</span>'+esc(rw.original)+'</div>'+
      '<div class="pa-text"><span class="pa-label">改</span>'+esc(rw.rewritten)+'</div>';
    const btn=document.createElement('button'); btn.className='pa-btn'; btn.textContent='采纳本段';
    btn.onclick=()=>adoptPara(rw.original, rw.rewritten, m.name);
    row.appendChild(btn);
    wrap.appendChild(row);
  });
  inner.appendChild(wrap);
}
async function adoptPara(original, rewritten, agentName){
  if(!currentSid){ showToast('会话未就绪'); return; }
  showToast('已采纳本段改写，正在生成合并预览...');
  try{
    const r=await post('/api/adopt_para',{sid:currentSid, original:original, rewritten:rewritten, agent_name:agentName});
    if(r.ok){
      updateMergePanel(r.preview, r.merges);
      showToast('已收入合并编辑器');
    }else{
      showToast(r.error||'采纳失败');
    }
  }catch(e){ showToast('采纳失败：'+e); }
}

/* ---------- 逐段对照 diff ---------- */
function splitSentences(t){
  return (t||'').split(/(?<=[。！？!?；;\n])/).map(s=>s.trim()).filter(Boolean);
}
function sim(a, b){
  // 字符级 Jaccard 相似度
  if (a===b) return 1;
  const sa=new Set(a), sb=new Set(b);
  if (!sa.size || !sb.size) return 0;
  let inter=0;
  sa.forEach(c=>{ if (sb.has(c)) inter++; });
  return inter / (sa.size + sb.size - inter);
}
function diffHtml(orig, fin){
  // 逐句贪心 diff：返回 HTML，删除句划线红、新增句绿底、相同句原色
  const A = splitSentences(orig), B = splitSentences(fin);
  const escS = s => esc(s).replace(/\n/g,'<br>');
  let i=0, j=0, out='';
  while (i < A.length || j < B.length){
    if (i < A.length && j < B.length && sim(A[i], B[j]) >= 0.55){
      out += '<div class="df-same">' + escS(A[i]) + '</div>';
      i++; j++;
    } else if (j < B.length && (i >= A.length || !A.slice(i, i+2).some(x=>sim(x, B[j]) >= 0.55))){
      out += '<div class="df-add">' + escS(B[j]) + '</div>';
      j++;
    } else if (i < A.length){
      out += '<div class="df-del">' + escS(A[i]) + '</div>';
      i++;
    }
  }
  return out || '<div class="muted">（无内容可对比）</div>';
}
async function showDiffViewer(orig, fin, title){
  if (!fin || !fin.trim()){ showToast('⚠ 还没有成品可对比'); return; }
  const root = $('modalRoot');
  const box = document.createElement('div');
  box.className = 'modal-mask';
  box.innerHTML =
    '<div class="modal-box" style="max-width:720px">' +
      '<div class="modal-title">🔍 ' + (title || '原稿 vs 成品 逐段对照') + '</div>' +
      '<div class="modal-sub"><span class="df-tag del">红底划线 = 被删掉的句子</span><span class="df-tag add">绿底 = 新增/改写的句子</span><span class="df-tag same">原色 = 保留句子</span></div>' +
      '<div class="df-grid">' +
        '<div class="df-col"><div class="df-col-hd">📄 原稿</div><div class="df-body">' + diffHtml(orig, orig) + '</div></div>' +
        '<div class="df-col"><div class="df-col-hd">✅ 成品</div><div class="df-body">' + diffHtml(orig, fin) + '</div></div>' +
      '</div>' +
      '<div class="modal-btns"><button class="cancel" data-act="close">关闭</button>' +
      '<button class="ok" data-act="copy">📋 复制成品</button></div>' +
    '</div>';
  root.appendChild(box);
  box.querySelector('[data-act=close]').addEventListener('click', ()=>box.remove());
  box.querySelector('.modal-mask').addEventListener('click', e=>{ if (e.target===box) box.remove(); });
  box.querySelector('[data-act=copy]').addEventListener('click', ()=>{ if (copyText(fin)){ showToast('✅ 已复制成品'); box.remove(); } });
}
function updateMergePanel(preview, merges){
  const panel=$('mergePanel'); if(!panel) return;
  panel.classList.remove('hidden');
  const list=$('mpList');
  const countEl=$('mpCount');
  countEl.textContent = merges && merges.length ? `(${merges.length}处已采纳)` : '';
  if(!merges || !merges.length){
    list.innerHTML='<div class="mp-empty">暂未采纳任何改写。点击专家消息中的「采纳本段」逐步构建终稿。</div>';
  } else {
    list.innerHTML = merges.map((m,i)=>(
      '<div class="merge-item">'+
        '<span class="mp-from">'+esc(m.agent_name||'专家')+'</span>'+
        '<span class="mp-orig">'+esc((m.original||'').slice(0,50))+((m.original||'').length>50?'…':'')+'</span>'+
        '<span class="mp-arrow">→</span>'+
        '<span class="mp-rewr">'+esc((m.rewritten||'').slice(0,60))+((m.rewritten||'').length>60?'…':'')+'</span>'+
        '<button class="mp-del" data-idx="'+i+'">✕</button>'+
      '</div>'
    )).join('');
    list.querySelectorAll('.mp-del').forEach(btn=>{
      btn.onclick=()=>removeMerge(parseInt(btn.dataset.idx));
    });
  }
  const diffBtn=$('btnDiffMerge');
  if (diffBtn) diffBtn.onclick = ()=>{ showDiffViewer(window.__mergeOriginal || '', preview || '', '原稿 vs 合并成品'); };
  const prevEl=$('mpPreview');
  if(preview){
    prevEl.textContent=preview;
    prevEl.classList.remove('hidden');   // 合并预览默认展开，方便实时查看成稿效果
  }
}
async function removeMerge(idx){
  if(!currentSid) return;
  try{
    const r=await post('/api/merge_remove',{sid:currentSid, idx:idx});
    if(r.ok){ updateMergePanel(r.preview, r.merges); showToast('已移除该条采纳'); }
    else showToast(r.error||'移除失败');
  }catch(e){ showToast('移除失败：'+e); }
}
async function clearMerges(){
  if(!currentSid) return;
  try{
    const r=await post('/api/merge_clear',{sid:currentSid});
    if(r.ok){ updateMergePanel(r.preview, r.merges); showToast('已清空合并编辑器'); }
    else showToast(r.error||'清空失败');
  }catch(e){ showToast('清空失败：'+e); }
}
function resetMergePanel(){
  const panel=$('mergePanel'); if(panel) panel.classList.add('hidden');
  const list=$('mpList'); if(list) list.innerHTML='';
  const prev=$('mpPreview'); if(prev){ prev.textContent=''; prev.classList.add('hidden'); }
  const count=$('mpCount'); if(count) count.textContent='';
}
async function loadExistingMerges(){
  if(!currentSid) return;
  try{ const sd = await fetch('/api/session/'+currentSid).then(r=>r.json()); if (sd.ok && sd.script) window.__mergeOriginal = sd.script; }catch(_){}
  try{ const wd = await fetch('/api/works/'+(currentWorkId||'x')).then(r=>r.json()); if (wd.ok && wd.work && wd.work.draft) window.__mergeOriginal = wd.work.draft; }catch(_){}
  try{
    const r=await post('/api/merge_preview',{sid:currentSid});
    if(r.ok && r.merges && r.merges.length){ updateMergePanel(r.preview, r.merges); }
  }catch(_){}
}
async function handle(m){
  if (m.seq && renderedSeqs.has(m.seq)) return;
  if (m.seq) renderedSeqs.add(m.seq);
  if (m.type==='system'){ addSys(m.text); return; }
  if (m.type==='error'){ addSys('⚠ '+m.text); setBusy(false); return; }
  if (m.type==='script'){ addScriptCard(m.text); return; }
  if (m.type==='typing'){ showTyping(m); return; }
  if (m.type==='message'||m.type==='final'){
    removeTyping();
    const node = m.type==='final' ? finalNode({...m,time:nowTime()}) : bubbleNode({...m,time:nowTime()},'msg');
    node._msg = m;
    chat.appendChild(node); scrollBottom();
    await sleep(700 + Math.random()*600);
    await reveal(node.querySelector('.inner'), m.html || esc(m.text));
    if (m.type==='message'||m.type==='final') attachParagraphAdopt(node, m);
    if (doneHandled) attachAdopt(node);
    scrollBottom();
    return;
  }
  if (m.type==='review'||m.type==='score'||m.type==='learn'||m.type==='retention'){
    removeTyping();
    let node;
    if (m.type==='review') node = reviewNode({...m,time:nowTime()});
    else if (m.type==='score') node = scoreNode({...m,time:nowTime()});
    else if (m.type==='retention') node = retentionNode({...m,time:nowTime()});
    else node = learnNode({...m,time:nowTime()});
    chat.appendChild(node); scrollBottom();
    await sleep(350);
    await reveal(node.querySelector('.inner'), m.html || esc(m.text || m.reason || ''));
    scrollBottom();
    return;
  }
  if (m.type==='score_roast'){
    removeTyping();
    const node = scoreRoastNode({...m,time:nowTime()});
    chat.appendChild(node); scrollBottom();
    await sleep(350);
    await reveal(node.querySelector('.inner'), m.html || esc(m.text || ''));
    scrollBottom();
    return;
  }
  if (m.type==='debate'){
    removeTyping();
    const node = debateNode({...m,time:nowTime()});
    chat.appendChild(node); scrollBottom();
    await sleep(350);
    await reveal(node.querySelector('.inner'), m.html || esc(m.text || ''));
    scrollBottom();
    return;
  }
  if (m.type==='principle_review'){
    removeTyping();
    const node = principleReviewNode({...m,time:nowTime()});
    chat.appendChild(node); scrollBottom();
    await sleep(350);
    await reveal(node.querySelector('.inner'), m.html || esc(m.text || ''));
    scrollBottom();
    return;
  }
  if (m.type==='learn_done'){ ignoreDone=false; addSys('爆款学习完成 · 各专家吸收结果见上方卡片'); setBusy(false); if(es){es.close();es=null;} return; }
  if (m.type==='review_done'){ ignoreDone=false; addSys('复盘分析完成 · 结论见上方卡片'); setBusy(false); if(es){es.close();es=null;} return; }
  if (m.type==='retention_done'){ ignoreDone=false; addSys('📉 留存分析完成 · 句子级诊断见上方卡片'); setBusy(false); if(es){es.close();es=null;} return; }
  if (m.type==='debate_done'){ ignoreDone=false; addSys('🔔 黑榜讨论完成 · 已提炼原则性建议，下次专家产出前会过一遍'); setBusy(false); if(es){es.close();es=null;} return; }
  if (m.type==='teardown_done'){ ignoreDone=false; addSys('🧨 爆款拆解完成 · 已提炼原则性建议并让各专家吸收知识点'); setBusy(false); if(es){es.close();es=null;} return; }
  if (m.type==='score_done'){ ignoreDone=false; addSys('评分完成 · 各专家分数见上方卡片'); setBusy(false); if(es){es.close();es=null;} return; }
  if (m.type==='comment_done'){ addSys('💬 评论迭代完成 · 专家已根据你的反馈修改建议'); setBusy(false); if(es){es.close();es=null;} attachAdoptToAll(); if(document.querySelector('.heatmap-overlay')) showHeatmap(); return; }
  if (m.type==='done'){
    if (ignoreDone) return;
    doneHandled = true;
    addSys('讨论结束 · 各专家段落级改写建议见上方卡片');
    renderDoneActions();
    scrollBottom();
    setBusy(false);
    attachAdoptToAll();
    if (es){ es.close(); es=null; }
  }
}
function reviewNode(m){
  const w=document.createElement('div');
  w.innerHTML='<div class="final review"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">复盘分析</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}
function scoreNode(m){
  const score = (m.score!==null&&m.score!==undefined) ? (Number(m.score).toFixed(1)+' 分') : '未给分';
  const w=document.createElement('div');
  w.innerHTML='<div class="final score"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">评分</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="score-num">'+score+'</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}
function learnNode(m){
  const count=(m.added&&m.added.length)?('+'+m.added.length):'0';
  const w=document.createElement('div');
  w.innerHTML='<div class="final learn"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">爆款吸收</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="learn-count">吸收 '+count+' 条</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}
function scoreRoastNode(m){
  const w=document.createElement('div');
  w.innerHTML='<div class="final roast"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">吐槽打分</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}
function retentionNode(m){
  const w=document.createElement('div');
  w.innerHTML='<div class="final retention"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">留存分析</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}
function debateNode(m){
  const isAnalyst = (m.name==='阿数');
  const w=document.createElement('div');
  w.innerHTML='<div class="final debate"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">'+(isAnalyst?'数据专员':'黑榜讨论')+'</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}
function principleReviewNode(m){
  const w=document.createElement('div');
  w.innerHTML='<div class="final principle-review"><div class="final-head"><span class="avatar" style="background:'+colorOf(m.name)+'">'+esc(m.name[0])+'</span><span class="badge">原则审查</span><span class="who">'+esc(m.name)+' · '+esc(m.title)+'</span><span class="time" style="margin-left:auto;font-size:11px;color:var(--c-text-mute)">'+esc(m.time)+'</span></div><div class="bubble"><div class="inner"></div></div></div>';
  return w.firstElementChild;
}

/* ---------- 采纳（可撤销） + 评论迭代 ---------- */
function attachAdopt(node){
  if (!node || !node._msg || node._adoptIcon) return;
  const m = node._msg;
  if (m.name===RECORDER_NAME || m.type==='review') return;
  const who = node.querySelector('.who');
  if (!who) return;
  const icon = document.createElement('button');
  icon.className='adopt-icon'; icon.title='采纳这条观点'; icon.textContent='👍';
  icon.addEventListener('click', e=>{ e.stopPropagation(); doAdopt(icon, m); });
  who.appendChild(icon);
  node._adoptIcon = icon;
  node.addEventListener('click', ()=>{ if (adoptMode && !icon.classList.contains('adopted')) doAdopt(icon, m); });
  // 评论按钮
  if (m.name && m.name !== RECORDER_NAME){
    const cmt = document.createElement('button');
    cmt.className='adopt-icon'; cmt.title='评论/反驳这条建议，专家会据此修改'; cmt.textContent='💬';
    cmt.style.marginLeft='2px';
    cmt.addEventListener('click', e=>{ e.stopPropagation(); openComment(m); });
    who.appendChild(cmt);
    node._cmtIcon = cmt;
  }
}
function attachAdoptToAll(){ document.querySelectorAll('.msg,.final').forEach(n=>attachAdopt(n)); }

function doAdopt(btn, m){
  if (btn.classList.contains('adopted')) return;
  openModal({
    title: '采纳「' + m.name + '」的建议',
    sub: '选填：写一句备注（为什么采纳 / 想验证什么）。采纳后 6 秒内可撤销。',
    fields: [{ name:'note', label:'备注（可选）', type:'text', placeholder:'为什么采纳这条？' }],
    okText: '采纳'
  }).then(note => {
    if (note === null) return;
    post('/api/adopt', { sid:currentSid, work_id:currentWorkId, name:m.name, round:'讨论', snippet:(m.text||'').slice(0,300), note:(note.note||'').trim() })
      .then(d => {
        if (!d.ok){ addSys('⚠ '+(d.error||'记录失败')); return; }
        btn.classList.add('adopted'); btn.textContent='✓'; btn.title='已采纳';
        if (d.work_id) currentWorkId = d.work_id;
        addRecorderConfirm(d.html || esc(d.text));
        const adoptNo = d.adopt_no;
        showToast('已采纳 ' + m.name + ' 的建议', { label:'撤销', onClick:()=>{
          post('/api/undo-adopt', { work_id:currentWorkId, no:adoptNo, reason:'用户撤销' }).then(r=>{
            if (r.ok){ addSys('↩ 已撤销采纳 #' + adoptNo); btn.classList.remove('adopted'); btn.textContent='👍'; btn.title='采纳这条观点'; }
            else addSys('⚠ 撤销失败：' + (r.error||''));
          });
        }});
      })
      .catch(err => addSys('⚠ 采纳记录失败: ' + err.message));
  });
}
function addRecorderConfirm(html){
  const node = bubbleNode({ name:RECORDER_NAME, title:'记录员', time:nowTime() }, 'msg');
  chat.appendChild(node); scrollBottom();
  reveal(node.querySelector('.inner'), html); scrollBottom();
}

/* ---------- 评论迭代 ---------- */
async function openComment(m){
  if (!currentSid){ showToast('会话未就绪'); return; }
  if (busy){ showToast('请等当前操作完成'); return; }
  const f = await openModal({
    title: '评论「' + m.name + '」的建议',
    sub: '告诉专家哪里不对、你想要什么方向，专家会据此重新修改建议。',
    fields: [{ name:'comment', label:'你的评论/反驳', type:'textarea', rows:5, placeholder:'例如：这个开头太啰嗦了，用户前3秒就会划走。能不能直接用痛点开场？' }],
    okText: '发送评论'
  });
  if (f && f.comment && f.comment.trim()) submitComment(m, f.comment.trim());
}
function submitComment(m, comment){
  if (!currentSid) return;
  setBusy(true);
  post('/api/comment', { sid:currentSid, agent_name:m.name, original_msg:(m.text||''), comment:comment }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'评论失败')); setBusy(false); return; }
    // 重新打开 SSE 接收专家回复
    es = new EventSource('/api/stream/'+currentSid);
    es.onmessage = e=>{ let ev; try{ ev=JSON.parse(e.data); }catch(_){ return; } handle(ev); };
    es.onerror = ()=>{};
  }).catch(err=>{ addSys('⚠ 评论发送失败: '+err.message); setBusy(false); });
}

/* ---------- 操作指令 ---------- */
function startScore(raw){
  const script = (raw||'').replace(/^评分\s*[:：]?\s*/,'').trim();
  if (!script){ addSys('⚠ 请贴入你最终发布的终稿内容'); return; }
  addSys('⭐ 终稿评分请求已发送 · 专家团队正在打分（满分10分）');
  setBusy(true);
  post('/api/score', { sid:currentSid, script }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'评分请求失败')); setBusy(false); return; }
    openStream();
  }).catch(err=>{ addSys('⚠ 评分请求失败: '+err.message); setBusy(false); });
}
function startReview(raw){
  const data = (raw||'').replace(/^复盘\s*[:：]?\s*/,'').trim();
  if (!data){ addSys('⚠ 请贴入实际效果数据（播放量、完播率、点赞、评论等）'); return; }
  addSys('📊 复盘分析请求已发送 · 阿记正在对照数据评估采纳效果');
  setBusy(true);
  post('/api/review', { sid:currentSid, work_id:currentWorkId, data }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'复盘请求失败')); setBusy(false); return; }
    openStream();
  }).catch(err=>{ addSys('⚠ 复盘请求失败: '+err.message); setBusy(false); });
}
async function startRetention(){
  if (!currentSid){ addSys('⚠ 会话未就绪，请先发起一次讨论'); return; }
  // 若当前作品已录入字幕稿/数据指标，自动带入，免手动粘贴
  let preSubtitle = '', pm = {};
  if (currentWorkId){
    try{ const wd = await fetch('/api/works/'+currentWorkId).then(r=>r.json()); if (wd.ok && wd.work){ if (wd.work.subtitle) preSubtitle = wd.work.subtitle; pm = wd.work.metrics||{}; } }catch(_){}
  }
  const pf = (k, en) => { const v = pm[k]; return (v!=null && v!=='') ? String(v) : (en!=null && pm[en]!=null ? String(pm[en]) : ''); };
  const f = await openModal({
    title:'📉 留存分析（数据专员 · 阿数）',
    sub:'贴入已发布视频的字幕稿（逐句）+ 留存数据 + 各项数据指标。阿数会：①逐项数据判级 ②播放量归因 ③句子级黑榜（哪句掉留存最厉害、是不是某专家建议导致的）④提炼原则性建议。',
    fields:[
      {name:'subtitle', label:'字幕稿（逐句）', type:'textarea', rows:10, placeholder:'粘贴视频的口播字幕稿，一句一行或整段均可…', value:preSubtitle},
      {name:'retention', label:'留存曲线数据', type:'textarea', rows:4, placeholder:'例如：0秒100%、3秒92%、5秒85%、10秒60%、15秒40%… 或文字描述趋势'},
      {name:'jump2s', label:'2秒跳出率（%）', type:'text', placeholder:'例如 25', value:pf('2秒跳出率')},
      {name:'comp5s', label:'5秒完播率（%）', type:'text', placeholder:'例如 52', value:pf('5秒完播率')},
      {name:'avgDur', label:'平均播放时长（秒）', type:'text', placeholder:'例如 18', value:pf('平均播放时长')},
      {name:'avgRatio', label:'平均播放占比（%）', type:'text', placeholder:'例如 55', value:pf('平均播放占比')},
      {name:'completion', label:'完播率（%）', type:'text', placeholder:'例如 12', value:pf('完播率','completion')},
      {name:'plays', label:'播放量', type:'text', placeholder:'例如 12000', value:pf('播放量','plays')}
    ],
    okText:'开始分析'
  });
  if (!f || !f.subtitle || !f.subtitle.trim()) return;
  const metrics = {};
  const map = {jump2s:'2秒跳出率', comp5s:'5秒完播率', avgDur:'平均播放时长', avgRatio:'平均播放占比', completion:'完播率', plays:'播放量'};
  for (const k in map){ if (f[k] && f[k].trim()) metrics[map[k]] = f[k].trim(); }
  addSys('📉 留存分析请求已发送 · 阿数正在逐句对照留存曲线做数据判级与句子归因');
  setBusy(true);
  post('/api/retention', { sid:currentSid, subtitle:f.subtitle.trim(), retention:(f.retention||'').trim(), metrics }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'留存分析请求失败')); setBusy(false); return; }
    openStream();
  }).catch(err=>{ addSys('⚠ 留存分析请求失败: '+err.message); setBusy(false); });
}
async function startDebate(){
  if (!currentSid){ addSys('⚠ 会话未就绪，请先发起一次讨论'); return; }
  addSys('🔔 正在把数据专员的黑榜反馈到专家群，开始讨论+投票…');
  setBusy(true);
  post('/api/retention_debate', { sid:currentSid }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'黑榜讨论失败')); setBusy(false); return; }
    openStream();
  }).catch(err=>{ addSys('⚠ 黑榜讨论失败: '+err.message); setBusy(false); });
}
async function startViralTeardown(){
  const f = await openModal({
    title:'🧨 爆款拆解',
    sub:'贴入一篇爆款文案：全员先拆解它为什么爆、投票提炼成原则，随后各专家对照自身知识档案吸收欠缺的知识点。',
    fields:[{name:'article', label:'爆款文案', type:'textarea', rows:10, placeholder:'粘贴爆款文案全文…'}],
    okText:'开始拆解'
  });
  if (!f || !f.article || !f.article.trim()) return;
  switchView('chat');
  setBusy(true);
  post('/api/viral_teardown', { sid: currentSid || '', article: f.article.trim() }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'爆款拆解失败')); setBusy(false); return; }
    if (d.sid !== currentSid){ chat.innerHTML=''; renderedSeqs.clear(); resetMergePanel(); doneHandled=false; ignoreDone=false; }
    bindSession(d.sid, d.work_id || null, d.work_title || '');
    addSys('🧨 爆款拆解已发起 · 全员先拆解为什么爆，再吸收知识点');
    openStream();
  }).catch(err=>{ addSys('⚠ 爆款拆解失败: '+err.message); setBusy(false); });
}
function openStream(){
  ignoreDone = true;
  if (es) es.close();
  es = new EventSource('/api/stream/' + currentSid);
  es.onmessage = e => { let m; try{ m=JSON.parse(e.data);}catch(_){return;} handle(m); };
  es.onerror = () => {};
}
function setBusy(b){
  busy = b;
  sendBtn.disabled = b;
  sendBtn.textContent = b ? '讨论中…' : '发送';
  setTopStatus(b ? '讨论进行中' : (members.length ? '专家团队在线' : '待命'), b);
  $('chatStatus').textContent = b ? '讨论进行中…' : (members.length ? '在线 '+members.length+' 人' : '');
  input.disabled = b;
  if (b) saveDraft();
}
function renderMembers(){
  if (!members.length) return;
  membersEl.innerHTML = members.map(m =>
    '<span class="member" title="点击查看专家名片" style="cursor:pointer" data-m="'+esc(m.name)+'"><span class="avatar" style="background:'+m.color+'">'+esc(m.name[0])+'</span>'+esc(m.name)+'</span>'
  ).join('');
  membersEl.querySelectorAll('.member').forEach(el => el.addEventListener('click', ()=>showExpertCard(el.dataset.m)));
}
function renderDoneActions(){
  const wrap=document.createElement('div'); wrap.className='done-actions';
  const steps=document.createElement('div'); steps.className='done-steps';
  steps.innerHTML =
    '<span class="st ok">① 评分</span><span class="arr">→</span><span class="st">② 发布上线</span><span class="arr">→</span><span class="st">③ 复盘迭代</span>' +
    '<span class="st-hint">按顺序走，效果最好；数据回来后可继续留存 / 黑榜 / 爆款拆解</span>';
    wrap.appendChild(steps);
  const acts=document.createElement('div'); acts.className='acts';
  const actions=[
    {t:'⭐ 终稿评分', sub:'把最终发布的口播终稿贴进来，专家团队会匿名打分并给理由'},
    {t:'📊 效果复盘', sub:'贴实际数据：播放量、完播率、点赞、评论、转化、发布时间等'},
    {t:'📉 留存分析', sub:'贴字幕稿+留存曲线+数据指标，阿数做数据判级+播放量归因+句子级黑榜'},
    {t:'🔔 黑榜讨论', sub:'把数据专员的黑榜反馈到专家群，讨论+投票+提炼原则'},
    {t:'🧨 爆款拆解', sub:'贴一篇爆款文案：全员先拆解它为什么爆+投票提炼原则，再让各专家吸收欠缺的知识点'}
  ];
  for (const a of actions){
    const b=document.createElement('button'); b.textContent=a.t;
    b.addEventListener('click', async ()=>{
      if (a.t.includes('留存')){ startRetention(); return; }
      if (a.t.includes('黑榜')){ startDebate(); return; }
      if (a.t.includes('爆款拆解')){ startViralTeardown(); return; }
      const f=await openModal({ title:a.t.replace(/^.\s+/,''), sub:a.sub, fields:[{name:'content',label:'内容',type:'textarea',rows:7,placeholder:'贴入内容…'}], okText:'发送' });
      if (f && f.content){ if(a.t.includes('评分')) startScore(f.content); else startReview(f.content); }
    });
    acts.appendChild(b);
  }
  wrap.appendChild(acts);
  chat.appendChild(wrap);
}

/* ---------- 静态渲染（刷新恢复） ---------- */
function renderStatic(m){
  if (m.type==='system'){ addSys(m.text); return; }
  if (m.type==='script'){ addScriptCard(m.text); return; }
  if (m.type==='error'){ addSys('⚠ '+m.text); setBusy(false); return; }
  if (m.type==='message'||m.type==='final'){
    const node = m.type==='final' ? finalNode({...m,time:m.time||nowTime()}) : bubbleNode({...m,time:m.time||nowTime()},'msg');
    node._msg = m; chat.appendChild(node);
    node.querySelector('.inner').innerHTML = m.html || esc(m.text||'');
    attachParagraphAdopt(node, m);
    scrollBottom(); return;
  }
  if (m.type==='review'||m.type==='score'||m.type==='learn'||m.type==='retention'){
    const node = m.type==='review' ? reviewNode({...m,time:m.time||nowTime()}) : m.type==='score' ? scoreNode({...m,time:m.time||nowTime()}) : m.type==='retention' ? retentionNode({...m,time:m.time||nowTime()}) : learnNode({...m,time:m.time||nowTime()});
    chat.appendChild(node);
    node.querySelector('.inner').innerHTML = m.html || esc(m.text||m.reason||'');
    scrollBottom(); return;
  }
  if (m.type==='score_roast'){
    const node = scoreRoastNode({...m,time:m.time||nowTime()});
    chat.appendChild(node);
    node.querySelector('.inner').innerHTML = m.html || esc(m.text||'');
    scrollBottom(); return;
  }
  if (m.type==='debate'){
    const node = debateNode({...m,time:m.time||nowTime()});
    chat.appendChild(node);
    node.querySelector('.inner').innerHTML = m.html || esc(m.text||'');
    scrollBottom(); return;
  }
  if (m.type==='principle_review'){
    const node = principleReviewNode({...m,time:m.time||nowTime()});
    chat.appendChild(node);
    node.querySelector('.inner').innerHTML = m.html || esc(m.text||'');
    scrollBottom(); return;
  }
  if (m.type==='done'){ doneHandled=true; addSys('讨论结束 · 各专家段落级改写建议见上方卡片'); renderDoneActions(); scrollBottom(); setBusy(false); attachAdoptToAll(); return; }
  if (m.type==='learn_done'){ addSys('爆款学习完成'); setBusy(false); return; }
  if (m.type==='review_done'){ addSys('复盘分析完成'); setBusy(false); return; }
  if (m.type==='retention_done'){ addSys('📉 留存分析完成'); setBusy(false); return; }
  if (m.type==='debate_done'){ addSys('🔔 黑榜讨论完成'); setBusy(false); return; }
  if (m.type==='teardown_done'){ addSys('🧨 爆款拆解完成'); setBusy(false); return; }
  if (m.type==='score_done'){ addSys('评分完成'); setBusy(false); return; }
  if (m.type==='comment_done'){ addSys('💬 评论迭代完成'); setBusy(false); return; }
}

/* ---------- 发送 / 草稿 ---------- */
function saveDraft(){ try{ localStorage.setItem('wb_draft', input.value); }catch(_){} }
input.addEventListener('input', saveDraft);
function startDiscussionLocal(script){
  doneHandled=false; ignoreDone=false; renderedSeqs.clear();
  resetMergePanel();
  addScriptCard(script);
  input.value=''; try{ localStorage.removeItem('wb_draft'); }catch(_){}
  setBusy(true);
  const sid=currentSid;
  es = new EventSource('/api/stream/'+sid);
  es.onmessage = e=>{ let m; try{ m=JSON.parse(e.data);}catch(_){return;} handle(m); };
  es.onerror = ()=>{};
}
sendBtn.addEventListener('click', ()=>{ const v=input.value.trim(); if(v && !busy){ newWorkFlowDirect(v); } });
input.addEventListener('keydown', e=>{
  if ((e.ctrlKey||e.metaKey) && e.key==='Enter' && !busy){ e.preventDefault(); sendBtn.click(); }
});
function newWorkFlowDirect(script){
  // 直接在输入框发送：绑定当前作品（无则自动创建）
  post('/api/start', { script, work_id:currentWorkId, title:'' }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'发送失败')); setBusy(false); return; }
    bindSession(d.sid, d.work_id, d.work_title);
    startDiscussionLocal(script);
  }).catch(err=>{ addSys('⚠ 连接服务失败: '+err.message); setBusy(false); });
}

/* ---------- 工具栏 ---------- */
/* ----- 合并编辑器按钮 ----- */
$('btnTogglePreview').addEventListener('click', ()=>{
  const el=$('mpPreview');
  if(el.classList.contains('hidden')){
    if(el.textContent.trim()) el.classList.remove('hidden');
    else showToast('暂无预览内容');
  } else { el.classList.add('hidden'); }
});
$('btnCopyMerge').addEventListener('click', async ()=>{
  if(!currentSid){ showToast('会话未就绪'); return; }
  try{
    const r=await post('/api/merge_preview',{sid:currentSid});
    if(r.ok && r.preview){
      await navigator.clipboard.writeText(r.preview);
      showToast('已复制合并终稿到剪贴板');
    } else { showToast('暂无内容可复制'); }
  }catch(e){ showToast('复制失败：'+e); }
});
$('btnClearMerge').addEventListener('click', ()=>{
  if(!currentSid){ showToast('会话未就绪'); return; }
  if(confirm('确定清空所有已采纳的改写吗？')) clearMerges();
});
btnAdopt.addEventListener('click', ()=>{
  adoptMode=!adoptMode;
  btnAdopt.classList.toggle('active', adoptMode);
  addSys(adoptMode ? '👍 已开启采纳模式：点任意专家消息即可采纳' : '已关闭采纳模式');
});
$('btnHeatmap').addEventListener('click', ()=>showHeatmap());

/* ---------- 争议热力图 ---------- */
async function showHeatmap(){
  if(!currentSid){ showToast('会话未就绪'); return; }
  showToast('正在生成争议热力图...');
  try{
    const r = await post('/api/heatmap', {sid:currentSid});
    if(!r.ok){ showToast(r.error||'生成失败'); return; }
    renderHeatmap(r);
  }catch(e){ showToast('生成失败：'+e); }
}

let heatmapData = null;
let heatmapSelectedIdx = -1;

function renderHeatmap(data){
  const old=document.querySelector('.heatmap-overlay'); if(old) old.remove();
  heatmapData = data;
  heatmapSelectedIdx = -1;
  const segs = data.segments || [];
  const maxM = Math.max(1, ...segs.map(s=>s.mentions));

  // 左侧：原稿热力标注
  const annotated = segs.map((s,i)=>{
    const lvl = s.mentions===0 ? 0 : Math.min(5, Math.ceil(s.mentions / maxM * 5));
    const badge = s.mentions>0 ? '<span class="hm-badge">'+s.mentions+'</span>' : '';
    return '<span class="hm-seg lvl'+lvl+'" data-idx="'+i+'">'+esc(s.text)+badge+'</span>';
  }).join('');

  // 右侧：默认空或选第一条有争议的
  const firstHot = segs.findIndex(s=>s.mentions>0);

  // 底部 mini 排行
  const hotspots = (data.hotspots||[]).slice(0,8);
  const rankingHtml = hotspots.length ? hotspots.map((h,i)=>{
    const colors=['#ff9800','#ff5722','#f44336','#e91e63','#9c27b0','#673ab7','#3f51b5','#009688'];
    return '<div class="r-item" data-idx="'+(h.index != null ? h.index : segs.indexOf(h))+'">'+
      '<span class="r-no" style="background:'+(colors[i]||'#999')+'">'+(i+1)+'</span>'+
      '<span class="r-text" title="'+esc(h.text)+'">'+esc(h.text)+'</span>'+
      '<span class="r-meta">'+h.mentions+'人</span></div>';
  }).join('') : '<div style="color:var(--c-text-mute);font-size:12px;padding:8px 0">暂无争议数据</div>';

  const overlay = document.createElement('div');
  overlay.className='heatmap-overlay';
  overlay.innerHTML =
    '<div class="heatmap-box">'+
      '<div class="heatmap-head"><h3>🔥 争议热力 · 句子级决议中心</h3>'+
        '<span style="font-size:12px;color:var(--c-text-sub)">'+(data.total_refs||0)+' 处改写建议 · '+(data.total_segments||0)+' 个句子</span>'+
        '<div class="spacer"></div>'+
        '<button class="score-btn" id="hmScoreBtn">⭐ 终稿评分</button>'+
        '<button class="close" id="hmCloseBtn">✕</button></div>'+
      '<div class="heatmap-body">'+
        '<div class="hm-left">'+
          '<div class="heatmap-legend">'+
            '<span><span class="swatch" style="background:#fff3cd"></span>1人</span>'+
            '<span><span class="swatch" style="background:#ffc107"></span>2-3人</span>'+
            '<span><span class="swatch" style="background:#ff9800"></span>4-5人</span>'+
            '<span><span class="swatch" style="background:#f44336"></span>6+人</span>'+
            '<span style="margin-left:auto;color:var(--c-text-mute)">👈 点击句子查看专家建议</span>'+
          '</div>'+
          '<div class="hm-script">'+annotated+'</div>'+
          '<div class="hm-ranking-mini"><h4>争议排行 TOP'+hotspots.length+'</h4>'+rankingHtml+'</div>'+
        '</div>'+
        '<div class="hm-right" id="hmRight">'+renderHeatmapRightEmpty()+'</div>'+
      '</div>'+
    '</div>';
  overlay.addEventListener('click', e=>{ if(e.target===overlay) overlay.remove(); });
  document.body.appendChild(overlay);

  // 事件绑定
  overlay.querySelectorAll('.hm-seg').forEach(el=>{
    el.addEventListener('click', ()=>{
      const idx = parseInt(el.dataset.idx,10);
      selectHeatmapSegment(idx);
    });
  });
  overlay.querySelectorAll('.hm-ranking-mini .r-item').forEach(el=>{
    el.addEventListener('click', ()=>{
      const idx = parseInt(el.dataset.idx,10);
      selectHeatmapSegment(idx);
    });
  });
  $('hmCloseBtn').addEventListener('click', ()=>overlay.remove());
  $('hmScoreBtn').addEventListener('click', scoreFromHeatmap);

  if (firstHot>=0) selectHeatmapSegment(firstHot);
}

function renderHeatmapRightEmpty(){
  return '<div class="hm-empty">点击左侧原稿中的任意句子<br>查看专家建议、采纳改写、发表评论或手动编辑</div>';
}

function selectHeatmapSegment(idx){
  if (!heatmapData) return;
  const segs = heatmapData.segments || [];
  const seg = segs[idx]; if (!seg) return;
  heatmapSelectedIdx = idx;
  document.querySelectorAll('.hm-seg.active').forEach(el=>el.classList.remove('active'));
  const active = document.querySelector('.hm-seg[data-idx="'+idx+'"]');
  if (active){ active.classList.add('active'); active.scrollIntoView({behavior:'smooth', block:'nearest'}); }
  $('hmRight').innerHTML = renderHeatmapRight(seg);
  bindHeatmapRightEvents(seg);
}

function renderHeatmapRight(seg){
  const suggestions = seg.suggestions || [];
  const sugHtml = suggestions.length ? suggestions.map((s,i)=>{
    const color = colorOf(s.agent) || '#999';
    return '<div class="hm-sug" data-sug-idx="'+i+'">'+
      '<div class="hm-sug-head"><span class="avatar" style="background:'+color+'">'+esc(s.agent[0])+'</span><span class="name">'+esc(s.agent)+'</span><span class="title">'+esc(titleOf(s.agent))+'</span></div>'+
      '<div class="hm-sug-row"><b>改写：</b>'+esc(s.rewritten)+'</div>'+
      '<div class="hm-sug-row"><b>理由：</b>'+esc(s.reason||'（未说明）')+'</div>'+
      '<div class="hm-sug-actions">'+
        '<button class="hm-adopt" data-act="adopt">👍 采纳</button>'+
        '<button class="hm-comment" data-act="comment">💬 评论</button>'+
      '</div>'+
    '</div>';
  }).join('') : '<div style="color:var(--c-text-mute);font-size:13px;padding:10px 0">该句子暂无人给出改写建议。</div>';

  return '<div class="hm-panel">'+
    '<div class="hm-sec-title">📍 当前句子 <span class="hm-hint">可直接编辑</span></div>'+
    '<textarea class="hm-current" id="hmCurrentText">'+esc(seg.text)+'</textarea>'+
    '<div class="hm-actions">'+
      '<button class="hm-save" id="hmSaveBtn">保存为终稿</button>'+
      '<button class="hm-reset" id="hmResetBtn">恢复原文</button>'+
    '</div>'+
    '<div class="hm-sec-title">专家建议 ('+suggestions.length+')'+
      '<button class="hm-comment-all" id="hmCommentAllBtn">💬 都不满意？评论所有专家</button>'+
    '</div>'+
    sugHtml+
  '</div>';
}

function bindHeatmapRightEvents(seg){
  const textarea = $('hmCurrentText');
  $('hmResetBtn').addEventListener('click', ()=>{ textarea.value = seg.text; showToast('已恢复原文'); });
  $('hmSaveBtn').addEventListener('click', ()=> saveHeatmapEdit(seg.text, textarea.value.trim()));

  const commentAllBtn = $('hmCommentAllBtn');
  if (commentAllBtn) commentAllBtn.addEventListener('click', ()=> commentAllFromHeatmap(seg.text));

  document.querySelectorAll('.hm-sug').forEach(card=>{
    const i = parseInt(card.dataset.sugIdx,10);
    const s = (seg.suggestions||[])[i]; if (!s) return;
    card.querySelector('[data-act=adopt]').addEventListener('click', ()=>{
      $('hmCurrentText').value = s.rewritten;
      adoptFromHeatmap(seg.text, s.rewritten, s.agent);
    });
    card.querySelector('[data-act=comment]').addEventListener('click', ()=>{
      commentFromHeatmap(s.agent, seg.text, s.rewritten, s.reason);
    });
  });
}

async function adoptFromHeatmap(original, rewritten, agentName){
  if (!currentSid){ showToast('会话未就绪'); return; }
  try{
    const r = await post('/api/adopt_para', {sid:currentSid, original, rewritten, agent_name:agentName});
    if (r.ok){
      updateMergePanel(r.preview, r.merges);
      showToast('已采纳 '+agentName+' 的改写');
    } else showToast(r.error||'采纳失败');
  }catch(e){ showToast('采纳失败：'+e); }
}

async function saveHeatmapEdit(original, edited){
  if (!currentSid){ showToast('会话未就绪'); return; }
  if (!edited){ showToast('编辑内容不能为空'); return; }
  try{
    // 先移除同一原文的旧采纳（如果有）
    const previewRes = await post('/api/merge_preview', {sid:currentSid});
    const merges = (previewRes.ok && previewRes.merges) ? previewRes.merges : [];
    const oldIdx = merges.findIndex(m => (m.original||'').trim() === original.trim());
    if (oldIdx >= 0){
      const rm = await post('/api/merge_remove', {sid:currentSid, idx:oldIdx});
      if (rm.ok) updateMergePanel(rm.preview, rm.merges);
    }
    // 再保存用户编辑
    const r = await post('/api/adopt_para', {sid:currentSid, original, rewritten:edited, agent_name:'我'});
    if (r.ok){
      updateMergePanel(r.preview, r.merges);
      showToast('已保存你的编辑');
    } else showToast(r.error||'保存失败');
  }catch(e){ showToast('保存失败：'+e); }
}

async function commentFromHeatmap(agentName, original, rewritten, reason){
  const comment = await openModal({
    title: '评论「'+agentName+'」的改写',
    sub: '原句：'+original.slice(0,60)+(original.length>60?'…':'')+'\n改写：'+rewritten.slice(0,60)+(rewritten.length>60?'…':''),
    fields: [{name:'comment', label:'你的评论/反驳', type:'textarea', rows:5, placeholder:'例如：这个改写方向不错，但太长了，再短一点。'}],
    okText: '发送评论'
  });
  if (!comment || !comment.comment || !comment.comment.trim()) return;
  const fullMsg = '【原文】'+original+'\n【改写】'+rewritten+(reason?'\n【理由】'+reason:'')+'\n\n';
  submitComment({name:agentName, text:fullMsg}, comment.comment.trim());
}

async function commentAllFromHeatmap(originalText){
  if (!currentSid){ showToast('会话未就绪'); return; }
  if (busy){ showToast('请等当前操作完成'); return; }
  const f = await openModal({
    title: '评论所有专家',
    sub: '对这句原文的所有专家改写都不满意？写下你的要求，所有专家会根据你的评论重新修改。\n原句：'+originalText.slice(0,80)+(originalText.length>80?'…':''),
    fields: [{name:'comment', label:'你的评论/要求', type:'textarea', rows:5, placeholder:'例如：这几个改写都不够狠。我要的是一上来就让人坐不住的开头，越短越好，不要铺垫。'}],
    okText: '发送给所有专家'
  });
  if (!f || !f.comment || !f.comment.trim()) return;
  setBusy(true);
  // 关闭热力图弹窗，回到群聊看专家回复
  const overlay = document.querySelector('.heatmap-overlay');
  if (overlay) overlay.remove();
  post('/api/comment_all', {sid:currentSid, original_text:originalText, comment:f.comment.trim()}).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'评论失败')); setBusy(false); return; }
    addSys('💬 已发送评论给所有专家，等待修改…');
    openStream();
  }).catch(e=>{ addSys('⚠ 评论失败：'+e); setBusy(false); });
}

async function scoreFromHeatmap(){
  // 优先用当前合并预览作为终稿，方便用户直接打分
  try{
    const r = await post('/api/merge_preview', {sid:currentSid});
    const preview = (r.ok && r.preview) ? r.preview : '';
    const f = await openModal({
      title:'终稿评分',
      sub:'把最终发布的口播终稿贴进来，专家团队会匿名打分并给理由。\n（已自动填入当前合并预览，可直接修改）',
      fields:[{name:'content', label:'终稿', type:'textarea', rows:8, placeholder:'贴入终稿内容…', value:preview}],
      okText:'打分'
    });
    if (f && f.content) startScore(f.content);
  }catch(e){ showToast('打开评分失败：'+e); }
}

/* ---------- 上下文 ---------- */
async function loadCtxbar(){
  try{
    const d = await fetch('/api/context').then(r=>r.json());
    const ctx = d.context||{};
    const parts=[];
    if (ctx.user_identity) parts.push('👩 ' + ctx.user_identity.replace(/^账号主理人是/,'主理人：').replace(/：|:/,'：'));
    if (ctx.target_audience) parts.push('🎯 ' + ctx.target_audience.replace(/^目标受众是/,'受众：').replace(/：|:/,'：'));
    ctxbar.textContent = parts.join(' ｜ ') || '（未配置创作背景）';
  }catch(e){ ctxbar.textContent='（创作背景加载失败）'; }
}

/* ================= 作品库 ================= */
let worksFilter = 'all';
const worksSelected = new Set();
async function loadWorks(){
  const v=$('view-works');
  v.innerHTML = '<div class="empty">加载中…</div>';
  try{
    const d = await fetch('/api/works').then(r=>r.json());
    if (!d.ok) throw new Error(d.error||'加载失败');
    const all = d.works||[];
    const counts = {};
    all.forEach(w=>{ counts[w.status] = (counts[w.status]||0)+1; });
    const chips = ['all','draft','discussing','to_adopt','published','reviewed','archived']
      .map(s => {
        const n = s==='all' ? all.length : (counts[s]||0);
        return '<button class="chip' + (worksFilter===s?' active':'') + '" data-f="' + s + '">' + (s==='all'?'全部':(STATUS_LABELS[s]||s)) + '<span class="chip-n">' + n + '</span></button>';
      }).join('');
    const list = worksFilter==='all' ? all : all.filter(w=>w.status===worksFilter);
    // 清理已删除作品的勾选
    const validIds = new Set(all.map(w=>w.id));
    [...worksSelected].forEach(id=>{ if (!validIds.has(id)) worksSelected.delete(id); });
    if (!list.length) worksSelected.clear();
    const selCount = worksSelected.size;
    const cards = list.map(w=>workCard(w)).join('') ||
      '<div class="empty">' + (worksFilter==='all'
        ? '<div>还没有作品，开始你的第一篇口播创作吧</div><div class="empty-cta"><button onclick="newWorkFlow()">＋ 新建文稿</button><button class="ghost" onclick="switchView(\'rewrite\')">✂️ 去洗稿工坊</button></div>'
        : '该状态下没有作品') + '</div>';
    v.innerHTML =
      '<div class="chips" id="workChips">' + chips + '</div>' +
      '<div class="works-toolbar">' +
        '<label class="work-check-all"><input type="checkbox" id="workCheckAll"' + (list.length && selCount===list.length ? ' checked' : '') + '> 全选</label>' +
        '<span class="sel-info" id="selInfo">' + (selCount ? '已选 ' + selCount + ' 个作品' : '勾选作品可批量操作') + '</span>' +
        (selCount ? '<button class="batch-btn" id="btnBatchArchive">🗄️ 批量归档</button>' : '') +
      '</div>' +
      '<div class="work-grid">' + cards + '</div>';
    const checkAll = $('workCheckAll');
    if (checkAll) checkAll.addEventListener('change', ()=>{
      if (checkAll.checked) list.forEach(w=>worksSelected.add(w.id));
      else list.forEach(w=>worksSelected.delete(w.id));
      loadWorks();
    });
    const btnBatch = $('btnBatchArchive');
    if (btnBatch) btnBatch.addEventListener('click', async ()=>{
      if (!worksSelected.size) return;
      const ok = await confirmDanger('批量归档', '将把选中的 ' + worksSelected.size + ' 个作品归档（可随时恢复），确定吗？', '批量归档');
      if (!ok) return;
      const r = await post('/api/works/batch', { action:'archive', ids:[...worksSelected] });
      showToast(r.ok ? '已归档 ' + r.done + ' 个作品' : ('⚠ ' + (r.error||'失败')));
      if (r.ok){ worksSelected.clear(); loadWorks(); }
    });
    v.querySelectorAll('.chip').forEach(c=>c.addEventListener('click', ()=>{ worksFilter=c.dataset.f; loadWorks(); }));
    v.querySelectorAll('.work-card').forEach(c=>c.addEventListener('click', e=>{
      if (e.target.closest('.wsel') || e.target.closest('button')) return;
      openWorkDetail(c.dataset.wid);
    }));
    v.querySelectorAll('.wsel input').forEach(cb=>cb.addEventListener('change', ()=>{
      const wid = cb.dataset.wid;
      if (cb.checked) worksSelected.add(wid); else worksSelected.delete(wid);
      loadWorks();
    }));
    v.querySelectorAll('[data-act]').forEach(b=>b.addEventListener('click', async e=>{
      e.stopPropagation();
      const wid=b.dataset.wid, act=b.dataset.act;
      if (act==='discuss'){ continueDiscussion(wid); }
      else if (act==='rediscuss'){ rediscuss(wid); }
      else if (act==='data'){ enterMetrics(wid); }
      else if (act==='archive'){ archiveWork(wid); }
      else if (act==='restore'){ restoreWork(wid); }
    }));
  }catch(e){ v.innerHTML='<div class="empty">作品库加载失败：'+esc(e.message)+'</div>'; }
}
function workCard(w){
  const m=w.metrics||{};
  const meta = [
    m.plays!=null?'播放 <b>'+fmtNum(m.plays)+'</b>':'',
    m.completion!=null?'完播 <b>'+m.completion+'%</b>':'',
    (w.adoptions||[]).length?'采纳 <b>'+(w.adoptions||[]).filter(a=>!a.revoked).length+'</b>':'',
    (w.scores&&w.scores.length)?'评分 <b>'+avgScore(w.scores)+'</b>':''
  ].filter(Boolean).join('　') || '尚无效果数据';
  const acts = '<button class="go" data-act="discuss" data-wid="'+w.id+'" title="恢复上次讨论现场">继续讨论</button>' +
    '<button data-act="rediscuss" data-wid="'+w.id+'" title="用当前作品初稿重新发起一轮完整讨论">重新讨论</button>' +
    (w.status!=='archived' ? '<button data-act="data" data-wid="'+w.id+'">录入数据</button><button data-act="archive" data-wid="'+w.id+'">归档</button>'
                            : '<button data-act="restore" data-wid="'+w.id+'">恢复</button>');
  return '<div class="work-card" data-wid="'+w.id+'">' +
    '<div class="wsel"><input type="checkbox" data-wid="'+w.id+'"' + (worksSelected.has(w.id)?' checked':'') + '><span class="cb-lbl">选择</span></div>' +
    '<div class="wtop"><span class="wtitle">'+esc(w.title||'未命名')+'</span><span class="badge-st st-'+esc(w.status)+'">'+esc(STATUS_LABELS[w.status]||w.status)+'</span></div>' +
    '<div class="wsum">'+esc((w.final||w.draft||'').slice(0,90))+'…</div>' +
    '<div class="wmeta">'+meta+'</div>' +
    '<div class="wmeta muted">'+esc((w.created_at||'').slice(0,16))+'</div>' +
    '<div class="wacts">'+acts+'</div></div>';
}
function avgScore(scores){
  if (!scores || !scores.length) return '—';
  const last = scores[scores.length-1]?.scores || [];
  const vals = last.map(s=>s.score).filter(s=>s!=null);
  if (!vals.length) return '—';
  return (vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(1);
}
async function continueDiscussion(wid){
  // 「继续讨论」= 恢复上次讨论现场（只看/接着操作），绝不重新跑一遍讨论
  let work = null;
  try{ const d = await fetch('/api/works/'+wid).then(r=>r.json()); if (d.ok) work = d.work; }catch(_){}
  const sid = work && work.session_id;
  if (sid){
    try{
      const sd = await fetch('/api/session/'+sid).then(r=>r.json());
      if (sd.ok){
        await restoreSession(sd);
        switchView('chat');
        return;
      }
    }catch(_){}
  }
  // 没有可恢复的讨论记录：提示改用「重新讨论」（不会自动重跑）
  showToast('⚠ 这个作品还没有可恢复的讨论记录，请点「重新讨论」发起新一轮');
}
async function rediscuss(wid){
  // 「重新讨论」= 用当前作品已保存的初稿重新发起一轮完整讨论（初稿已自动带上，无需再输入）
  let work = null;
  try{ const d = await fetch('/api/works/'+wid).then(r=>r.json()); if (d.ok) work = d.work; }catch(_){}
  const prefill = work ? ((work.draft || work.final || '').trim()) : '';
  if (!prefill){ showToast('⚠ 这个作品没有初稿内容，无法重新讨论'); return; }
  const ok = await openModal({
    title:'重新讨论',
    sub:'将用当前作品已保存的初稿重新发起一轮完整讨论（生成新的讨论记录，旧记录仍会保留在本地）。',
    fields:[], okText:'重新讨论'
  });
  if (!ok) return;
  const d = await post('/api/start', { script:prefill, work_id:wid, title:'' });
  if (!d.ok){ showToast('⚠ '+(d.error||'失败')); return; }
  bindSession(d.sid, d.work_id, d.work_title);
  switchView('chat');
  startDiscussionLocal(prefill);
}
async function restoreSession(sd){
  // 恢复一个已存在的会话现场：清空聊天区、渲染历史、按需重连 SSE
  if (es){ try{ es.close(); }catch(_){ } es = null; }
  chat.innerHTML = '';
  renderedSeqs.clear();
  doneHandled = false; ignoreDone = false;
  resetMergePanel();
  currentSid = sd.sid || currentSid;
  if (sd.work_id){ currentWorkId = sd.work_id; }
  if (sd.members && sd.members.length){ members = sd.members; renderMembers(); }
  for (const m of (sd.history||[])){
    if (m.seq) renderedSeqs.add(m.seq);
    if (m.type === 'typing') continue;
    renderStatic(m);
  }
  refreshChatWorkChip();
  try{ localStorage.setItem('wb_sid', currentSid); localStorage.setItem('wb_work_id', currentWorkId||''); }catch(_){}
  if (sd.interrupted){
    addSys('⚠ 上次讨论进行中被中断（应用关闭），已恢复到此。可点「重新讨论」发起新一轮。');
  }
  // live=false（从磁盘重建）或已结束 → 只渲染历史，不重连 SSE；live=true 且未结束 → 继续直播
  if (sd.live && !sd.finished){
    setBusy(true);
    es = new EventSource('/api/stream/'+currentSid);
    es.onmessage = e=>{ let m; try{ m=JSON.parse(e.data); }catch(_){ return; } handle(m); };
    es.onerror = ()=>{};
  } else {
    setBusy(false);
    loadExistingMerges();
    if (!doneHandled){
      // 中断恢复（无 done 事件）时也补上动作入口，保证评分/复盘/留存等操作可用
      renderDoneActions();
      attachAdoptToAll();
    }
  }
}
async function enterMetrics(wid){
  // 录入作品数据：📁 文件提交（xlsx+txt 自动解析） / ✍️ 手动填写（直接填指标数值）
  const slots = [
    {key:'traffic', label:'📊 流量数据', desc:'播放量、点赞量、评论量、分享量、收藏量、完播率、2s跳出率', kind:'xlsx'},
    {key:'content', label:'📈 内容吸引力分析', desc:'完播率、平均播放时长、2s跳出率、5s完播率、平均播放占比', kind:'xlsx'},
    {key:'audience', label:'👥 观众分析', desc:'涨粉量、涨粉率', kind:'xlsx'},
    {key:'subtitle', label:'📄 字幕稿', desc:'口播逐字稿（txt）', kind:'txt'},
  ];
  const mmFields = [
    {k:'播放量', ph:'例如 125000 或 12.5w'},
    {k:'完播率', ph:'例如 8.6（%）'},
    {k:'2秒跳出率', ph:'例如 45.2（%）'},
    {k:'5秒完播率', ph:'例如 62.3（%）'},
    {k:'平均播放时长', ph:'例如 15.4（秒）'},
    {k:'平均播放占比', ph:'例如 12.8（%）'},
    {k:'点赞量', ph:'例如 3200'},
    {k:'评论量', ph:'例如 128'},
  ];
  const root = $('modalRoot');
  const box = document.createElement('div');
  box.className = 'modal-mask';
  const rowsHtml = slots.map(s =>
    '<div class="up-row">' +
      '<div class="up-info"><div class="up-label">' + s.label + '</div><div class="up-desc">' + s.desc + '</div></div>' +
      '<button class="up-pick" data-pick="' + s.key + '">选择文件</button>' +
      '<div class="up-name" data-name="' + s.key + '">未选择</div>' +
    '</div>'
  ).join('');
  const mmHtml = '<div class="up-mm-grid">' + mmFields.map(f =>
    '<div class="mfield"><label>' + esc(f.k) + '</label><input type="text" data-mm="' + esc(f.k) + '" placeholder="' + esc(f.ph) + '"></div>'
  ).join('') + '</div>' +
  '<div class="muted" style="margin-top:10px">支持数字、百分比小数（0~1 自动转 %）、带 w 的万单位。保存后作品标记为「已发布」。</div>';
  box.innerHTML = '<div class="modal-box up-box">' +
    '<div class="modal-title">录入作品数据</div>' +
    '<div class="modal-sub">两种方式任选：提交数据文件自动解析，或手动填写关键指标。至少填一项即可。</div>' +
    '<div class="up-tabs">' +
      '<button class="up-tab active" data-tab="file">📁 文件提交</button>' +
      '<button class="up-tab" data-tab="manual">✍️ 手动填写</button>' +
    '</div>' +
    '<div class="up-body" id="upBodyFile">' + rowsHtml + '</div>' +
    '<div class="up-body hidden" id="upBodyManual">' + mmHtml + '</div>' +
    '<div class="modal-btns"><button class="cancel" data-act="cancel">取消</button><button class="ok" data-act="ok">保存</button></div></div>';
  root.appendChild(box);
  const picked = {};
  const close = () => { root.removeChild(box); };
  box.querySelector('[data-act=cancel]').addEventListener('click', close);
  // tab 切换
  box.querySelectorAll('.up-tab').forEach(tb => tb.addEventListener('click', ()=>{
    box.querySelectorAll('.up-tab').forEach(x=>x.classList.remove('active'));
    tb.classList.add('active');
    const tab = tb.dataset.tab;
    box.querySelector('#upBodyFile').classList.toggle('hidden', tab !== 'file');
    box.querySelector('#upBodyManual').classList.toggle('hidden', tab !== 'manual');
  }));
  box.querySelectorAll('[data-pick]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const key = btn.dataset.pick;
      const slot = slots.find(s => s.key === key);
      const p = await pickFile(slot.kind);
      if (p) {
        picked[key] = p;
        const nameEl = box.querySelector('[data-name="' + key + '"]');
        nameEl.textContent = p.split(/[\\/]/).pop();
        nameEl.classList.add('ok');
      }
    });
  });
  box.querySelector('[data-act=ok]').addEventListener('click', async () => {
    const activeTab = box.querySelector('.up-tab.active').dataset.tab;
    if (activeTab === 'file') {
      if (!Object.keys(picked).length) { showToast('⚠ 请先选择至少一个数据文件'); return; }
      const okBtn = box.querySelector('[data-act=ok]');
      okBtn.disabled = true; okBtn.textContent = '解析中…';
      try {
        const d = await post('/api/import_metrics', { wid, files: picked });
        close();
        if (!d.ok) { showToast('⚠ ' + (d.error || '导入失败')); return; }
        const keys = Object.keys(d.metrics || {});
        let msg = keys.length
          ? '数据已保存：' + keys.slice(0, 8).map(k => k + '=' + d.metrics[k]).join('、')
          : '数据已保存';
        if (d.subtitle) msg += ' · 字幕稿 ' + d.subtitle.length + ' 字';
        showToast(msg);
        if (d.analysis_started) showToast('📉 数据专员阿数已开始自动分析留存，完成后在作品详情/数据复盘查看');
        (d.warnings || []).forEach(w => showToast('⚠ ' + w));
        loadWorks();
      } catch (e) {
        okBtn.disabled = false; okBtn.textContent = '解析并保存';
        showToast('⚠ 导入失败: ' + e.message);
      }
    } else {
      const metrics = {};
      box.querySelectorAll('[data-mm]').forEach(inp => { if (inp.value.trim()) metrics[inp.dataset.mm] = inp.value.trim(); });
      if (!Object.keys(metrics).length) { showToast('⚠ 请至少填写一项指标'); return; }
      const okBtn = box.querySelector('[data-act=ok]');
      okBtn.disabled = true; okBtn.textContent = '保存中…';
      try {
        const d = await post('/api/manual_metrics', { wid, metrics });
        close();
        if (!d.ok) { showToast('⚠ ' + (d.error || '保存失败')); return; }
        showToast('✅ 已保存 ' + Object.keys(metrics).length + ' 项指标');
        loadWorks();
      } catch (e) {
        okBtn.disabled = false; okBtn.textContent = '保存';
        showToast('⚠ 保存失败: ' + e.message);
      }
    }
  });
}
async function pickFile(kind){
  // 桌面端：原生文件对话框（pywebview js_api）
  try {
    if (window.pywebview && window.pywebview.api && window.pywebview.api.pick_file) {
      const p = await window.pywebview.api.pick_file(kind);
      return p || null;
    }
  } catch (e) { console.warn('原生文件对话框失败', e); }
  // 浏览器降级：隐藏 <input type=file>（浏览器内只能拿到文件名，无法解析，故提示）
  return await new Promise(resolve => {
    const inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = kind === 'txt' ? '.txt' : '.xlsx,.xls';
    inp.onchange = () => { resolve(inp.files[0] ? (inp.files[0].path || inp.files[0].name) : null); };
    inp.click();
  });
}
async function archiveWork(wid){
  const ok = await confirmDanger('归档这个作品？','归档后不再计入统计与专家贡献榜，可随时从「已归档」恢复。','归档');
  if (!ok) return;
  const r = await post('/api/works/'+wid+'/archive');
  if (r.ok){ showToast('已归档'); loadWorks(); } else showToast('⚠ '+(r.error||'失败'));
}
async function restoreWork(wid){
  const r = await post('/api/works/'+wid+'/restore');
  if (r.ok){ showToast('已恢复'); loadWorks(); } else showToast('⚠ '+(r.error||'失败'));
}
async function openWorkDetail(wid){
  const d = await fetch('/api/works/'+wid).then(r=>r.json());
  if (!d.ok){ showToast('⚠ 加载失败'); return; }
  const w=d.work, m=w.metrics||{};
  const adopts = (w.adoptions||[]).map(a =>
    '<div class="adopt-item'+(a.revoked?' revoked':'')+'">#'+a.no+' · '+esc(a.name)+'（'+esc(a.round)+'）'+(a.revoked?' <span class="muted">[已撤销]</span>':'')+'<br>'+esc(a.snippet||'')+(a.note?'<br><span class="muted">备注：'+esc(a.note)+'</span>':'')+'</div>'
  ).join('') || '<div class="muted">还没有采纳记录</div>';
  const scores = (w.scores&&w.scores.length) ? w.scores[w.scores.length-1].scores.map(s=>'<div>'+esc(s.name)+'：<b>'+fmtScore(s.score)+'</b>　'+esc((s.reason||'').slice(0,60))+'</div>').join('') : '<div class="muted">还没有评分</div>';
  const drawer=document.createElement('div');
  drawer.innerHTML = '<div class="drawer-mask"></div><div class="drawer">' +
    '<h3>'+esc(w.title||'未命名')+'</h3>' +
    '<div class="dmeta">'+esc(w.created_at||'')+' · <span class="badge-st st-'+esc(w.status)+'">'+esc(STATUS_LABELS[w.status]||w.status)+'</span></div>' +
    '<div class="sec"><div class="sec-t">📄 初稿</div><div class="box">'+esc(w.draft||'（空）')+'</div></div>' +
    (w.final ? '<div class="sec"><div class="sec-t">✅ 终稿</div><div class="box">'+esc(w.final)+'</div></div>' : '') +
    '<div class="sec"><div class="sec-t">🔄 版本对比</div><div class="ver-list">' +
      '<div class="ver-item"><div class="ver-hd"><span class="v-tag orig">原稿</span><span class="v-name">初稿</span><span class="v-time">'+esc((w.created_at||'').slice(0,10))+'</span></div><div class="ver-body">'+esc(w.draft||'（空）')+'</div></div>' +
      (w.final ? '<div class="ver-item"><div class="ver-hd"><span class="v-tag">终稿</span><span class="v-name">成稿</span><span class="v-time">'+esc((w.updated_at||'').slice(0,10))+'</span></div><div class="ver-body">'+esc(w.final)+'</div></div>' : '') +
      (w.adoptions||[]).filter(a=>!a.revoked).map(a =>
        '<div class="ver-item"><div class="ver-hd"><span class="v-tag adopt">采纳#'+a.no+'</span><span class="v-name">'+esc(a.name)+'</span><span class="v-time">'+esc((a.time||'').slice(0,10))+'</span></div><div class="ver-body">'+esc(a.snippet||'')+'</div></div>'
      ).join('') +
      (!(w.final||(w.adoptions||[]).length) ? '<div class="muted">还没有成稿/采纳，尚无版本可对比</div>' : '') +
    '</div></div>' +
    '<div class="sec"><div class="sec-t">👍 采纳记录（'+ (w.adoptions||[]).filter(a=>!a.revoked).length +'）</div>'+adopts+'</div>' +
    '<div class="sec"><div class="sec-t">⭐ 评分</div>'+scores+'</div>' +
    (w.review ? '<div class="sec"><div class="sec-t">📊 复盘结论</div><div class="box">实际分 '+fmtScore(w.review.actual_score)+'\n'+(w.review.summary||'')+'</div></div>' : '') +
    '<div class="sec"><div class="sec-t">📈 效果数据</div><div class="box">'+renderMetrics(m)+'</div></div>' +
    (w.retention ? '<div class="sec"><div class="sec-t">📉 留存曲线</div><div class="box">'+esc(w.retention)+'</div></div>' : '') +
    (w.subtitle ? '<div class="sec"><div class="sec-t">🎬 字幕稿（'+w.subtitle.length+' 字）</div><div class="box">'+esc(w.subtitle)+'</div></div>' : '') +
    '<div class="sec" id="dlRetentionSec"><div class="sec-t">🔍 数据专员分析</div><div class="box">'+(w.retention_report ? mdText(w.retention_report) : (w.analyzing ? '⏳ 阿数正在分析中…' : '（提交字幕稿后会自动分析）'))+'</div></div>' +
    '<div class="dbtns">' +
      '<button class="primary" id="dlGo">继续讨论</button>' +
      '<button id="dlRediscuss">重新讨论</button>' +
      '<button id="dlScore">⭐ 评分</button>' +
      '<button id="dlReview">📊 复盘</button>' +
      '<button id="dlRetention">📉 留存</button>' +
      '<button id="dlData">录入数据</button>' +
      (w.status!=='archived' ? '<button class="danger" id="dlArchive">归档</button>' : '<button id="dlRestore">恢复</button>') +
      '<button id="dlClose">关闭</button>' +
    '</div></div>';
  document.body.appendChild(drawer);
  const close=()=>drawer.remove();
  drawer.querySelector('.drawer-mask').addEventListener('click', close);
  drawer.querySelector('#dlClose').addEventListener('click', close);
  // 版本对比：点击头部展开/收起
  drawer.querySelectorAll('.ver-hd').forEach(hd => hd.addEventListener('click', ()=>{
    const body = hd.nextElementSibling;
    if (body) body.classList.toggle('hidden');
  }));
  drawer.querySelector('#dlGo').addEventListener('click', ()=>{ close(); continueDiscussion(w.id); });
  drawer.querySelector('#dlRediscuss').addEventListener('click', ()=>{ close(); rediscuss(w.id); });
  drawer.querySelector('#dlScore').addEventListener('click', ()=>{ close(); workQuickAction('score', w); });
  drawer.querySelector('#dlReview').addEventListener('click', ()=>{ close(); workQuickAction('review', w); });
  drawer.querySelector('#dlRetention').addEventListener('click', ()=>{ close(); workQuickAction('retention', w); });
  drawer.querySelector('#dlData').addEventListener('click', ()=>{ close(); enterMetrics(w.id); });
  const arc=drawer.querySelector('#dlArchive'), res=drawer.querySelector('#dlRestore');
  if (arc) arc.addEventListener('click', async ()=>{ close(); await archiveWork(w.id); });
  if (res) res.addEventListener('click', async ()=>{ close(); await restoreWork(w.id); });
  // 数据专员分析中 → 轮询直到出结果
  if (w.analyzing){
    const secBox = drawer.querySelector('#dlRetentionSec .box');
    const poll = setInterval(async ()=>{
      if (!secBox || !secBox.isConnected){ clearInterval(poll); return; }
      try{
        const nd = await fetch('/api/works/'+wid).then(r=>r.json());
        if (nd.ok && nd.work && !nd.work.analyzing){
          clearInterval(poll);
          secBox.innerHTML = nd.work.retention_report ? mdText(nd.work.retention_report) : '（分析完成，暂无报告）';
        }
      }catch(_){ clearInterval(poll); }
    }, 3000);
  }
}
function fmtScore(s){ return (s===null||s===undefined) ? '未给分' : Number(s).toFixed(1); }

async function workQuickAction(action, w){
  // 从作品详情页直接发起：⭐ 评分 / 📊 复盘 / 📉 留存分析
  const sid = w.session_id;
  if (sid && sid !== currentSid){
    try{
      const sd = await fetch('/api/session/'+sid).then(r=>r.json());
      if (sd.ok){ await restoreSession(sd); }
    }catch(_){}
  }
  if (!currentSid){ showToast('⚠ 这个作品还没有讨论会话，请先点「继续讨论」或「重新讨论」'); return; }
  currentWorkId = w.id;
  currentWorkTitle = w.title || '';
  switchView('chat');
  if (action === 'score'){
    const f = await openModal({ title:'⭐ 终稿评分', sub:'把最终发布的口播终稿贴进来，专家团队会匿名打分并给理由', fields:[{name:'content', label:'终稿', type:'textarea', rows:6, placeholder: w.final || '贴入终稿内容…'}], okText:'发送' });
    if (f && f.content) startScore(f.content);
  } else if (action === 'review'){
    const f = await openModal({ title:'📊 效果复盘', sub:'贴实际数据：播放量、完播率、点赞、评论、转化、发布时间等', fields:[{name:'content', label:'数据', type:'textarea', rows:6, placeholder:'例如：播放量 12.5w，完播率 8.6%，点赞 3200…'}], okText:'发送' });
    if (f && f.content) startReview(f.content);
  } else if (action === 'retention'){
    await startRetention();
  }
}
function renderMetrics(m){
  const rows=[
    ['播放量',m.plays],['完播率',m.completion!=null?m.completion+'%':null],
    ['2秒跳出率',m['2秒跳出率']!=null?m['2秒跳出率']+'%':null],
    ['5秒完播率',m['5秒完播率']!=null?m['5秒完播率']+'%':null],
    ['平均播放时长',m['平均播放时长']!=null?m['平均播放时长']+'秒':null],
    ['平均播放占比',m['平均播放占比']!=null?m['平均播放占比']+'%':null],
    ['点赞',m.likes],['评论',m.comments],['分享',m.shares],['收藏',m.saves||m.saved],
    ['涨粉量',m.followers!=null?m.followers:null],['涨粉率',m.followers_rate!=null?m.followers_rate+'%':null]
  ];
  return rows.filter(r=>r[1]!=null).map(r=>r[0]+'：<b>'+r[1]+'</b>').join('　') || '（暂无数据）';
}

/* ================= 数据复盘 ================= */
let currentPrinciples = [];

/* ================= 骨架库 ================= */
async function loadSkeletons(){
  const v=$('view-skeleton');
  v.innerHTML='<div class="empty">加载中…</div>';
  try{
    const d = await fetch('/api/skeletons').then(r=>r.json());
    if(!d.ok) throw new Error(d.error||'加载失败');
    const templates = d.templates||[];
    v.innerHTML =
      '<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">'+
        '<h2 style="font-size:18px;font-weight:600;margin:0">🦴 文案骨架库</h2>'+
        '<span style="font-size:13px;color:var(--c-text-sub)">'+templates.length+' 套模板</span>'+
        '<button id="btnAddSkeleton" style="margin-left:auto;background:var(--primary);color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:13px;cursor:pointer">+ 新增模板</button>'+
      '</div>'+
      '<div id="skeletonList" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px"></div>';
    const list=$('skeletonList');
    if(!templates.length){
      list.innerHTML='<div class="empty">暂无模板，点击右上角新增</div>';
    } else {
      templates.forEach(t=>{
        const card=document.createElement('div');
        card.style.cssText='background:var(--c-card);border:1px solid #e8e8e8;border-radius:12px;padding:16px;';
        card.innerHTML=
          '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'+
            '<span style="font-size:15px;font-weight:600">'+esc(t.name)+'</span>'+
            '<span style="font-size:11px;color:var(--c-text-sub);background:var(--c-bg-soft);border-radius:4px;padding:2px 6px">'+esc(t.scene||'')+'</span>'+
            '<span style="font-size:11px;color:var(--c-text-sub);background:var(--c-bg-soft);border-radius:4px;padding:2px 6px">'+esc(t.structure_type||'')+'</span>'+
          '</div>'+
          '<div style="font-size:12px;color:var(--c-text-sub);line-height:1.6;margin-bottom:6px"><b>配比:</b> '+esc(t.core_structure||'')+'</div>'+
          '<div style="font-size:12px;color:var(--c-text-sub);line-height:1.6;margin-bottom:6px"><b>情绪:</b> '+esc(t.emotion_curve||'')+'</div>'+
          '<div style="font-size:12px;color:var(--c-text-sub);line-height:1.6;margin-bottom:6px"><b>钩子:</b> '+esc(t.hook_types||'')+'</div>'+
          '<div style="font-size:12px;color:var(--c-text-sub);line-height:1.6;margin-bottom:6px"><b>促动:</b> '+esc(t.cta_positions||'')+'</div>'+
          (t.variation_rules?'<div style="font-size:12px;color:var(--c-text-sub);line-height:1.6;margin-bottom:6px"><b>变奏:</b> '+esc(t.variation_rules)+'</div>':'')+
          (t.case_example?'<div style="font-size:12px;color:var(--c-text-mute);line-height:1.6;margin-bottom:6px"><b>案例:</b> '+esc(t.case_example)+'</div>':'')+
          (t.effect_feedback?'<div style="font-size:12px;color:var(--primary);line-height:1.6;margin-bottom:6px"><b>效果回填:</b> '+esc(t.effect_feedback)+'</div>':'')+
          '<div style="display:flex;gap:6px;margin-top:8px">'+
            '<button class="sk-edit" data-id="'+t.id+'" style="border:1px solid var(--c-border);background:var(--c-card);border-radius:4px;padding:3px 10px;font-size:12px;cursor:pointer;color:var(--c-text-sub)">编辑</button>'+
            '<button class="sk-del" data-id="'+t.id+'" style="border:1px solid #f0c0c8;background:var(--c-card);border-radius:4px;padding:3px 10px;font-size:12px;cursor:pointer;color:#e8576a">删除</button>'+
          '</div>';
        list.appendChild(card);
      });
      list.querySelectorAll('.sk-del').forEach(btn=>{
        btn.onclick=async()=>{
          if(!confirm('确定删除此模板？')) return;
          const r=await fetch('/api/skeletons/'+btn.dataset.id,{method:'DELETE'}).then(r=>r.json());
          if(r.ok) loadSkeletons(); else showToast(r.error||'删除失败');
        };
      });
      list.querySelectorAll('.sk-edit').forEach(btn=>{
        btn.onclick=()=>openSkeletonEditor(btn.dataset.id, templates);
      });
    }
    $('btnAddSkeleton').onclick=()=>openSkeletonEditor(null, templates);
  }catch(e){ v.innerHTML='<div class="empty">加载失败: '+esc(e.message)+'</div>'; }
}
async function openSkeletonEditor(tid, templates){
  const t = tid ? templates.find(x=>x.id===tid) : {};
  const fields=[
    {name:'name',label:'模板名称',type:'text',value:t.name||'',placeholder:'如：痛点共鸣型'},
    {name:'scene',label:'适用场景',type:'text',value:t.scene||'',placeholder:'情感/事业/避坑/干货...'},
    {name:'structure_type',label:'结构类型',type:'text',value:t.structure_type||'',placeholder:'痛点型/案例型/反差型...'},
    {name:'core_structure',label:'核心结构配比',type:'text',value:t.core_structure||'',placeholder:'钩子(15%) → 痛点(30%) → ...'},
    {name:'emotion_curve',label:'情绪曲线',type:'text',value:t.emotion_curve||'',placeholder:'刺痛→共鸣→好奇→释然→行动'},
    {name:'hook_types',label:'钩子类型',type:'text',value:t.hook_types||'',placeholder:'人群拦截型/灵魂拷问型'},
    {name:'cta_positions',label:'促动按钮位置',type:'text',value:t.cta_positions||'',placeholder:'结尾CTA+评论互动钩子'},
    {name:'variation_rules',label:'变奏规则',type:'text',value:t.variation_rules||'',placeholder:'什么情况怎么改'},
    {name:'case_example',label:'实战案例',type:'textarea',value:t.case_example||'',placeholder:'案例描述...'},
    {name:'compliance_level',label:'合规等级',type:'text',value:t.compliance_level||'',placeholder:'弱承诺+强共鸣 / 数据需核查'},
  ];
  const f=await openModal({title:tid?'编辑骨架模板':'新增骨架模板',sub:'填写模板信息，保存后自动入库',fields,okText:'保存'});
  if(!f) return;
  const body={...f};
  // 清理空值
  Object.keys(body).forEach(k=>{ if(!body[k]) delete body[k]; });
  try{
    let r;
    if(tid){
      r=await fetch('/api/skeletons/'+tid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>r.json());
    } else {
      r=await post('/api/skeletons',body);
    }
    if(r.ok){ showToast('保存成功'); loadSkeletons(); }
    else showToast(r.error||'保存失败');
  }catch(e){ showToast('保存失败：'+e); }
}

/* ================= 数据复盘 ================= */
async function loadStats(){
  const v=$('view-stats');
  v.innerHTML='<div class="empty">加载中…</div>';
  try{
    const [wres, ores, ires, lres] = await Promise.all([
      fetch('/api/works').then(r=>r.json()),
      fetch('/api/overview').then(r=>r.json()),
      fetch('/api/insights').then(r=>r.json()).catch(()=>({ok:false})),
      fetch('/api/leaderboard').then(r=>r.json()).catch(()=>({ok:false}))
    ]);
    if (!wres.ok || !ores.ok) throw new Error('加载失败');
    const works = (wres.works||[]).filter(w=>w.status!=='archived');
    const rows = works.map(w=>{
      const m=w.metrics||{};
      return '<tr>' +
        '<td>'+esc(w.title||'未命名')+'</td>' +
        '<td><span class="badge-st st-'+esc(w.status)+'">'+esc(STATUS_LABELS[w.status]||w.status)+'</span></td>' +
        '<td class="num">'+(m.plays!=null?fmtNum(m.plays):'—')+'</td>' +
        '<td class="num">'+(m.completion!=null?m.completion+'%':'—')+'</td>' +
        '<td class="num">'+(m.likes!=null?fmtNum(m.likes):'—')+'</td>' +
        '<td class="num">'+ (w.adoptions||[]).filter(a=>!a.revoked).length +'</td>' +
        '<td class="num">'+avgScore(w.scores)+'</td></tr>';
    }).join('') || '<tr><td colspan="7" class="empty">还没有已发布的作品</td></tr>';
    const exps = (ores.experts||[]).map((e,i)=>{
      const barW = ores.experts.length ? Math.max(6, Math.round(e.adopted / Math.max(1,ores.experts[0].adopted) * 100)) : 6;
      return '<div class="expert-row"><span class="avatar" style="background:'+colorOf(e.name)+'">'+esc(e.name[0])+'</span>' +
        '<div><div class="ename">'+esc(e.name)+(i===0?' 🥇':'')+'</div><div class="einfo">被采纳 '+e.adopted+' 次 · 涉及 '+e.works+' 个作品</div></div>' +
        '<div class="right"><div class="muted">'+(e.avg_plays?'均播 '+fmtNum(e.avg_plays):'')+'</div>'+(e.avg_completion?'<div class="muted">完播 '+e.avg_completion+'%</div>':'')+'</div>' +
        '<div style="width:90px;background:var(--c-bg-soft);border-radius:4px;height:8px;margin-left:8px"><div style="width:'+barW+'%;height:8px;background:var(--primary);border-radius:4px"></div></div></div>';
    }).join('') || '<div class="empty">采纳数据会显示在这里</div>';

    // 数据洞察：黑榜 + 原则建议（区分建议性/禁止性）+ 待处置建议
    const bl = (ires.ok && ires.blacklist) ? ires.blacklist : [];
    const pr = (ires.ok && ires.principles) ? ires.principles : [];
    currentPrinciples = pr;
    const pa = (ires.ok && ires.pending_actions) ? ires.pending_actions : [];
    const blHtml = bl.length ? bl.slice(-15).reverse().map((it,i)=>{
      const agent = it.agent ? '<span class="badge-st" style="background:var(--c-bg-soft);color:#b91c1c">'+esc(it.agent)+'</span>' : '';
      return '<div class="insight-item"><div class="ih">'+esc(it.sentence)+(it.reason?'<div class="muted">'+esc(it.reason)+'</div>':'')+'</div>'+agent+'</div>';
    }).join('') : '<div class="empty">暂无黑榜，先做一次「留存分析」</div>';
    let prSuggestHtml = '', prForbidHtml = '';
    if (pr.length) {
      pr.forEach((p, idx)=>{
        const hits = p.hits||0;
        const ver = p.version||1;
        const stale = hits===0 && ver>1 ? ' stale' : '';
        const staleTip = hits===0 && ver>1 ? ' <span class="pr-stale-tip" title="多次迭代仍无命中，建议审视是否已过时">⏳ 待观察</span>' : '';
        const item = '<div class="insight-item principle '+(p.kind==='forbid'?'forbid':'')+stale+'" data-pi="'+idx+'">' +
          '<div class="ih">'+esc(p.text)+staleTip+'</div>' +
          '<div class="pr-meta"><span class="pr-hits" title="产出内容命中该原则的次数（命中率依据）">📌 命中 '+hits+' 次</span>' +
          (ver>1 ? '<span class="pr-ver" title="该原则被修订过的版本数">v'+ver+'</span>' : '') +
          '<span class="pr-date">'+esc((p.date||'').slice(0,10))+'</span></div>' +
          '<div class="pr-item-btns">' +
            '<button class="pr-edit" data-pi="'+idx+'">编辑</button>' +
            '<button class="pr-del" data-pi="'+idx+'">删除</button>' +
          '</div>' +
        '</div>';
        if (p.kind==='forbid') prForbidHtml += item; else prSuggestHtml += item;
      });
    }
    if (!prSuggestHtml) prSuggestHtml = '<div class="empty">暂无建议性原则</div>';
    if (!prForbidHtml) prForbidHtml = '<div class="empty">暂无禁止性原则</div>';
    const paHtml = pa.length ? ('<div class="pr-sec"><b>🔧 待处置建议（原则审视产出，确认后一键替换）</b></div>' +
      pa.map((a,i)=>{
        const isFix = a.action==='fix';
        return '<div class="insight-item pa-item" data-i="'+i+'">' +
          '<div class="ih">'+(isFix?'✏️ 修正：':'🗑️ 废除：')+'<b>'+esc(a.old_text)+'</b>' +
          (isFix ? '<div class="muted">→ 改为：'+esc(a.new_text)+'</div>' : '') + '</div>' +
          '<div class="pa-btns"><button class="pa-apply" data-i="'+i+'">应用</button><button class="pa-dismiss" data-i="'+i+'">忽略</button></div>' +
        '</div>';
      }).join('')) : '';

    // 数据榜单
    const lb = (lres.ok && lres.leaderboard) ? lres.leaderboard : {};
    const mw = (lres.ok && lres.metrics_works!=null) ? lres.metrics_works : 0;
    const lbHint = mw < 3 ? '<div class="lb-hint">⚠ 数据还不够：已有 <b>'+mw+'</b>/3 个作品录入指标，再做 <b>'+(3-mw)+'</b> 次留存分析即可出榜单</div>' : '';
    const lbRows = Object.keys(lb).map(k=>{
      const m = lb[k];
      const top = m.top ? '<span class="lb-top">🏆 '+esc(m.top.title)+' '+esc(m.top.raw)+m.unit+'</span>' : '<span class="muted">—</span>';
      const bottom = m.bottom ? '<span class="lb-bottom">💀 '+esc(m.bottom.title)+' '+esc(m.bottom.raw)+m.unit+'</span>' : '<span class="muted">—</span>';
      return '<div class="lb-row"><div class="lb-name">'+esc(m.label)+'</div><div>'+top+'</div><div>'+bottom+'</div></div>';
    }).join('') || '<div class="empty">暂无数据，先做「留存分析」录入指标</div>';
    const lbHtml = lbHint + '<div class="lb-head"><span>指标</span><span>top1</span><span>垫底</span></div>'+lbRows +
      '<div class="lb-actions"><button class="hm-save" id="lbTopBtn">🏆 讨论 top1（出建议性）</button><button class="hm-comment-all" id="lbBottomBtn">💀 讨论垫底（出禁止性）</button><button class="hm-reset" id="lbReviewBtn">🔍 原则审视</button></div>';

    v.innerHTML =
      '<div class="stat-grid">' +
        statCard((ores.counts||{}).total||0, '作品总数', '') +
        statCard(((ores.counts||{}).by_status||{}).discussing||0, '讨论中', 'blue') +
        statCard(((ores.counts||{}).by_status||{}).to_adopt||0, '待采纳', 'orange') +
        statCard(((ores.counts||{}).by_status||{}).reviewed||0, '已复盘', 'purple') +
        statCard((ores.counts||{}).adopt_total||0, '累计采纳', 'green') +
      '</div>' +
      '<div class="sec-title">📋 作品效果</div>' +
      '<div class="panel"><div class="table-wrap"><table class="wtable"><thead><tr><th>作品</th><th>状态</th><th class="num">播放</th><th class="num">完播</th><th class="num">点赞</th><th class="num">采纳</th><th class="num">评分</th></tr></thead><tbody>'+rows+'</tbody></table></div></div>' +
      '<div class="sec-title">🏆 专家表现</div>' +
      '<div class="stats-grid">' +
        '<div class="panel"><div class="card-title">🏆 专家贡献榜</div>'+exps+'</div>' +
        '<div class="panel"><div class="card-title">📈 正确率排名</div><div class="box" style="background:var(--c-bg-soft);border-radius:8px;padding:10px 12px;font-size:13px;line-height:2">'+mdText(ores.rank_text)+'</div>' +
        '<div class="card-title" style="margin-top:16px">🎯 评分准确性</div><div class="box" style="background:var(--c-bg-soft);border-radius:8px;padding:10px 12px;font-size:13px;line-height:2">'+mdText(ores.score_accuracy)+'</div></div>' +
      '</div>' +
      '<div class="sec-title">🖤 数据洞察</div>' +
      '<div class="stats-grid">' +
        '<div class="panel"><div class="card-title">🖤 句子级黑榜 <span class="muted">留存流失最严重，数据专员判定</span></div>'+blHtml+'</div>' +
        '<div class="panel"><div class="card-title">📜 全部原则 <span class="muted">专家产出前必过</span><button class="pr-add" id="prAddBtn">＋ 原则修订</button></div>'+paHtml+'<div class="pr-sec">✅ 建议性原则</div>'+prSuggestHtml+'<div class="pr-sec">🚫 禁止性原则</div>'+prForbidHtml+'</div>' +
      '</div>' +
      '<div class="sec-title">📊 数据榜单</div>' +
      '<div class="panel">'+lbHtml+'</div>';

    // 榜单讨论按钮
    const topBtn = $('lbTopBtn'), botBtn = $('lbBottomBtn'), revBtn = $('lbReviewBtn');
    if (topBtn) topBtn.addEventListener('click', ()=> leaderboardDebate('top'));
    if (botBtn) botBtn.addEventListener('click', ()=> leaderboardDebate('bottom'));
    if (revBtn) revBtn.addEventListener('click', ()=> principleReview());
    // 待处置建议：应用/忽略
    v.querySelectorAll('.pa-apply').forEach(b=>b.addEventListener('click', ()=> applyPendingAction(parseInt(b.dataset.i), 'apply')));
    v.querySelectorAll('.pa-dismiss').forEach(b=>b.addEventListener('click', ()=> applyPendingAction(parseInt(b.dataset.i), 'dismiss')));
    // 原则操作：新增/编辑/删除
    const prAddBtn = $('prAddBtn');
    if (prAddBtn) prAddBtn.addEventListener('click', ()=> openPrincipleEditor());
    v.querySelectorAll('.pr-edit').forEach(b=>b.addEventListener('click', ()=>{
      const idx = parseInt(b.dataset.pi);
      const p = currentPrinciples[idx];
      if (p) openPrincipleEditor(idx, p.text, p.kind);
    }));
    v.querySelectorAll('.pr-del').forEach(b=>b.addEventListener('click', ()=> deletePrinciple(parseInt(b.dataset.pi))));
  }catch(e){ v.innerHTML='<div class="empty">数据加载失败：'+esc(e.message)+'</div>'; }
}
async function applyPendingAction(index, action){
  const r = await post('/api/principles/apply', { index, action });
  if (r.ok){
    showToast(action==='apply' ? (r.result==='removed'?'已废除旧原则':'已替换旧原则') : '已忽略');
  } else {
    showToast('⚠ '+(r.error||'操作失败'));
  }
  loadStats();
}
async function openPrincipleEditor(index=null, text='', kind='suggest'){
  const isEdit = index !== null;
  const res = await openModal({
    title: '原则修订',
    sub: isEdit ? '修改后会更新原则的日期' : '新增一条原则，保存后立即对所有专家生效',
    okText: '保存',
    fields: [
      {name:'text', label:'原则内容', type:'textarea', rows:4, value:text, placeholder:'例如：开头 3 秒必须给出明确痛点'},
      {name:'kind', label:'类型', type:'radio', value:kind, options:[{value:'suggest',label:'建议性'},{value:'forbid',label:'禁止性'}]}
    ]
  });
  if (!res) return;
  const k = (res.kind || 'suggest').trim();
  if (k !== 'suggest' && k !== 'forbid') { showToast('请选择类型'); return; }
  await savePrinciple(isEdit ? index : null, res.text, k);
}
async function savePrinciple(index, text, kind){
  if (!text || !text.trim()) { showToast('原则内容不能为空'); return; }
  let r;
  if (index === null) {
    r = await post('/api/insights/principles', {text, kind});
  } else {
    r = await fetch('/api/insights/principles/'+index, {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({text, kind})}).then(x=>x.json());
  }
  if (r.ok){ showToast(index===null?'已新增原则':'已保存'); loadStats(); }
  else showToast('⚠ '+(r.error||'保存失败'));
}
async function deletePrinciple(index){
  const p = currentPrinciples[index];
  if (!p) return;
  const ok = await confirmDanger('删除原则？', '确定删除：'+p.text.substring(0,60)+(p.text.length>60?'...':''), '删除');
  if (!ok) return;
  const r = await fetch('/api/insights/principles/'+index, {method:'DELETE'}).then(x=>x.json());
  if (r.ok){ showToast('已删除'); loadStats(); }
  else showToast('⚠ '+(r.error||'删除失败'));
}
function mdText(t){
  // 极简 markdown：加粗 + 换行
  return esc(t||'（暂无）').replace(/\*\*(.+?)\*\*/g,'<b>$1</b>').replace(/\n/g,'<br>');
}
async function pickWorkForSession(){
  // 有活跃会话直接用；没有则从作品库选一篇发起讨论，返回可用 sid
  if (currentSid) return currentSid;
  let ws = [];
  try {
    const d = await fetch('/api/works').then(r=>r.json());
    ws = (d.works || []).filter(w => w.draft);
  } catch(_){}
  if (!ws.length) { showToast('当前没有活跃会话，也没有可讨论的作品。请先新建文稿发起讨论'); switchView('chat'); return null; }
  const f = await openModal({
    title: '📁 选择要讨论的作品',
    sub: '当前没有活跃会话。从作品库选一篇作品，将用它的初稿发起新的讨论，再进行' + '后续操作。',
    fields: [{ name:'wid', label:'作品', type:'radio', options: ws.slice(0,8).map(w=>({label:w.title||w.id, value:w.id})), value: ws[0].id }],
    okText: '发起讨论并继续'
  });
  if (!f || !f.wid) return null;
  const w = ws.find(x=>x.id===f.wid);
  if (!w) return null;
  const r = await post('/api/start', { script:w.draft, title:w.title });
  if (!r.ok) { showToast('⚠ ' + (r.error||'发起讨论失败')); return null; }
  bindSession(r.sid, r.work_id, r.work_title);
  switchView('chat');
  startDiscussionLocal(w.draft);
  return r.sid;
}
async function leaderboardDebate(mode){
  const sid = await pickWorkForSession();
  if (!sid) return;
  const label = mode==='top' ? '榜单 top1（建议性原则）' : '榜单垫底（禁止性原则）';
  const ok = await confirmDanger('发起'+label+'讨论？','全员（专家+骨架师+数据专员）会讨论这些作品数据特别'+ (mode==='top'?'好':'差') +'的原因，投票后提炼成'+(mode==='top'?'建议性':'禁止性')+'原则。','开始讨论');
  if (!ok) return;
  addSys('📊 已发起'+label+'讨论，回到群聊查看…');
  switchView('chat');
  setBusy(true);
  post('/api/leaderboard_debate', { sid, mode }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'榜单讨论失败')); setBusy(false); return; }
    openStream();
  }).catch(err=>{ addSys('⚠ 榜单讨论失败: '+err.message); setBusy(false); });
}
async function principleReview(){
  const sid = await pickWorkForSession();
  if (!sid) return;
  const f = await openModal({
    title:'🔍 原则审视',
    sub:'哪篇文案打破了已有原则？（例如遵守了建议性原则却扑街、或违反了禁止性原则却爆了）贴入你的说明，全员会分析是原则错了还是别的原因，产出报告给你。',
    fields:[{name:'note', label:'打破原则的情况说明', type:'textarea', rows:5, placeholder:'例如：第3条建议说开头要抛钩子，但我照做了反而掉留存，是不是这条原则错了？'}],
    okText:'发起审视'
  });
  if (!f) return;
  addSys('🔍 已发起原则审视，回到群聊查看分析报告…');
  switchView('chat');
  setBusy(true);
  post('/api/principle_review', { sid, note:(f.note||'').trim() }).then(d=>{
    if (!d.ok){ addSys('⚠ '+(d.error||'原则审视失败')); setBusy(false); return; }
    openStream();
  }).catch(err=>{ addSys('⚠ 原则审视失败: '+err.message); setBusy(false); });
}

/* ================= 学习档案 ================= */
async function loadLearnings(){
  const v=$('view-learn');
  v.innerHTML='<div class="empty">加载中…</div>';
  try{
    const d = await fetch('/api/learnings').then(r=>r.json());
    if (!d.ok) throw new Error(d.error||'加载失败');
    const exps = d.experts||[];
    const total = exps.reduce((a,e)=>a+e.count,0);
    const tabs = exps.map((e,i)=>
      '<button class="chip'+(i===0?' active':'')+'" data-i="'+i+'">'+esc(e.name)+' <span class="muted">('+e.count+')</span></button>').join('');
    const panels = exps.map((e,i)=>{
      const items = e.items.map(it=>'<div class="learn-item"><div class="lh">📅 '+esc(it.date)+' · 吸收 #'+it.no+'</div>'+mdText(it.text)+'</div>').join('') ||
        '<div class="empty">'+esc(e.name)+' 还没有吸收记录</div>';
      return '<div class="learn-pane'+(i===0?'':' hidden')+'" data-p="'+i+'">'+items+'</div>';
    }).join('');
    v.innerHTML =
      '<div class="learn-hero">' +
        '<div class="lh-txt"><div class="lh-title">🧨 想学新爆款？贴一篇过来拆解</div>' +
        '<div class="lh-desc">专家们会先一起分析这篇文案为什么爆、投票提炼成原则，再各自把欠缺的知识点吸收进档案。</div></div>' +
        '<button class="btn-primary" id="learnTeardownBtn">🧨 拆解一篇爆款文案</button>' +
      '</div>' +
      '<div class="panel"><div class="card-title">🧠 学习档案 <span class="muted">共 '+total+' 条知识点</span>' +
      '<button id="learnManualBtn" style="margin-left:auto;border:1px solid var(--c-border);background:var(--c-card);border-radius:8px;padding:5px 12px;font-size:12px;cursor:pointer;color:var(--c-text-sub)">➕ 手动新增</button></div>' +
      '<div class="learn-tabs">'+tabs+'</div>'+panels+'</div>';
    $('learnTeardownBtn').addEventListener('click', ()=> startViralTeardown());
    $('learnManualBtn').addEventListener('click', openManualLesson);
    v.querySelectorAll('.chip').forEach(c=>c.addEventListener('click', ()=>{
      const i=c.dataset.i;
      v.querySelectorAll('.chip').forEach(x=>x.classList.toggle('active', x===c));
      v.querySelectorAll('.learn-pane').forEach(p=>p.classList.toggle('hidden', p.dataset.p!==i));
    }));
  }catch(e){ v.innerHTML='<div class="empty">加载失败：'+esc(e.message)+'</div>'; }
}
async function openManualLesson(){
  const f = await openModal({
    title:'➕ 手动新增学习条目',
    sub:'把你自己总结的文案经验直接补充到某位专家的档案里（下次讨论会自动注入该专家的提示词）。提供「原文摘录+原文」时会做逐字校验，防止抄错。',
    fields:[
      {name:'agent', label:'专家', type:'radio', options:(window.__MEMBERS||[]).map(m=>({label:m.name, value:m.name}))},
      {name:'point', label:'🧠 知识点', type:'textarea', rows:3, placeholder:'例如：口播前 3 秒必须抛出具体数字或反常识结论，否则跳出率会明显上升'},
      {name:'apply', label:'✍️ 应用方法（可选）', type:'textarea', rows:2, placeholder:'例如：写开头时先列 3 个具体数字候选，选冲击力最强的'},
      {name:'quote', label:'📌 原文摘录（可选）', type:'textarea', rows:2, placeholder:'如果这段经验来自某篇爆款，贴出原文句子'},
      {name:'source', label:'📄 原文出处（可选）', type:'textarea', rows:2, placeholder:'贴出包含上面摘录的原文全文，用于校验'},
    ],
    okText:'保存到档案'
  });
  if (!f) return;
  const agent = (window.__MEMBERS||[]).find(m=>m.name===f.agent);
  const d = await post('/api/learnings/manual', {
    agent_id: agent ? agent.id : f.agent,
    point: f.point || '', apply: f.apply || '', quote: f.quote || '', source: f.source || '',
  });
  if (!d.ok){ showToast('⚠ '+(d.error||'保存失败')); return; }
  showToast('✅ 已写入 ' + f.agent + ' 的学习档案');
  loadLearnings();
}

/* ================= 设置 ================= */
async function loadSettings(){
  const v=$('view-settings');
  let ctxText='（加载中…）';
  let dataPath='（读取中…）';
  try{ const d=await fetch('/api/context').then(r=>r.json()); const c=d.context||{};
    ctxText = (c.user_identity?('账号定位：'+c.user_identity+'<br>'):'') + (c.target_audience?('目标受众：'+c.target_audience):'');
  }catch(_){}
  try{ const st=await fetch('/api/status').then(r=>r.json()); if (st.ok) dataPath = st.data_dir; }catch(_){}
  v.innerHTML = '<div class="set-card panel">' +
    '<div class="card-title">⚙️ 设置</div>' +
    '<div class="set-row"><div><div class="lbl">创作背景</div><div class="desc" id="setCtx" style="line-height:1.7">' + ctxText + '</div></div>' +
      '<button class="btn-ghost" id="editCtx">✏️ 在线编辑</button></div>' +
    '<div class="set-row"><div><div class="lbl">数据存放</div><div class="desc" style="word-break:break-all">统计、作品库、学习档案都保存在数据目录下，不会随程序更新丢失<br><code style="font-size:11px;color:var(--c-text-sub);background:var(--c-bg-soft);padding:2px 6px;border-radius:4px;display:inline-block;margin-top:4px">' + esc(dataPath) + '</code></div></div></div>' +
    '<div class="set-row"><div><div class="lbl">通知中心</div><div class="desc">采纳、复盘、留存分析、洗稿保存等关键事件都会在这里提醒，未读红点显示在右上角铃铛</div></div>' +
      '<button class="btn-ghost" id="clearNotify">清空通知</button></div>' +
    '<div class="set-row"><div><div class="lbl">快捷操作</div><div class="desc">群聊输入框支持 Ctrl+Enter 发送；采纳后 6 秒内可撤销；作品库支持勾选批量归档</div></div></div>' +
    '<div class="danger-zone"><div class="dz-t">⚠️ 危险操作区（所有操作需输入 DELETE 确认，且不可恢复）</div>' +
      '<div class="set-row"><div><div class="lbl">清空统计与反馈档案</div><div class="desc">删除 stats.json：专家正确率、评分准确性、正负反馈全部清空</div></div><button class="btn-ghost" id="wipeStats" style="color:#e8576a;border-color:#e8576a">清空统计</button></div>' +
      '<div class="set-row"><div><div class="lbl">清空学习档案</div><div class="desc">删除 lessons/ 下所有专家吸收的知识点</div></div><button class="btn-ghost" id="wipeLessons" style="color:#e8576a;border-color:#e8576a">清空学习</button></div>' +
      '<div class="set-row"><div><div class="lbl">清空作品库</div><div class="desc">删除全部作品、采纳、评分、复盘数据</div></div><button class="btn-ghost" id="wipeWorks" style="color:#e8576a;border-color:#e8576a">清空作品</button></div>' +
    '</div></div>';
  $('wipeStats').addEventListener('click', ()=>wipeConfirm('stats','清空统计','专家正确率、评分准确性、正负反馈将被永久删除'));
  $('wipeLessons').addEventListener('click', ()=>wipeConfirm('lessons','清空学习档案','所有专家吸收的知识点将被永久删除'));
  $('wipeWorks').addEventListener('click', ()=>wipeConfirm('works','清空作品库','全部作品、采纳、评分、复盘数据将被永久删除'));
  $('editCtx').addEventListener('click', editContext);
  const clr=$('clearNotify');
  if (clr) clr.addEventListener('click', async ()=>{
    const r = await post('/api/notifications/clear');
    if (r.ok){ showToast('已清空通知'); loadNotifications(); } else showToast('⚠ '+(r.error||'清空失败'));
  });
}
async function editContext(){
  let c = {};
  try{ const d = await fetch('/api/context').then(r=>r.json()); c = d.context || {}; }catch(_){}
  const f = await openModal({
    title: '✏️ 编辑创作背景',
    sub: '这些信息会注入每位专家的上下文，让产出更贴合你的账号定位。保存后即时生效，无需重启。',
    fields: [
      { name:'user_identity', label:'账号定位', type:'textarea', rows:3, value:c.user_identity||'', placeholder:'例如：情感/玄学赛道口播，25-40 岁女性为主，风格猎奇但不说教' },
      { name:'target_audience', label:'目标受众', type:'textarea', rows:3, value:c.target_audience||'', placeholder:'例如：对八字/星座感兴趣的 25-40 岁女性，喜欢强结论、短句、案例驱动' },
      { name:'track', label:'赛道', type:'text', value:c.track||'', placeholder:'例如：情感、玄学、职场' },
    ],
    okText: '保存'
  });
  if (!f) return;
  const r = await fetch('/api/context', {
    method:'PUT', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ user_identity:(f.user_identity||'').trim(), target_audience:(f.target_audience||'').trim(), track:(f.track||'').trim() })
  }).then(safeJson).catch(e=>({ok:false, error:'网络错误：'+e.message}));
  if (r.ok){ showToast('✅ 创作背景已更新，全员即时生效'); loadSettings(); if (typeof loadCtxbar === 'function') loadCtxbar(); }
  else showToast('⚠ ' + (r.error || '保存失败'));
}
async function wipeConfirm(kind, title, desc){
  const f = await openModal({ title:'⚠️ '+title, sub:desc+'<br>请输入 DELETE 确认：', fields:[{name:'confirm',label:'确认',type:'text',placeholder:'DELETE'}], okText:'确认清空', danger:true });
  if (!f) return;
  if (f.confirm !== 'DELETE'){ showToast('输入不对，已取消'); return; }
  const r = await post('/api/wipe', { kind, confirm:'DELETE' });
  if (r.ok){ showToast('已清空'); loadSettings(); if(currentView==='home') loadOverview(); }
  else showToast('⚠ '+(r.error||'清空失败'));
}

/* ================= 对标监控 ================= */
let monitorPollTimer = null;

async function loadMonitor() {
  const v = $('view-monitor');
  v.innerHTML =
    '<div class="card" style="margin-bottom:14px">' +
      '<div class="card-title">📡 对标账号监控</div>' +
      '<div class="mon-add">' +
        '<input id="monUrl" placeholder="粘贴抖音主页链接（必填）" />' +
        '<input id="monNote" placeholder="备注名（如：情感赛道对标）" style="flex:0 1 200px" />' +
        '<input id="monDyId" placeholder="抖音号（选填）" style="flex:0 1 140px" />' +
        '<button class="btn-primary" id="monAdd">＋ 添加</button>' +
        '<button class="btn-primary" id="monFetch" style="background:#0ea5e9">⚡ 立即抓取</button>' +
      '</div>' +
      '<div class="muted" style="font-size:12px;color:var(--c-text-mute)">监控范围：每个账号近 10 条视频 → 按点赞排序出高赞榜；自动做两层去重（搬运视频合并 + 同选题撞车检测）。首次使用请先在 Chrome/Edge 登录过抖音（自动读取 cookie）。</div>' +
      '<div class="mon-progress" id="monProgressWrap" style="display:none"><div class="bar" id="monProgressBar"></div></div>' +
      '<div class="muted" id="monProgressText" style="font-size:12px;color:var(--primary)"></div>' +
    '</div>' +
    '<div class="card" style="margin-bottom:14px">' +
      '<div class="card-title">👥 监控账号（<span id="monAccCount">0</span>）</div>' +
      '<div id="monAccList"><div class="empty">还没有添加对标账号，先在上方粘贴主页链接</div></div>' +
    '</div>' +
    '<div id="monReport"></div>';
  $('monAdd').addEventListener('click', monAddAccount);
  $('monFetch').addEventListener('click', monStartFetch);
  $('monUrl').addEventListener('keydown', e => { if (e.key === 'Enter') monAddAccount(); });
  await monLoadAccounts();
  await monLoadReport();
  // 切回本页时恢复仍在运行的抓取任务状态（防重复触发、进度不丢失）
  try {
    const st = await fetch('/api/monitor/status').then(r => r.json());
    const s = st.state || {};
    if (s.running) {
      $('monFetch').disabled = true;
      $('monProgressWrap').style.display = 'block';
      const p = s.progress || {};
      $('monProgressBar').style.width = (p.total ? Math.round(p.done / p.total * 100) : 0) + '%';
      $('monProgressText').textContent = '抓取中 ' + (p.done||0) + '/' + (p.total||0) + (p.current ? ' · 正在处理「' + p.current + '」' : '');
      monPollStatus();
    }
  } catch (_) {}
}

async function monLoadAccounts() {
  try {
    const d = await fetch('/api/monitor/accounts').then(r => r.json());
    if (!d.ok) throw new Error(d.error || '加载失败');
    const list = d.accounts || [];
    $('monAccCount').textContent = list.length;
    if (!list.length) {
      $('monAccList').innerHTML = '<div class="empty">还没有添加对标账号，先在上方粘贴主页链接</div>';
      return;
    }
    $('monAccList').innerHTML = list.map(a => {
      const name = a.note || '未命名账号';
      return '<div class="mon-acc">' +
        '<span class="avatar" style="background:#0ea5e9">' + esc(name[0] || '？') + '</span>' +
        '<div class="info"><div class="nm">' + esc(name) + '</div>' +
        '<div class="sub">' + esc(a.home_url || '') + (a.douyin_id ? ' · 抖音号 ' + esc(a.douyin_id) : '') + '</div></div>' +
        '<button class="del" data-id="' + a.id + '" title="移除">✕</button></div>';
    }).join('');
    $('monAccList').querySelectorAll('.del').forEach(b => b.addEventListener('click', () => monRemoveAccount(b.dataset.id)));
  } catch (e) {
    $('monAccList').innerHTML = '<div class="empty">加载失败：' + esc(e.message) + '</div>';
  }
}

async function monAddAccount() {
  const url = $('monUrl').value.trim();
  if (!url) { showToast('请先粘贴抖音主页链接'); return; }
  const note = $('monNote').value.trim();
  const dy = $('monDyId').value.trim();
  const r = await post('/api/monitor/accounts', { home_url: url, note, douyin_id: dy });
  if (r.ok) {
    showToast('已添加监控账号');
    $('monUrl').value = ''; $('monNote').value = ''; $('monDyId').value = '';
    await monLoadAccounts();
  } else {
    showToast('⚠ ' + (r.error || '添加失败'));
  }
}

async function monRemoveAccount(id) {
  const r = await fetch('/api/monitor/accounts/' + id, { method: 'DELETE' }).then(x => x.json());
  if (r.ok) { showToast('已移除'); monLoadAccounts(); }
  else showToast('⚠ ' + (r.error || '移除失败'));
}

async function monStartFetch() {
  const r = await post('/api/monitor/fetch');
  if (!r.ok) { showToast('⚠ ' + (r.error || '无法开始抓取')); return; }
  showToast('开始抓取 ' + r.total + ' 个账号…');
  $('monFetch').disabled = true;
  $('monProgressWrap').style.display = 'block';
  monPollStatus();
}

async function monPollStatus() {
  if (monitorPollTimer) clearInterval(monitorPollTimer);
  monitorPollTimer = setInterval(async () => {
    try {
      const d = await fetch('/api/monitor/status').then(r => r.json());
      const s = d.state || {};
      const p = s.progress || {};
      const pct = p.total ? Math.round(p.done / p.total * 100) : 0;
      $('monProgressBar').style.width = pct + '%';
      $('monProgressText').textContent = s.running
        ? ('抓取中 ' + p.done + '/' + p.total + (p.current ? ' · 正在处理「' + p.current + '」' : ''))
        : (pct === 100 ? '抓取完成' : (s.last_error ? '⚠ ' + s.last_error : ''));
      if (!s.running) {
        clearInterval(monitorPollTimer); monitorPollTimer = null;
        $('monFetch').disabled = false;
        if (!s.last_error) await monLoadReport();
      }
    } catch (_) {}
  }, 1200);
}

async function monLoadReport() {
  const box = $('monReport');
  try {
    const d = await fetch('/api/monitor/report').then(r => r.json());
    const rp = d.report;
    if (!rp) { box.innerHTML = ''; return; }
    let html = '';
    // 撞车榜（重点展示）
    const cols = rp.collisions || [];
    html += '<div class="card" style="margin-bottom:14px;border:1px solid #f5c2c7">' +
      '<div class="card-title">🔥 选题撞车榜（' + cols.length + ' 组同题）</div>';
    if (cols.length) {
      html += cols.map(c => '<div class="coll-card"><div class="t">🎯 ' + esc(c.topic) + '</div>' +
        '<div class="muted" style="font-size:12px;margin-bottom:4px">' + c.count + ' 个账号在做这个选题 · 组内最高 ' + fmtNum(c.max_digg) + ' 赞</div>' +
        c.members.map(m => '<div class="row"><span class="nm">' + esc(m.author_nickname || '') + '</span>' +
          '<span class="digg">' + fmtNum(m.digg_count || 0) + '</span>' +
          '<span class="muted" style="flex:1;font-size:12px">' + esc((m.desc || '').slice(0, 30)) + '</span></div>').join('') +
        '</div>').join('');
    } else {
      html += '<div class="empty">暂未发现跨账号同题（撞车）视频</div>';
    }
    html += '</div>';
    // 高赞榜
    const top = rp.top_videos || [];
    html += '<div class="card" style="margin-bottom:14px">' +
      '<div class="card-title">🏆 高赞视频榜（Top ' + top.length + ' · 去重 ' + (rp.dedup_hits || 0) + ' 条搬运）</div>';
    if (top.length) {
      html += '<div class="table-wrap"><table class="mon-table"><tr><th></th><th>账号</th><th>标题 / 文案</th><th class="num">点赞</th><th class="num">评论</th><th class="num">发布时间</th></tr>' +
        top.map((v, i) => {
          const rank = i === 0 ? 'r1' : i === 1 ? 'r2' : i === 2 ? 'r3' : '';
          return '<tr><td><span class="mon-rank ' + rank + '">' + (i + 1) + '</span></td>' +
            '<td style="white-space:nowrap">' + esc(v.author_nickname || '') + '</td>' +
            '<td class="mon-video-desc" title="点击查看完整文案" onclick="monShowDesc(this)">' + esc(v.desc || '（无文字）') + '</td>' +
            '<td class="digg">' + fmtNum(v.digg_count || 0) + '</td>' +
            '<td class="num">' + fmtNum(v.comment_count || 0) + '</td>' +
            '<td class="num" style="white-space:nowrap;color:var(--c-text-mute);font-size:12px">' + esc((v.create_time || '').slice(5, 16)) + '</td></tr>';
        }).join('') + '</table></div>';
    } else {
      html += '<div class="empty">暂无数据，点击「立即抓取」</div>';
    }
    html += '</div>';
    // 账号一览
    const best = rp.account_best || [];
    html += '<div class="card"><div class="card-title">📊 账号一览（近 10 条内最高赞）</div>' +
      '<div class="table-wrap"><table class="mon-table"><tr><th>账号</th><th class="num">粉丝数</th><th class="num">最高赞</th><th>最高赞选题</th></tr>' +
      best.map(b => '<tr><td style="font-weight:600">' + esc(b.nickname || '') + '</td>' +
        '<td class="num">' + fmtNum(b.follower_count || 0) + '</td>' +
        '<td class="digg">' + fmtNum(b.best_digg || 0) + '</td>' +
        '<td class="mon-video-desc" onclick="monShowDesc(this)">' + esc(b.best_desc || '') + '</td></tr>').join('') +
      '</table></div>' +
      (rp.fetched_at ? '<div class="muted" style="font-size:12px;margin-top:10px">抓取时间：' + esc(rp.fetched_at) + '</div>' : '') +
      '</div>';
    box.innerHTML = html;
  } catch (e) {
    box.innerHTML = '<div class="empty">报告加载失败：' + esc(e.message) + '</div>';
  }
}

function monShowDesc(el) {
  const full = el.textContent || '';
  const root = $('modalRoot');
  const box = document.createElement('div');
  box.className = 'modal-mask';
  box.innerHTML =
    '<div class="modal-box" style="max-width:560px">' +
      '<div class="modal-title">📄 爆款文案全文</div>' +
      '<div class="modal-sub">共 ' + full.length + ' 字 · 可直接复制，或一键送进洗稿工坊当原稿</div>' +
      '<div style="max-height:50vh;overflow:auto;background:var(--c-bg-soft);border-radius:8px;padding:12px;white-space:pre-wrap;font-size:13px;line-height:1.7;margin:10px 0">' + esc(full) + '</div>' +
      '<div class="modal-btns"><button class="cancel" data-act="cancel">关闭</button>' +
      '<button class="ok" data-act="copy">📋 复制全文</button>' +
      '<button class="ok" data-act="rw" style="background:#0ea5e9">✂️ 拿去洗稿</button></div>' +
    '</div>';
  root.appendChild(box);
  const close = () => { root.removeChild(box); };
  box.querySelector('[data-act=cancel]').addEventListener('click', close);
  box.querySelector('[data-act=copy]').addEventListener('click', () => {
    if (copyText(full)) showToast('✅ 已复制全文');
    else showToast('⚠ 复制失败，请手动选择');
    close();
  });
  box.querySelector('[data-act=rw]').addEventListener('click', () => {
    rwPrefillOriginal = full;
    close();
    switchView('rewrite');
    setTimeout(() => newRewrite(), 350);
  });
}

/* ================= 初始化 ================= */
function initTheme(){
  const KEY='wb_theme';
  let t='light';
  try{ t=localStorage.getItem(KEY)||'light'; }catch(_){}
  if(t==='dark') document.documentElement.setAttribute('data-theme','dark');
  const btn=$('themeBtn');
  const paint=()=>{ btn.textContent = document.documentElement.getAttribute('data-theme')==='dark' ? '☀️' : '🌙'; };
  paint();
  btn.addEventListener('click', ()=>{
    const dark = document.documentElement.getAttribute('data-theme')==='dark';
    if(dark){ document.documentElement.removeAttribute('data-theme'); }
    else{ document.documentElement.setAttribute('data-theme','dark'); }
    try{ localStorage.setItem(KEY, dark?'light':'dark'); }catch(_){}
    paint();
  });
}

async function init(){
  initTheme();
  loadCtxbar();
  renderMembers();
  // 记录成员配置（供专家名片展示 model/title/desc）
  window.__MEMBERS = members;
  // 通知中心
  loadNotifications();
  $('bellBtn').addEventListener('click', e => { e.stopPropagation(); toggleBell(); });
  // 全局搜索
  let searchTimer = null;
  $('globalSearchInput').addEventListener('input', e => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(()=>globalSearch(e.target.value), 260);
  });
  $('globalSearchInput').addEventListener('keydown', e => { if (e.key === 'Escape') closeSearch(); });
  $('globalSearchInput').addEventListener('focus', e => { if ((e.target.value||'').trim()) globalSearch(e.target.value); });
  // 点击空白关闭面板
  document.addEventListener('click', e => {
    if (!e.target.closest('.bell-wrap')) closeBell();
    if (!e.target.closest('.top-search')) closeSearch();
  });
  // 每 30s 刷新一次通知未读数
  setInterval(loadNotifications, 30000);
  // 恢复上次会话
  let sid=null, wid=null;
  try{ sid=localStorage.getItem('wb_sid'); wid=localStorage.getItem('wb_work_id'); }catch(_){}
  if (sid){
    try{
      const d = await fetch('/api/session/'+sid).then(r=>r.json());
      if (d.ok){
        await restoreSession(d);
      } else { try{ localStorage.removeItem('wb_sid'); }catch(_){} }
    }catch(_){}
  } else {
    // 恢复输入草稿
    try{ const dr=localStorage.getItem('wb_draft'); if (dr) input.value=dr; }catch(_){}
  }
  loadOverview();
}
$('btnNewWork').addEventListener('click', newWorkFlow);
init();
/* ================= 洗稿工坊 ================= */
let rwSessions = [], rwMeta = null, rwCurrent = null, rwEs = null, rwSid = null, rwBusy = false, rwPrefillOriginal = '', rwFilter = { q:'', status:'', sort:'new' };
const rwRenderedSeqs = new Set();
const RW_STATUS = { running:'进行中', review:'待定稿', iterating:'迭代中', done:'已完成' };

async function loadRewrite(){
  const v = $('view-rewrite');
  v.innerHTML = '<div class="empty">加载中…</div>';
  try {
    const [l, m] = await Promise.all([
      fetch('/api/rewrite/list').then(r=>r.json()),
      fetch('/api/rewrite/meta').then(r=>r.json())
    ]);
    rwSessions = (l.ok ? l.sessions : []) || [];
    rwMeta = m.ok ? m : null;
    renderRewrite(v);
  } catch(e){
    v.innerHTML = '<div class="empty">⚠ 加载失败: ' + esc(e.message) + '</div>';
  }
}

function renderRewrite(v){
  const meta = rwMeta || {};
  const regions = meta.regions || [];
  const assigns = meta.assignments || {};
  const evals = meta.evaluation || {};
  const replLog = meta.replacement_log || [];
  let chips = regions.map(r => {
    const a = assigns[r.id] || r.default || '?';
    return '<span class="chip"><span class="r">' + esc(r.label) + '</span><span class="a">' + esc(a) + '</span></span>';
  }).join('');
  let logHtml = replLog.length
    ? replLog.slice(-8).reverse().map(x =>
        '<div class="li">🔁 ' + esc(x.region_label || x.region) + '：' + esc(x.from) + ' → <b>' + esc(x.to) + '</b><span class="muted">' + esc(x.date || '') + '</span></div>'
      ).join('')
    : '<div class="muted">暂无负责人替换记录</div>';

  let listHtml = rwSessions.length
    ? rwSessions.map(s => {
        const st = RW_STATUS[s.status] || s.status;
        const cls = s.status === 'done' ? 'ok' : (s.status === 'running' ? 'busy' : 'warn');
        const mt = s.metrics || {};
        return '<div class="rw-item' + (rwCurrent === s.id ? ' active' : '') + '" onclick="openRewrite(\'' + s.id + '\')">' +
          '<div class="t">✂️ ' + esc(s.title || s.id) + ' <span class="badge ' + cls + '">' + esc(st) + '</span></div>' +
          '<div class="meta">' +
            (mt.likes ? '👍' + esc(mt.likes) : '') + (mt.comments ? '💬' + esc(mt.comments) : '') +
            (mt.forwards ? '↗' + esc(mt.forwards) : '') + (mt.saves ? '⭐' + esc(mt.saves) : '') +
            '<span>' + esc(s.created_at || '') + '</span>' +
          '</div>' +
          '<div class="rw-ops">' +
            '<button title="重新洗（保留原稿与数据，换要求重跑）" onclick="event.stopPropagation();rwRedo(\'' + s.id + '\')">🔄 重新洗</button>' +
            '<button class="del" title="删除该洗稿记录" onclick="event.stopPropagation();rwDelete(\'' + s.id + '\')">🗑</button>' +
          '</div></div>';
      }).join('')
    : '<div class="rw-empty">还没有洗稿记录<br><br><div class="empty-cta"><button onclick="newRewrite()">✂️ 开始第一次洗稿</button><button class="ghost" onclick="switchView(\'monitor\')">📡 去对标监控找素材</button></div></div>';

  // 搜索 / 筛选 / 排序
  const q = (rwFilter.q || '').trim().toLowerCase();
  const stF = rwFilter.status;
  let shown = rwSessions.slice();
  if (q) shown = shown.filter(s => (s.title || '').toLowerCase().includes(q));
  if (stF) shown = shown.filter(s => s.status === stF);
  shown.sort((a, b) => rwFilter.sort === 'old'
    ? (a.created_at || '').localeCompare(b.created_at || '')
    : (b.created_at || '').localeCompare(a.created_at || ''));
  const shownHtml = shown.length
    ? shown.map(s => {
        const st = RW_STATUS[s.status] || s.status;
        const cls = s.status === 'done' ? 'ok' : (s.status === 'running' ? 'busy' : 'warn');
        const mt = s.metrics || {};
        return '<div class="rw-item' + (rwCurrent === s.id ? ' active' : '') + '" onclick="openRewrite(\'' + s.id + '\')">' +
          '<div class="t">✂️ ' + esc(s.title || s.id) + ' <span class="badge ' + cls + '">' + esc(st) + '</span></div>' +
          '<div class="meta">' +
            (mt.likes ? '👍' + esc(mt.likes) : '') + (mt.comments ? '💬' + esc(mt.comments) : '') +
            (mt.forwards ? '↗' + esc(mt.forwards) : '') + (mt.saves ? '⭐' + esc(mt.saves) : '') +
            '<span>' + esc(s.created_at || '') + '</span>' +
          '</div>' +
          '<div class="rw-ops">' +
            '<button title="重新洗（保留原稿与数据，换要求重跑）" onclick="event.stopPropagation();rwRedo(\'' + s.id + '\')">🔄 重新洗</button>' +
            '<button class="del" title="删除该洗稿记录" onclick="event.stopPropagation();rwDelete(\'' + s.id + '\')">🗑</button>' +
          '</div></div>';
      }).join('')
    : '<div class="rw-empty">' + (rwSessions.length ? '没有匹配的洗稿记录' : '还没有洗稿记录<br><br>点击右上角「新建洗稿」开始') + '</div>';

  v.innerHTML =
    '<div class="rw-head">' +
      '<span class="t">✂️ 洗稿工坊</span>' +
      '<span class="sub">丢原稿 + 四维数据 → 阿骨拆骨架 → 全员找爆点 → 专家分区补写 → 阿审审查 → 你逐句点评迭代</span>' +
      '<div style="margin-left:auto;display:flex;gap:10px">' +
        '<button class="btn-ghost" onclick="rwWinrate()">📈 胜率曲线</button>' +
        '<button class="btn-ghost" onclick="rwEvaluate()">📊 负责人评价' +
          (meta.evaluated_count ? '（' + meta.evaluated_count + '/3）' : '') + '</button>' +
        '<button class="btn-primary" onclick="newRewrite()">➕ 新建洗稿</button>' +
      '</div>' +
    '</div>' +
    '<div class="rw-filter">' +
      '<input id="rwSearch" placeholder="🔍 搜索标题…" value="' + esc(rwFilter.q || '') + '" />' +
      '<select id="rwStatus">' + ['', 'running', 'review', 'done'].map(s =>
        '<option value="' + s + '"' + (rwFilter.status === s ? ' selected' : '') + '>' +
        (({running:'进行中', review:'待定稿', done:'已完成'})[s] || '全部状态') + '</option>').join('') + '</select>' +
      '<select id="rwSort">' + [['new','最新优先'],['old','最早优先']].map(p =>
        '<option value="' + p[0] + '"' + (rwFilter.sort === p[0] ? ' selected' : '') + '>' + p[1] + '</option>').join('') + '</select>' +
    '</div>' +
    '<div class="rw-grid">' +
      '<div class="rw-list">' + shownHtml + '</div>' +
      '<div class="rw-detail" id="rwDetail">' +
        (rwCurrent ? '' : '<div class="rw-empty">👈 从左侧选择一篇洗稿，或新建一篇</div>') +
      '</div>' +
    '</div>' +
    '<div class="panel" style="margin-top:14px">' +
      '<div class="card-title">🧩 分区负责人（阿数按数据表现可替换）</div>' +
      '<div class="rw-assign">' + chips + '</div>' +
      '<div class="card-title" style="margin-top:10px">📜 负责人替换历史</div>' +
      '<div class="rw-log">' + logHtml + '</div>' +
      rwEvalPanelHtml(evals) +
    '</div>';
  if (rwCurrent) openRewrite(rwCurrent, true);
  const rs = $('rwSearch'); if (rs) rs.addEventListener('input', () => { rwFilter.q = rs.value; renderRewrite(v); });
  const rsts = $('rwStatus'); if (rsts) rsts.addEventListener('change', () => { rwFilter.status = rsts.value; renderRewrite(v); });
  const rsrt = $('rwSort'); if (rsrt) rsrt.addEventListener('change', () => { rwFilter.sort = rsrt.value; renderRewrite(v); });
}


async function rwRedo(rid){
  // 「重新洗」：保留原稿与四维数据，换要求一键重跑
  let old = null;
  try{ const d = await fetch('/api/rewrite/' + rid).then(r=>r.json()); if (d.ok) old = d.session; }catch(_){}
  if (!old){ showToast('⚠ 找不到该洗稿记录'); return; }
  const f = await openModal({
    title: '🔄 重新洗',
    sub: '保留原稿与四维数据，只换洗稿要求重跑一遍（生成新记录，旧稿保留可对比）。',
    fields: [
      { name:'requirements', label:'新的洗稿要求', type:'textarea', rows:3, placeholder: old.requirements || '例如：这次把开头改成更炸的钩子；结尾加强行动号召…' },
    ], okText:'重新洗'
  });
  if (!f) return;
  const d = await post('/api/rewrite/' + rid + '/redo', { requirements: f.requirements || '' });
  if (!d.ok){ showToast('⚠ ' + (d.error || '重新洗失败')); return; }
  showToast('🔄 已重新洗稿，正在生成中…');
  loadRewrite();
  setTimeout(()=>{ if (d.sid) openRwStream(d.sid); }, 600);
}
async function rwDelete(rid){
  const ok = await confirmDanger('删除洗稿', '将永久删除该洗稿记录（含成品与数据），确定吗？', '删除');
  if (!ok) return;
  const d = await post('/api/rewrite/batch', { action:'delete', ids:[rid] });
  showToast(d.ok ? '🗑 已删除' : ('⚠ ' + (d.error || '删除失败')));
  if (d.ok){ if (rwCurrent === rid) rwCurrent = ''; loadRewrite(); }
}

async function rwShowDiff(rid){
  // 原稿 vs 洗稿成品逐段对照（拼装 8 分区）
  let s = null;
  try{ const d = await fetch('/api/rewrite/' + rid).then(r=>r.json()); if (d.ok) s = d.session; }catch(_){}
  if (!s){ showToast('⚠ 加载失败'); return; }
  const regions = (rwMeta && rwMeta.regions) || [];
  const lines = [];
  for (const r of regions){
    const p = (s.parts || {})[r.id];
    if (p && p.text) lines.push(p.text);
  }
  const fin = lines.join('\n\n').trim();
  if (!fin){ showToast('⚠ 该洗稿还没有成品内容'); return; }
  showDiffViewer(s.original || '', fin, '原稿 vs 洗稿成品');
}
async function rwWinrate(){
  // 负责人胜率曲线：按区域展示评价轮次累计胜率
  const d = await fetch('/api/rewrite/winrate').then(r=>r.json());
  if (!d.ok){ showToast('⚠ 加载胜率数据失败'); return; }
  const regions = d.regions || [];
  const events = d.events || [];
  const root = $('modalRoot');
  const box = document.createElement('div');
  box.className = 'modal-mask';
  const cards = regions.map(rg => {
    const pts = rg.points || [];
    const cur = rg.current || '?';
    if (!pts.length){
      return '<div class="wr-card"><div class="wr-hd"><b>'+esc(rg.label)+'</b><span class="wr-cur">当前：'+esc(cur)+'</span></div>' +
        '<div class="wr-empty">还没有评价轮次，先做满 3 篇「负责人评价」出曲线</div></div>';
    }
    const maxR = Math.max(...pts.map(p=>p.rate));
    const bars = pts.map((p,i) => {
      const h = Math.round((p.rate / (maxR||1)) * 56) + 2;
      const winCls = p.rate >= 0.5 ? 'w' : 'l';
      return '<div class="wr-bar" title="'+esc(p.date)+' '+esc(p.agent)+' 胜率 '+Math.round(p.rate*100)+'%（'+p.win+'/'+p.total+'）">' +
        '<div class="wr-bv" style="height:'+h+'px" class="'+winCls+'"></div>' +
        '<div class="wr-bt">'+ (i+1) +'</div></div>';
    }).join('');
    const last = pts[pts.length-1];
    return '<div class="wr-card"><div class="wr-hd"><b>'+esc(rg.label)+'</b>' +
      '<span class="wr-cur">当前：'+esc(cur)+'</span>' +
      '<span class="wr-rate">最新胜率 <b style="color:'+ (last.rate>=0.5 ? 'var(--primary)' : '#e8576a') +'">'+Math.round(last.rate*100)+'%</b>（'+last.win+'/'+last.total+'）</span></div>' +
      '<div class="wr-bars">'+bars+'</div>' +
      '<div class="wr-legend"><span>第 1 轮 → 第 '+pts.length+' 轮（每轮 = 一次负责人评价）</span></div></div>';
  }).join('');
  const evHtml = events.length ? events.slice(-12).reverse().map(e =>
    '<div class="wr-ev"><span class="wr-ev-tag '+(e.verdict==='keep'?'keep':'rep')+'">'+(e.verdict==='keep'?'✅ 保留':'🔁 建议换')+'</span>' +
    '<b>'+esc(e.region_label)+'</b> · '+esc(e.agent)+' · <span class="muted">'+esc(e.reason)+'</span><span class="muted">'+esc((e.date||'').slice(0,16))+'</span></div>'
  ).join('') : '<div class="muted">暂无评价事件</div>';
  box.innerHTML =
    '<div class="modal-box" style="max-width:640px">' +
      '<div class="modal-title">📈 负责人胜率曲线</div>' +
      '<div class="modal-sub">按区域展示每轮评价后负责人的累计胜率（keep / 被评价次数）。多次评价后趋势逐渐稳定。</div>' +
      '<div style="max-height:60vh;overflow:auto">' +
        '<div class="wr-grid">' + cards + '</div>' +
        '<div class="card-title" style="margin-top:14px">🕘 最近评价事件</div>' +
        '<div class="wr-evlist">' + evHtml + '</div>' +
      '</div>' +
      '<div class="modal-btns"><button class="cancel" data-act="close">关闭</button></div>' +
    '</div>';
  root.appendChild(box);
  box.querySelector('[data-act=close]').addEventListener('click', ()=>box.remove());
  box.querySelector('.modal-mask').addEventListener('click', e=>{ if (e.target===box) box.remove(); });
}
async function newRewrite(){
  const pre = rwPrefillOriginal; rwPrefillOriginal = '';
  const f = await openModal({
    title: '✂️ 新建洗稿',
    sub: '丢入原稿文案和它的四维数据（点赞/评论/转发/收藏）。阿骨会先拆骨架，然后全员分析爆点、专家分区补写。',
    fields: [
      { name:'original', label:'原稿文案', type:'textarea', rows:10, placeholder:'粘贴你要洗的原稿口播文案…', value: pre },
      { name:'likes', label:'点赞量', type:'text', placeholder:'例如 12800' },
      { name:'comments', label:'评论量', type:'text', placeholder:'例如 860' },
      { name:'forwards', label:'转发量', type:'text', placeholder:'例如 320' },
      { name:'saves', label:'收藏量', type:'text', placeholder:'例如 1500' },
      { name:'requirements', label:'洗稿要求（可选）', type:'textarea', rows:3, placeholder:'例如：把开头改成更炸的钩子；去掉玄学术语；结尾加引导关注…' }
    ],
    okText: '开始洗稿'
  });
  if (!f || !f.original || !f.original.trim()) { showToast('原稿不能为空'); return; }
  const d = await post('/api/rewrite/start', {
    original: f.original,
    likes: f.likes || '', comments: f.comments || '',
    forwards: f.forwards || '', saves: f.saves || '',
    requirements: f.requirements || ''
  });
  if (!d.ok) { showToast('⚠ ' + (d.error || '启动失败')); return; }
  rwSid = d.sid;
  rwCurrent = d.rid;
  loadRewrite();
  openRewrite(d.rid);
}

function rwStatusBadge(status){
  const st = RW_STATUS[status] || status;
  const cls = status === 'done' ? 'ok' : (status === 'running' ? 'busy' : 'warn');
  return '<span class="badge ' + cls + '">' + esc(st) + '</span>';
}

function rwMetricHtml(m){
  m = m || {};
  const items = [
    ['👍 点赞', m.likes], ['💬 评论', m.comments], ['↗ 转发', m.forwards], ['⭐ 收藏', m.saves]
  ].filter(x => x[1] != null && x[1] !== '');
  if (!items.length) return '';
  return '<div class="rw-metrics">' + items.map(x =>
    '<span class="rw-metric">' + x[0] + '<b>' + esc(x[1]) + '</b></span>').join('') + '</div>';
}

async function openRewrite(rid, quiet){
  rwCurrent = rid;
  rwRenderedSeqs.clear();
  if (rwEs) { try { rwEs.close(); } catch(_){} rwEs = null; }
  const d = await fetch('/api/rewrite/' + rid).then(r=>r.json());
  if (!d.ok) { showToast('⚠ ' + (d.error || '加载失败')); return; }
  const s = d.session;
  if (d.sid) rwSid = d.sid;
  const detail = $('rwDetail');
  if (!detail) return;
  detail.innerHTML = rwDetailHtml(s);
  if (s.status === 'running' && rwSid) {
    // 有进行中的流程：连接 SSE（重放历史 + 实时接收）
    connectRwStream(rwSid);
  } else {
    // 已完成/待定稿：渲染存档历史
    renderRwHistory(s);
  }
}

function rwPartCardHtml(rid, region, p){
  if (!p || !p.text) return '';
  const agent = p.agent || '';
  const r = region || {};
  return '<div class="rw-part" id="rwpart-' + r.id + '">' +
    '<div class="h">' + esc(r.label || r.id) +
      (agent ? '<span class="owner" style="background:' + colorOf(agent) + '">' + esc(agent) + '</span>' : '') +
      (p.is_new ? '<span class="tag">新负责人</span>' : '') +
    '</div>' +
    '<div class="txt">' + esc(p.text) + '</div>' +
    '<div class="acts">' +
      '<button class="btn-ghost" style="padding:4px 10px;font-size:12px" onclick="rwComment(\'' + rid + '\',\'' + r.id + '\')">💬 评论</button>' +
    '</div>' +
    (p.comments && p.comments.length ? p.comments.map(c =>
      '<div class="cmt">💬 你：' + esc(c.comment) + '<br>↩ ' + esc(c.reply || '').slice(0, 120) + '</div>'
    ).join('') : '') +
  '</div>';
}

function rwDetailHtml(s){
  const regions = (rwMeta && rwMeta.regions) || [];
  let partsHtml = regions.map(r => rwPartCardHtml(s.id, r, (s.parts || {})[r.id])).join('');

  const unt = (s.untouchable || []).map(u =>
    '<li>「' + esc(u.sentence) + '」<span class="muted">（' + (u.agents || []).length + '人共识' + (u.reason ? ' · ' + esc(u.reason) : '') + '）</span></li>'
  ).join('');

  return '<div class="card-title">✂️ ' + esc(s.title) + ' ' + rwStatusBadge(s.status) +
      '<span class="muted" style="margin-left:auto">' + esc(s.created_at || '') + '</span></div>' +
    '<div class="muted">原稿</div><div class="rw-orig">' + esc(s.original || '') + '</div>' +
    rwMetricHtml(s.metrics) +
    (s.requirements ? '<div class="rw-bar">📌 洗稿要求：' + esc(s.requirements) + '</div>' : '') +
    '<div class="rw-actions">' +
      (s.status !== 'done'
        ? '<button class="btn-primary" onclick="rwFinalize(\'' + s.id + '\')">⚖️ 最终审查 + 记录分工</button>'
        : '') +
      '<button class="btn-ghost" onclick="rwToWork(\'' + s.id + '\')">💾 保存为作品</button>' +
      '<button class="btn-ghost" onclick="rwFillResult(\'' + s.id + '\')">📊 回填成品数据</button>' +
      '<button class="btn-ghost" onclick="rwShowDiff(\'' + s.id + '\')">🔍 原稿vs成品</button>' +
      '<button class="btn-ghost" onclick="copyFullText(\'' + s.id + '\')">📋 复制成品全文</button>' +
    '</div>' +
    '<div id="rwStream" class="rw-stream"></div>' +
    (unt ? '<div class="rw-untouch"><div class="t">🚫 不可动句子（全员共识）</div><ul>' + unt + '</ul></div>' : '') +
    '<div class="card-title" style="margin-top:16px">📦 分区成品</div><div class="rw-parts">' + partsHtml + '</div>';
}

function renderRwHistory(s){
  // 重放已存的分析/骨架/审查/记录为只读消息
  const stream = $('rwStream');
  if (!stream) return;
  const regions = (rwMeta && rwMeta.regions) || [];
  const parts = s.parts || {};
  const done = new Set();
  if (s.skeleton && !done.has('skeleton')) { done.add('skeleton'); appendRwMsg('skeleton', '阿骨', '骨架拆解', s.skeleton); }
  for (const [name, text] of Object.entries(s.analysis || {})) {
    if (done.has('analysis:' + name)) continue;
    done.add('analysis:' + name);
    appendRwMsg('analysis', name, '全员分析', text);
  }
  if (s.principle_review && !done.has('review')) { done.add('review'); appendRwMsg('review', '阿审', '原则审查', s.principle_review); }
  if (s.owner_record && !done.has('record')) { done.add('record'); appendRwMsg('record', '阿数', '分工记录', s.owner_record); }
}

function appendRwMsg(kind, name, tag, text){
  const stream = $('rwStream');
  if (!stream) return;
  const div = document.createElement('div');
  div.className = 'rw-msg ' + kind;
  div.innerHTML = '<div class="h"><span style="color:' + colorOf(name) + '">' + esc(name || '') + '</span>' +
    '<span class="tag">' + esc(tag || '') + '</span><span class="ts">' + nowTime() + '</span></div>' +
    '<div class="txt">' + esc(text || '') + '</div>';
  stream.appendChild(div);
  scrollBottomRw();
}

function scrollBottomRw(){
  const el = document.querySelector('.main');
  if (el) el.scrollTop = el.scrollHeight;
}

function connectRwStream(sid){
  if (rwEs) { try { rwEs.close(); } catch(_){} }
  rwEs = new EventSource('/api/stream/' + sid);
  rwEs.onmessage = e => {
    let ev; try { ev = JSON.parse(e.data); } catch(_) { return; }
    rwHandle(ev);
  };
  rwEs.onerror = () => {};
}

function rwHandle(ev){
  if (ev.seq && rwRenderedSeqs.has(ev.seq)) return;
  if (ev.seq) rwRenderedSeqs.add(ev.seq);
  if (ev.type === 'system' || ev.kind === 'phase') {
    const stream = $('rwStream');
    if (stream) {
      const div = document.createElement('div');
      div.className = 'rw-msg phase';
      div.innerHTML = '<div class="txt">' + esc(ev.text || '') + '</div>';
      stream.appendChild(div); scrollBottomRw();
    }
    return;
  }
  if (ev.type === 'error') { showToast('⚠ ' + (ev.text || '出错')); return; }
  if (ev.type === 'typing') {
    const stream = $('rwStream');
    if (stream) {
      const old = $('rwTyping');
      if (old) old.remove();
      const div = document.createElement('div');
      div.className = 'rw-typing'; div.id = 'rwTyping';
      div.textContent = ev.name + ' 正在思考…';
      stream.appendChild(div); scrollBottomRw();
    }
    return;
  }
  if (ev.type === 'message') {
    const stream = $('rwStream');
    const typing = $('rwTyping'); if (typing) typing.remove();
    const kind = ev.kind || 'analysis';
    const tagMap = { skeleton:'骨架拆解', analysis:'全员分析', part:'分区成品', review:'原则审查', record:'分工记录', evaluate:'评价', replace:'替换' };
    appendRwMsg(kind, ev.name || '', tagMap[kind] || kind, ev.text || '');
    // 分区成品 → 更新分区卡片
    if (kind === 'part' && ev.region) {
      const r = (rwMeta && rwMeta.regions || []).find(x => x.id === ev.region);
      if (r) upsertRwPart(ev);
      if (ev.is_iteration) rwBusy = false;  // 迭代完成解除 busy
    }
    return;
  }
  if (ev.type === 'done') {
    const typing = $('rwTyping'); if (typing) typing.remove();
    if (rwEs) { try { rwEs.close(); } catch(_){} rwEs = null; }
    loadRewrite();
    return;
  }
}

function upsertRwPart(ev){
  // 分区成品消息 → 动态更新/创建分区卡片（不重建整个详情，避免 SSE 断流）
  const regions = (rwMeta && rwMeta.regions) || [];
  const region = regions.find(x => x.id === ev.region);
  let card = $('rwpart-' + ev.region);
  if (card) {
    const txt = card.querySelector('.txt');
    if (txt) txt.textContent = ev.text;
    const h = card.querySelector('.h');
    if (h) {
      const owner = h.querySelector('.owner');
      if (owner) owner.textContent = ev.name || owner.textContent;
    }
  const cmts = card.querySelectorAll('.cmt');
  // 保留历史评论，只去掉「等待回复」的占位标记（专家已重写完成）
  cmts.forEach(c => c.classList.remove('pending'));
  scrollBottomRw();
  return;
}
  // 卡片不存在 → 创建并插入分区区
  const wrap = document.querySelector('.rw-parts');
  if (!wrap || !region || !rwCurrent) return;
  const div = document.createElement('div');
  div.innerHTML = rwPartCardHtml(rwCurrent, region, { text: ev.text, agent: ev.name || '', comments: [], is_new: !!ev.is_new });
  wrap.appendChild(div.firstChild);
  scrollBottomRw();
}

async function rwComment(rid, regionId){
  if (!rwSid) { showToast('会话未就绪，请重新打开'); return; }
  if (rwBusy) { showToast('⏳ 专家正在重写中，请稍候…'); return; }
  const f = await openModal({
    title: '💬 评论该区域',
    sub: '告诉负责这个区域的专家哪里不对、想要什么方向，他会据此重写这一部分。',
    fields: [{ name:'comment', label:'你的评论', type:'textarea', rows:4, placeholder:'例如：开头还是太软，换成直接抛出反常识结论…' }],
    okText: '发送并让专家重写'
  });
  if (!f || !f.comment || !f.comment.trim()) return;
  if (rwBusy) { showToast('⏳ 专家正在重写中，请稍候…'); return; }
  rwBusy = true;
  try {
    const d = await post('/api/rewrite/' + rid + '/comment', { sid: rwSid, region: regionId, comment: f.comment.trim() });
    if (!d.ok) { showToast('⚠ ' + (d.error || '评论失败')); return; }
    // 立即把评论显示到分区卡片（历史实时可见）
    const card = $('rwpart-' + regionId);
    if (card) {
      const div = document.createElement('div');
      div.className = 'cmt pending';
      div.textContent = '💬 你：' + f.comment.trim() + '（专家重写中…）';
      card.appendChild(div);
    }
    connectRwStream(rwSid);
  } finally {
    // SSE 事件流到达 is_iteration 消息时解除 busy（见 rwHandle）；这里兜底 90 秒
    setTimeout(() => { rwBusy = false; }, 90000);
  }
}

async function rwFinalize(rid){
  if (!rwSid) { showToast('会话未就绪，请重新打开'); return; }
  const ok = await confirmDanger('⚖️ 最终审查 + 记录分工', '阿审会对当前成品做最终原则审查，阿数会记录每个区域由谁负责。确定继续？', '确认执行');
  if (!ok) return;
  const d = await post('/api/rewrite/' + rid + '/finalize', { sid: rwSid });
  if (!d.ok) { showToast('⚠ ' + (d.error || '启动失败')); return; }
  connectRwStream(rwSid);
}

async function rwToWork(rid){
  const ok = await confirmDanger('💾 保存为作品？','把洗稿成品（8 个分区拼装全文）一键存入作品库，四维数据自动写入作品 metrics，进入数据榜单与复盘。','保存');
  if (!ok) return;
  const d = await post('/api/rewrite/' + rid + '/to_work');
  if (!d.ok) { showToast('⚠ ' + (d.error || '保存失败')); return; }
  showToast('✅ 已保存为作品「' + (d.title || '') + '」，可去作品库查看');
}
async function rwFillResult(rid){
  const f = await openModal({
    title: '📊 回填成品数据',
    sub: '洗稿成品发布后，把它的真实数据填回来。累计满 3 篇，阿数就能建立评价标准、判断每个区域负责人行不行。',
    fields: [
      { name:'likes', label:'点赞量', type:'text', placeholder:'例如 32000' },
      { name:'comments', label:'评论量', type:'text', placeholder:'例如 2100' },
      { name:'forwards', label:'转发量', type:'text', placeholder:'例如 560' },
      { name:'saves', label:'收藏量', type:'text', placeholder:'例如 4000' }
    ],
    okText: '保存数据'
  });
  if (!f) return;
  const d = await post('/api/rewrite/' + rid + '/result', {
    likes: f.likes || '', comments: f.comments || '',
    forwards: f.forwards || '', saves: f.saves || ''
  });
  if (!d.ok) { showToast('⚠ ' + (d.error || '保存失败')); return; }
  showToast('✅ 已保存，累计 ' + (d.evaluated_count || 0) + ' / 3 篇');
  if (rwCurrent) openRewrite(rwCurrent, true);
}

async function rwEvaluate(){
  const d = await post('/api/rewrite/evaluate', { sid: rwSid || '' });
  if (!d.ok) { showToast('⚠ ' + (d.error || '启动失败')); return; }
  rwSid = d.sid || rwSid;
  connectRwStream(rwSid);
}

/* ---------- 评价结果面板 + 一键应用替换 ---------- */
function rwEvalPanelHtml(evals){
  if (!evals || evals.status !== 'evaluated') return '';
  const verdicts = evals.verdicts || [];
  const curAssign = (rwMeta && rwMeta.assignments) || {};
  const rows = verdicts.map(v => {
    const r = (rwMeta && rwMeta.regions || []).find(x => x.id === v.region) || {};
    const label = r.label || v.region;
    const isReplace = v.verdict === 'replace';
    const applied = !!v.applied;
    const cur = curAssign[v.region];
    const nowAgent = v.agent || cur || '?';
    return '<div class="rw-vd ' + (isReplace ? 'rep' : 'keep') + (applied ? ' applied' : '') + '">' +
      '<div class="vd-h"><span class="vd-region">' + esc(label) + '</span>' +
        '<span class="vd-badge ' + (isReplace ? 'rep' : 'keep') + '">' + (applied ? '✅ 已应用' : (isReplace ? '🔁 建议替换' : '✅ 留任')) + '</span>' +
        '<span class="vd-agent" style="background:' + colorOf(nowAgent) + '">' + esc(nowAgent) + '</span>' +
        (isReplace && v.suggested ? '<span class="vd-arrow">→</span><span class="vd-agent" style="background:' + colorOf(v.suggested) + '">' + esc(v.suggested) + '</span>' : '') +
        (cur && cur !== nowAgent ? '<span class="muted">（当前：' + esc(cur) + '）</span>' : '') +
      '</div>' +
      (v.reason ? '<div class="vd-reason">' + esc(v.reason) + '</div>' : '') +
      (isReplace && !applied
        ? '<button class="btn-ghost vd-apply" onclick="rwApplyOne(\'' + esc(v.region) + '\')">应用这条替换</button>'
        : '') +
    '</div>';
  }).join('');
  const nRep = verdicts.filter(v => v.verdict === 'replace' && !v.applied).length;
  return '<div class="rw-eval panel" style="margin-top:14px">' +
    '<div class="card-title">📊 最近评价结果（阿数）' +
      (evals.applied_at ? '<span class="muted" style="font-weight:400">已应用：' + esc(evals.applied_at) + '</span>' : '') +
    '</div>' +
    (evals.standards ? '<div class="rw-bar">评价标准：' + esc(String(evals.standards).slice(0,300)) + '</div>' : '') +
    (verdicts.length ? '<div class="rw-vds">' + rows + '</div>' : '<div class="muted">暂无区域判断</div>') +
    (nRep > 0
      ? '<div style="margin-top:10px"><button class="btn-primary" onclick="rwApplyAll()">⚡ 一键应用全部替换（' + nRep + ' 条）</button></div>'
      : '') +
  '</div>';
}
async function rwApplyOne(regionId){
  const evals = (rwMeta && rwMeta.evaluation) || {};
  const v = (evals.verdicts || []).find(x => x.region === regionId && x.verdict === 'replace');
  if (!v) return;
  const ok = await confirmDanger('🔁 应用负责人替换', v.region + ' 区域：' + v.agent + ' → ' + v.suggested + '。下次洗稿该区域将由新负责人补写。确定？', '应用替换');
  if (!ok) return;
  const d = await post('/api/rewrite/apply', { replacements: [{ region: v.region, from: v.agent, to: v.suggested, reason: v.reason }] });
  if (!d.ok) { showToast('⚠ ' + (d.error || '应用失败')); return; }
  showToast('✅ 已应用：' + v.region + ' 改由 ' + v.suggested + ' 负责');
  loadRewrite();
}
async function rwApplyAll(){
  const evals = (rwMeta && rwMeta.evaluation) || {};
  const reps = (evals.verdicts || []).filter(v => v.verdict === 'replace' && !v.applied);
  if (!reps.length) { showToast('没有待应用的替换'); return; }
  const ok = await confirmDanger('⚡ 一键应用全部替换', '共 ' + reps.length + ' 条负责人替换（' + reps.map(v => v.region + ': ' + v.agent + '→' + v.suggested).join('、') + '）。确定？', '全部应用');
  if (!ok) return;
  const d = await post('/api/rewrite/apply', { replacements: reps.map(v => ({ region: v.region, from: v.agent, to: v.suggested, reason: v.reason })) });
  if (!d.ok) { showToast('⚠ ' + (d.error || '应用失败')); return; }
  showToast('✅ 已应用 ' + reps.length + ' 条负责人替换');
  loadRewrite();
}

/* ---------- 复制成品全文 ---------- */
function copyText(text){
  if (!text) { showToast('没有可复制的内容'); return false; }
  // 桌面 webview 的 clipboard API 可能受限，用 textarea 兜底
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  let ok = false;
  try { ok = document.execCommand('copy'); } catch(_) {}
  document.body.removeChild(ta);
  if (navigator.clipboard && navigator.clipboard.writeText) { try { navigator.clipboard.writeText(text).catch(()=>{}); ok = true; } catch(_) {} }
  return ok;
}
function copyFullText(rid){
  const regions = (rwMeta && rwMeta.regions) || [];
  fetch('/api/rewrite/' + rid).then(r => r.json()).then(d => {
    if (!d.ok || !d.session) { showToast('⚠ 加载失败'); return; }
    const parts2 = d.session.parts || {};
    const lines = regions.map(r => {
      const p = parts2[r.id];
      return p && p.text ? '【' + r.label + '】\n' + p.text : '';
    }).filter(Boolean);
    const full = lines.join('\n\n');
    if (copyText(full)) showToast('✅ 成品全文已复制（' + full.length + ' 字）');
    else showToast('⚠ 复制失败，请手动选择');
  }).catch(() => showToast('⚠ 复制失败'));
}

</script>
</body>
</html>
